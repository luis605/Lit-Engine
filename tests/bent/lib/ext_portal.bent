include "prelude.bent"

gen xpEuler = vec3(float(-180, 180), float(-89, 89), float(-180, 180))
gen xpUprightEuler = vec3(float(-180, 180), 0, 0)
gen xpPos = vec3(float(-40, 40), float(-5, 12), float(-40, 40))
gen xpFarPos = vec3(float(-1500, 1500), float(-100, 100), float(-1500, 1500))
gen xpHalf = vec3(float(0.5, 3), float(0.5, 3), 0)
gen xpSignedUnit = float(-0.6, 0.6)

gen xpPairAny = {a: xpPos, ae: xpEuler, b: xpPos, be: xpEuler, half: xpHalf, twist: float(-180, 180)}
gen xpPairPlain = {a: xpPos, ae: xpEuler, b: xpPos, be: xpEuler, half: xpHalf}
gen xpPairUpright = {a: xpPos, ae: xpUprightEuler, b: xpPos, be: xpUprightEuler, half: xpHalf}

fn xpApart(s) = distance(s.a, s.b) > 12

gen xpCam = {dist: float(0.8, 6), u: xpSignedUnit, v: xpSignedUnit, roll: float(-180, 180), yawOff: float(-12, 12), pitchOff: float(-12, 12)}
gen xpCamUpright = {dist: float(0.8, 6), u: xpSignedUnit, v: xpSignedUnit, roll: just(0), yawOff: float(-12, 12), pitchOff: float(-12, 12)}

fn xpUnitDiff(a, b) = length(a - b)
fn xpMatId(m) = xmDiff(m, xmIdentity())
fn xpAngleDeg(a, b) = atan2(length(cross(a, b)), dot(a, b)) * 180 / 3.141592653589793

gen xpCell = {gravity: vec3(float(-12, 12), float(-12, 12), float(-12, 12)), tint: vec3(float(0, 1), float(0, 1), float(0, 1)),
              sun: float(0, 2), ambient: float(0, 2), scalar: float(-5, 5)}

gen xfPair = {a: vec3(float(-6, 6), float(0.5, 4), float(-9, -1)), ae: vec3(float(-50, 50), float(-20, 20), float(-10, 10)), b: xpPos, be: xpEuler,
              half: vec3(float(0.5, 2.5), float(0.5, 2.5), 0), twist: just(0), cellA: just(0), cellB: int(0, 2)}
gen xfPairOther = {a: vec3(float(-6, 6), float(0.5, 4), float(-9, -1)), ae: vec3(float(-50, 50), float(-20, 20), float(-10, 10)), b: xpPos, be: xpEuler,
                   half: vec3(float(0.5, 2.5), float(0.5, 2.5), 0), twist: just(0), cellA: just(0), cellB: int(1, 2)}
gen xfPairSmall = {a: vec3(float(-6, 6), float(0.5, 4), float(-30, -15)), ae: vec3(float(-50, 50), float(-20, 20), float(-10, 10)), b: xpPos, be: xpEuler,
                   half: vec3(float(0.3, 0.6), float(0.3, 0.6), 0), twist: just(0), cellA: just(0), cellB: int(0, 2)}

fn xfFrame(pairs) = {pairs: pairs, cells: 3, pos: vec3(0, 2, 6), yaw: -90, pitch: 0, roll: 0, maxDepth: 3, maxViews: 24, viewport: 1080, minPixels: 6, occlusion: true}
gen xfInput = {pairs: listOf(xfPair, 1, 3), cells: just(3), pos: vec3(float(-3, 3), float(0.5, 3), float(2, 10)), yaw: float(-110, -70), pitch: float(-15, 15),
               roll: float(-30, 30), maxDepth: int(1, 4), maxViews: int(2, 40), viewport: float(200, 2160), minPixels: float(0, 12), occlusion: bool(), fov: float(30, 90)}
gen xfInputOther = {pairs: listOf(xfPairOther, 1, 3), cells: just(3), pos: vec3(float(-3, 3), float(0.5, 3), float(2, 10)), yaw: float(-110, -70), pitch: float(-15, 15),
                    roll: float(-30, 30), maxDepth: int(1, 4), maxViews: int(2, 40), viewport: float(200, 2160), minPixels: float(0, 12), occlusion: bool(), fov: float(30, 90)}
gen xfInputSmall = {pairs: listOf(xfPairSmall, 1, 3), cells: just(3), pos: vec3(float(-3, 3), float(0.5, 3), float(2, 6)), yaw: float(-100, -80), pitch: float(-8, 8),
                    roll: just(0), maxDepth: int(1, 4), maxViews: int(2, 12), viewport: float(200, 600), minPixels: float(0, 6), occlusion: bool(), fov: float(40, 70)}

fn xqSide(p, c, n) = dot(n, p - c)
fn xqRectDistance(p, c, n, right, up, hx, hy) =
    let off = p - c in
    let side = dot(n, off) in
    let ox = max(abs(dot(off, right)) - hx, 0) in
    let oy = max(abs(dot(off, up)) - hy, 0) in
    sqrt(side * side + ox * ox + oy * oy)
fn xqRadius(mesh) = 0.5 + 0.5 * (mesh % 4)
