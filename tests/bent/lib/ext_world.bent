include "prelude.bent"

gen uniformScale = map(float(0.25, 3), fn(s) => vec3(s, s, s))
gen unitish = float(-1, 1)

gen hierSpawn = spawn(shape: "none", dynamic: false, pos: smallVec, rot: unitQuat(), scale: uniformScale, mesh: int(-1, 7),
                      parent: frequency([[2, just(-1)], [3, target]]))
gen hierEdit = frequency([
    [3, hierSpawn],
    [2, move(target: target, delta: offset)],
    [2, setRotation(target: target, rot: unitQuat())],
    [1, setScale(target: target, scale: uniformScale)],
    [2, reparent(target: target, parent: int(-1, 31), keepWorld: bool())],
    [1, destroy(target: target)],
    [1, teleport(target: target, pos: smallVec)]
])
gen hierProg = map([hierSpawn, listOf(hierEdit, 0, 16)], fn(pair) => [pair[0]] ++ pair[1])

gen lifeProg = map([hierSpawn, listOf(frequency([[5, hierSpawn], [4, destroy(target: target)], [1, reparent(target: target, parent: int(-1, 31))], [1, step(n: 1)]]), 0, 40)], fn(pair) => [pair[0]] ++ pair[1])

gen tagGen = elements(["a", "b", "c", "dd", ""])
gen metaEdit = frequency([
    [4, spawn(shape: "none", dynamic: false, pos: smallVec, tag: tagGen, layer: int(0, 255), parent: frequency([[2, just(-1)], [1, target]]), name: elements(["n1", "n2", "n3", "x"]))],
    [3, setTag(target: target, tag: tagGen)],
    [3, setLayer(target: target, layer: int(0, 255))],
    [3, setName(target: target, name: elements(["n1", "n2", "n3", "x", ""]))],
    [2, destroy(target: target)],
    [2, reparent(target: target, parent: int(-1, 31))],
    [1, compact()],
    [1, saveLoad()],
    [1, saveRoundtrip()],
    [1, snapshot(slot: 0)],
    [1, restore(slot: 0)],
    [1, snapshotText(slot: 0)],
    [1, restoreText(slot: 0)]
])
gen metaProg = listOf(metaEdit, 1, 25)

fn idx(e) = handle(e).index
fn generationOf(e) = handle(e).generation
fn sortedIndices() = sort(map(entities(), idx))
fn descendants(e) = fold(children(e), [], fn(acc, c) => acc ++ [c] ++ descendants(c))
fn subtreeOf(e) = if alive(e) then [e] ++ descendants(e) else []
fn sameSet(a, b) = len(a) == len(b) and all(a, fn(x) => contains(b, x))
fn mulv(a, b) = vec3(a.x * b.x, a.y * b.y, a.z * b.z)
fn isRoot(e) = parent(e) == -1
fn matClose(a, b, tol) = a ~= b within tol

fn bitOf(n, i) = floor(n / pow(2, i)) % 2 == 1
fn u32(n) = ((n % 4294967296) + 4294967296) % 4294967296
fn masksShare(a, b) = exists i in range(0, 32): bitOf(a, i) and bitOf(b, i)

fn posTol(a) = 1e-5 * (1 + length(a)) + 1e-4

gen xJsonLeaf = oneof(just(unit), bool(), float(-1e15, 1e15), int(-9007199254740992, 9007199254740992), text(0, 12), nasty(float(-1e300, 1e300)))
gen xJsonKey = text(0, 6)
fn xJsonGen(depth) =
    if depth <= 0 then xJsonLeaf
    else frequency([
        [3, xJsonLeaf],
        [1, listOf(delay(fn() => xJsonGen(depth - 1)), 0, 4)],
        [1, map(listOf([xJsonKey, delay(fn() => xJsonGen(depth - 1))], 0, 4), fromPairs)]
    ])
fn xFinite(v) =
    if kindOf(v) == "float" then isFinite(v)
    else if kindOf(v) == "list" then all(v, xFinite)
    else if kindOf(v) == "record" then all(values(v), xFinite)
    else true
fn xValid(v) =
    if kindOf(v) == "string" then not contains(v, "\xff")
    else if kindOf(v) == "list" then all(v, xValid)
    else if kindOf(v) == "record" then all(values(v), xValid) and all(keys(v), xValid)
    else true
