let settingNames = rxRsNames()
gen settingKey = elements(settingNames)

gen badNumberText = elements(["nan", "inf", "-inf", "1e999", "-1e999", "NaN", "Infinity", "-nan"])
gen junkText = elements(["", "abc", "--", " ", "true", "e5", "x1", "."])
gen numberText = oneof(float(-1000, 1000), float(-1e6, 1e6), int(-100, 100), bool(), elements([0, 1, 2, 3, 4, 5, 11, 12, 255]))
gen anyText = frequency([[8, numberText], [1, badNumberText], [1, junkText], [2, nasty(float(-1e4, 1e4))]])
gen pairGen = [settingKey, anyText]

fn keysOfKind(kind) = filter(settingNames, fn(k) => rxRsKind(k) == kind)
