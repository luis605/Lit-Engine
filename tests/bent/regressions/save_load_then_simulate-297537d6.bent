include "../laws/persistence.bent"

example save_load_then_simulate {
  p = [
    spawn(dynamic: true, friction: 0.0, height: 0.1, mass: 0.1, mesh: 0, parent: -1, pos: vec3(0.0, 0.0, 0.0), restitution: 0.0, rot: quat(1.0, 0.0, 0.0, 0.0), scale: vec3(0.25, 0.25, 0.25), shape: "hull", size: 0.1, vel: vec3(0.0, 0.0, 0.0))
  ],
  n = 1
}
