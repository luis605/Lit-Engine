include "../laws/core.bent"

example degenerate_scale_stays_finite {
  p = [
    spawn(dynamic: false, parent: -1, pos: vec3(0.0, 0.0, 0.0), rot: quat(1.0, 0.0, 0.0, 0.0), scale: vec3(0.0, 0.0, 0.0), shape: "none"),
    spawn(dynamic: false, parent: -1, pos: vec3(0.0, 0.0, 0.0), rot: quat(1.0, 0.0, 0.0, 0.0), scale: vec3(0.0, 0.0, 0.0), shape: "none"),
    reparent(keepWorld: true, parent: 1, target: 0)
  ]
}
