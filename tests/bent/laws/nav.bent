include "../lib/prelude.bent"

gen obstacle = navObstacle(center: vec3(float(-15, 15), 1, float(-15, 15)), half: vec3(float(0.3, 4), 1, float(0.3, 4)))
gen floorPoint = vec3(float(-18, 18), 0, float(-18, 18))
gen navSetup = navBuild(half: 20, cell: elements([0.25, 0.5, 1.0]), radius: float(0, 1))

fn flat(v) = vec3(v.x, 0, v.z)
fn clearance(p, box, slack) =
    let dx = max([box.min.x - p.x, 0.0, p.x - box.max.x]) in
    let dz = max([box.min.z - p.z, 0.0, p.z - box.max.z]) in
    let inside = p.x > box.min.x + slack and p.x < box.max.x - slack and p.z > box.min.z + slack and p.z < box.max.z - slack in
    if inside then -1.0 else sqrt(dx * dx + dz * dz)
fn samples(a, b) = map(range(9), fn(i) => lerp(a, b, toFloat(i) / 8.0))
fn segments(points) = zip(points, drop(points, 1))
fn pathLength(points) = sumBy(segments(points), fn(s) => distance(flat(s[0]), flat(s[1])))

law nav_path_endpoints {
    forall (obs: listOf(obstacle, 0, 8), nav: navSetup, from: floorPoint, to: floorPoint)
    => after(obs ++ [nav]) {
        let path = navPath(from, to) in
        not (navWalkable(from) and navWalkable(to) and path.found and not path.partial) or (
            len(path.points) >= 1
            and distance(flat(head(path.points)), flat(from)) <= 1.5 * navCell() + 1e-3
            and distance(flat(last(path.points)), flat(to)) <= 1.5 * navCell() + 1e-3)
    }
}

law nav_path_avoids_obstacles {
    forall (obs: listOf(obstacle, 0, 8), nav: navSetup, from: floorPoint, to: floorPoint)
    => after(obs ++ [nav]) {
        let path = navPath(from, to) in
        not (navWalkable(from) and navWalkable(to) and path.found) or (
            forall s in segments(path.points): forall q in samples(s[0], s[1]): forall box in navObstacles():
                clearance(q, box, navCell() + 1e-3) >= max(0.0, navRadius() - navCell()) - 1e-3)
    }
}

law nav_path_length_consistent {
    forall (obs: listOf(obstacle, 0, 8), nav: navSetup, from: floorPoint, to: floorPoint)
    => after(obs ++ [nav]) {
        let path = navPath(from, to) in not path.found or path.length ~= pathLength(path.points) within 1e-3
    }
}

law nav_open_floor_connected {
    forall (nav: navSetup, from: floorPoint, to: floorPoint)
    => after([nav]) { not (navWalkable(from) and navWalkable(to)) or navPath(from, to).found }
}
