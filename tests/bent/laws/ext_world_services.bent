include "../lib/ext_world.bent"

gen seedGen = oneof(int(0, 5), int(0, 4294967295), int(0, 9007199254740992))
gen seqGen = oneof(int(0, 5), int(0, 4294967295))
fn sumOf(xs) = fold(xs, 0.0, fn(a, x) => a + x)
fn meanOf(xs) = sumOf(xs) / len(xs)

law pcg32_matches_the_reference_implementation {
    rngSeq(42, 54, 6) == [0xa15c02b7, 0x7b47f409, 0xba1d3330, 0x83d2f293, 0xbfa4784b, 0xcbed606e]
}

law hash_name_is_fnv1a_64 {
    hashName("") == 0 - 3750763034362895579 and hashName("a") == 0 - 5808556873153909620
}

law pcg32_outputs_are_32_bit {
    forall (seed: seedGen, seq: seqGen)
    => all(rngSeq(seed, seq, 200), fn(x) => x >= 0 and x <= 4294967295)
}

law pcg32_streams_and_seeds_are_independent {
    forall (seed: seedGen, s1: seqGen, s2: seqGen, seed2: seedGen)
    where s1 != s2 and seed != seed2
    => rngSeq(seed, s1, 8) != rngSeq(seed, s2, 8) and rngSeq(seed, s1, 8) != rngSeq(seed2, s1, 8)
}

law pcg32_restore_continues_the_sequence {
    forall (seed: seedGen, seq: seqGen, skip: int(0, 300))
    => let r = rngRestoreCheck(seed, seq, skip, 50) in r.original == r.restored and r.equalObjects
}

law pcg32_below_stays_below_the_bound {
    forall (seed: seedGen, bound: oneof(int(0, 20), int(1, 4294967295), elements([1, 2, 3, 65536, 2147483648, 2147483649, 4294967295])))
    => all(rngBelowSeq(seed, 1, bound, 300), fn(x) => (if bound == 0 then x == 0 else x < bound))
}

law pcg32_below_is_uniform {
    forall (seed: seedGen, bound: int(2, 24))
    => let n = 400 * bound in
       let xs = rngBelowSeq(seed, 7, bound, n) in
       let expected = n / bound in
       let chi = sumBy(range(0, bound), fn(v) => sq(count(xs, fn(x) => x == v) - expected) / expected) in
       let dof = bound - 1 in
       chi < dof + 7 * sqrt(2 * dof) + 12
}

law pcg32_below_has_no_modulo_bias {
    forall (seed: seedGen)
    => let bound = 3221225472 in
       let xs = rngBelowSeq(seed, 3, bound, 3000) in
       let low = count(xs, fn(x) => x < bound / 3) / 3000.0 in
       abs(low - 0.3333) < 0.06
}

law pcg32_uniform_is_in_unit_interval_with_mean_half {
    forall (seed: seedGen, seq: seqGen)
    => let xs = rngUniformSeq(seed, seq, 2000) in
       all(xs, fn(x) => x >= 0 and x < 1) and abs(meanOf(xs) - 0.5) < 0.05 and max(xs) > 0.95 and min(xs) < 0.05
}

law pcg32_range_stays_in_range {
    forall (seed: seedGen, lo: float(-1000, 1000), width: oneof(float(0, 10), float(0, 1e-3), float(0, 5000)))
    => all(rngRangeSeq(seed, 1, lo, lo + width, 200), fn(x) => x >= lo - 1e-6 * (1 + abs(lo)) and x <= lo + width + 1e-6 * (1 + abs(lo)))
}

law pcg32_range_int_is_inclusive_and_covers_small_ranges {
    forall (seed: seedGen, lo: int(-50, 50), span: int(0, 7))
    => let xs = rngRangeIntSeq(seed, 1, lo, lo + span, 400) in
       all(xs, fn(x) => x >= lo and x <= lo + span) and (forall v in range(lo, lo + span + 1): contains(xs, v))
}

law pcg32_range_int_over_the_full_int_range_is_not_constant {
    forall (seed: seedGen)
    => len(dedup(rngRangeIntSeq(seed, 1, -2147483648, 2147483647, 50))) > 10
}

law pcg32_chance_extremes_and_frequency {
    forall (seed: seedGen, p: float(0.05, 0.95))
    => all(rngChanceSeq(seed, 1, 0.0, 300), fn(b) => not b) and all(rngChanceSeq(seed, 1, 1.0, 300), fn(b) => b)
       and abs(count(rngChanceSeq(seed, 2, p, 2000), fn(b) => b) / 2000.0 - p) < 0.07
}

gen streamName = elements(["main", "a", "b", "physics", "loot", ""])
gen streamOps = listOf([streamName, int(0, 12)], 1, 12)

law named_streams_are_pure_and_independent {
    forall (seed: seedGen, ops: streamOps, name: streamName)
    => let results = rngService(seed, ops) in
       let mine = flatten(map(filter(zip(ops, results), fn(pair) => pair[0][0] == name), fn(pair) => pair[1])) in
       cover("draws from the stream", len(mine) > 0) and mine == rngSeq(seed, hashName(name), len(mine))
}

law reseeding_restarts_streams {
    forall (seed: seedGen, seed2: seedGen, name: streamName, n: int(1, 10), m: int(1, 10))
    => let r = rngService(seed, [[name, n], ["@seed", seed2], [name, m]]) in
       r[0] == rngSeq(seed, hashName(name), n) and r[2] == rngSeq(seed2, hashName(name), m)
}

law world_streams_follow_the_seed_not_the_scene {
    forall (p: program, sd: seedGen, name: elements(["loot", "ai", "x"]), n: int(1, 20))
    => after(p ++ [seed(n: sd), rngDraw(stream: name, n: n)]) { map(rngLog(), fn(e) => e[1]) } == rngSeq(sd, hashName(name), n)
}

law world_reseed_restarts_world_streams {
    forall (p: program, s1: seedGen, s2: seedGen, n: int(1, 10))
    => after(p ++ [seed(n: s1), rngDraw(stream: "loot", n: n), seed(n: s2), rngDraw(stream: "loot", n: n)]) { map(rngLog(), fn(e) => e[1]) } == rngSeq(s1, hashName("loot"), n) ++ rngSeq(s2, hashName("loot"), n)
}

fn setAt(xs, i, v) = map(enumerate(xs), fn(pair) => if pair[0] == i then v else pair[1])
fn tableStep(m, op) =
    let n = len(m) in
    if op[0] == "set" then (if n == 0 then m else setAt(m, op[1] % n, op[2]))
    else if op[0] == "erase" then (if n == 0 then m else setAt(m, op[1] % n, ""))
    else if op[0] == "move" then (if n < 2 or op[1] % n == op[2] % n then m else setAt(setAt(m, op[2] % n, m[op[1] % n]), op[1] % n, ""))
    else if op[0] == "resize" then (if op[1] <= n then take(m, op[1]) else m ++ repeat("", op[1] - n))
    else if op[0] == "clear" then []
    else m

gen tableOp = frequency([
    [6, ["set", int(0, 40), elements(["a", "bb", "ccc", "", "a", "with space", "t\nx"])]],
    [2, ["erase", int(0, 40)]],
    [4, ["move", int(0, 40), int(0, 40)]],
    [1, ["resize", int(0, 60)]],
    [1, ["clear"]]
])

law text_table_matches_a_list_model {
    forall (size: int(0, 30), ops: listOf(tableOp, 0, 60))
    => textTableRun(size, ops) == fold(ops, repeat("", size), tableStep)
}

gen jobCount = oneof(int(0, 5), int(0, 300), int(1000, 4000))
gen grainGen = oneof(int(0, 3), int(1, 64), int(100, 5000))

law parallel_for_visits_every_index_once {
    forall (n: jobCount, grain: grainGen, workers: int(0, 8))
    => let r = jobsRun(n, grain, workers, 1) in
       cover("parallel", workers > 0 and n > grain) and
       all(r.visits, fn(v) => v == 1) and r.badChunks == 0 and len(r.visits) == n
       and (n == 0 or (r.chunks[0][0] == 0 and last(r.chunks)[1] == n and all(zip(take(r.chunks, len(r.chunks) - 1), tail(r.chunks)), fn(pair) => pair[0][1] == pair[1][0])))
       and all(r.chunks, fn(c) => c[1] - c[0] <= max(grain, 1) or len(r.chunks) == 1)
}

law parallel_for_results_do_not_depend_on_the_worker_count {
    forall (n: jobCount, grain: grainGen, w1: int(0, 8), w2: int(0, 8))
    => jobsRun(n, grain, w1, 1).values == jobsRun(n, grain, w2, 1).values and jobsRun(n, grain, w1, 1).values == map(range(0, n), fn(i) => i * i + 7)
}

law parallel_for_survives_concurrent_submitters {
    forall (n: int(1, 800), grain: int(1, 40), workers: int(1, 6), submitters: int(2, 4))
    => let r = jobsRun(n, grain, workers, submitters) in all(r.visits, fn(v) => v == submitters) and r.badChunks == 0
}

gen prio = int(-3, 3)

law async_jobs_run_every_job_exactly_once {
    forall (workers: int(1, 4), prios: listOf(prio, 0, 40), seed: int(0, 1000))
    => let mask = map(enumerate(prios), fn(pair) => (pair[0] * 7 + seed) % 3 == 0) in
       let r = asyncRun(workers, prios, mask) in
       cover("some cancelled", any(mask, fn(m) => m)) and cover("some not cancelled", any(mask, fn(m) => not m)) and
       all(r.calls, fn(c) => c == 1) and len(r.order) == len(prios) and
       map(r.cancelled, fn(c) => c == 1) == mask and r.cancelledJobs == count(mask, fn(m) => m) and r.pending == 0
}

law async_jobs_run_in_priority_order_on_one_worker {
    forall (prios: listOf(prio, 0, 40))
    => asyncRun(1, prios, map(prios, fn(p) => false)).order == map(sortBy(enumerate(prios), fn(pair) => pair[1] * 1000 + pair[0]), fn(pair) => pair[0])
}

law async_jobs_destructor_runs_the_queue {
    forall (workers: int(1, 4), n: int(0, 300))
    => all(asyncDestroyRun(workers, n), fn(c) => c == 1)
}

gen pname = elements(["x", "y", "z", "gain", "mix"])
gen pbound = float(-10, 10)
gen paramOp = frequency([
    [3, ["declare", pname, pbound, oneof(just(0), float(0, 2)), pbound, pbound]],
    [4, ["set", pname, nasty(float(-20, 20))]],
    [1, ["snap", pname, nasty(float(-20, 20))]],
    [4, ["update", float(0, 0.5)]],
    [1, ["snapAll"]]
])

law param_values_stay_in_bounds_and_in_sync {
    forall (ops: listOf(paramOp, 1, 40))
    => let r = paramRun(ops) in
       all(r.params, fn(p) => p.value >= p.min - 1e-6 and p.value <= p.max + 1e-6 and p.target >= p.min and p.target <= p.max and isFinite(p.value) and isFinite(p.target)) and
       all(r.params, fn(p) => p.busValue == p.value) and allDistinct(map(r.params, fn(p) => p.slot)) and all(r.params, fn(p) => p.slot >= 0 and p.slot < 256)
}

law param_smoothing_never_overshoots {
    forall (start: float(-5, 5), target: float(-5, 5), smooth: float(0.05, 3), dts: listOf(float(0.001, 5), 1, 20))
    => let ops = [["declare", "p", start, smooth, -10, 10], ["set", "p", target]] ++ map(dts, fn(dt) => ["update", dt]) in
       let values = map(drop(paramRun(ops).trace, 2), fn(row) => row[0][0]) in
       let lo = min(start, target) in let hi = max(start, target) in
       all(values, fn(v) => v >= lo - 1e-5 and v <= hi + 1e-5) and
       all(zip(values, tail(values)), fn(pair) => abs(pair[1] - target) <= abs(pair[0] - target) + 1e-5)
}

law param_without_smoothing_follows_on_update {
    forall (start: float(-5, 5), target: float(-5, 5), dt: float(0.001, 1))
    => let r = paramRun([["declare", "p", start, 0, -10, 10], ["set", "p", target], ["update", dt]]) in
       r.params[0].value ~= target within 1e-6 and r.trace[1][0][0] ~= start within 1e-6
}

law param_smoothing_is_frame_rate_independent {
    forall (start: float(-5, 5), target: float(-5, 5), smooth: float(0.05, 3), dt: float(0.01, 2), n: int(2, 30))
    => let one = paramRun([["declare", "p", start, smooth, -10, 10], ["set", "p", target], ["update", dt]]) in
       let many = paramRun([["declare", "p", start, smooth, -10, 10], ["set", "p", target]] ++ repeat(["update", dt / n], n)) in
       abs(one.params[0].value - many.params[0].value) < 2e-3
}

law param_set_clamps_and_ignores_non_finite {
    forall (lo: float(-5, 0), hi: float(0, 5), v: nasty(float(-100, 100)))
    => let r = paramRun([["declare", "p", 0, 0, lo, hi], ["set", "p", v], ["update", 0.1]]) in
       r.params[0].value >= lo - 1e-6 and r.params[0].value <= hi + 1e-6 and isFinite(r.params[0].value)
}

law param_slots_run_out_cleanly {
    forall (extra: int(0, 40))
    => let r = paramRun(map(range(0, 256 + extra), fn(i) => ["declare", "p" ++ str(i), i, 0, -1000, 1000])) in
       len(r.params) == 256 and allDistinct(map(r.params, fn(p) => p.slot)) and sort(map(r.params, fn(p) => p.slot)) == range(0, 256)
}

gen curveXs = map(listOf(float(0.01, 4), 2, 8), fn(steps) => drop(fold(steps, [0.0], fn(acc, d) => acc ++ [last(acc) + d]), 0))
gen curvePoints = bind(curveXs, fn(xs) => map(listOf(float(-10, 10), len(xs), len(xs)), fn(ys) => zip(xs, ys)))

law curve_interpolates_its_points {
    forall (pts: curvePoints, mode: int(0, 2), before: float(0.01, 10), beyond: float(0.01, 10))
    => let ys = map(pts, fn(p) => p[1]) in
       all(pts, fn(p) => curveEval(pts, mode, p[0]) ~= p[1] within 1e-4) and
       curveEval(pts, mode, pts[0][0] - before) ~= ys[0] within 1e-5 and curveEval(pts, mode, last(pts)[0] + beyond) ~= last(ys) within 1e-5
}

law curve_values_stay_within_the_control_range {
    forall (pts: curvePoints, mode: int(0, 2), x: float(-1, 25))
    => let ys = map(pts, fn(p) => p[1]) in
       let v = curveEval(pts, mode, x) in v >= min(ys) - 1e-4 and v <= max(ys) + 1e-4
}

law curve_step_and_linear_shapes {
    forall (pts: curvePoints, x: float(0, 20), h: float(0, 0.01))
    => let last_le = last(filter(pts, fn(p) => p[0] <= x)) in
       let slopeMax = max(map(zip(pts, tail(pts)), fn(pair) => abs(pair[1][1] - pair[0][1]) / (pair[1][0] - pair[0][0]))) in
       (len(filter(pts, fn(p) => p[0] <= x)) == 0 or curveEval(pts, 2, x) ~= last_le[1] within 1e-5)
       and abs(curveEval(pts, 0, x + h) - curveEval(pts, 0, x)) <= slopeMax * h + 1e-4
}

law curve_of_monotone_points_is_monotone {
    forall (xs: curveXs, ys0: listOf(float(0, 3), 8, 8), mode: int(0, 2), a: float(0, 25), b: float(0, 25))
    => let ys = take(drop(fold(take(ys0, len(xs)), [0.0], fn(acc, d) => acc ++ [last(acc) + d]), 1), len(xs)) in
       let pts = zip(xs, ys) in
       curveEval(pts, mode, min(a, b)) <= curveEval(pts, mode, max(a, b)) + 1e-4
}

gen paramDoc = {params: {gain: {default: float(-1, 1), min: -2, max: 2, smooth: float(0, 1)}, mix: {default: 0.5, min: 0, max: 1, slot: int(0, 300)}}}
law param_file_damage_is_total {
    forall (doc: paramDoc, at: int(0, 400), c: text(1, 1), mode: int(0, 2))
    => let s = jsonDump(doc) in
       let i = at % (len(s) + 1) in
       let m = if mode == 0 then substr(s, 0, i) ++ c ++ substr(s, i) else if mode == 1 then substr(s, 0, i) ++ substr(s, i + 1) else substr(s, 0, i) ++ c ++ substr(s, i + 1) in
       let r = paramLoad(m) in
       (r.ok or len(r.error) > 0) and (not r.ok or r.slotsDistinct)
}

law gizmo_snap_lands_on_the_grid {
    forall (v: float(-1000, 1000), step: float(0.01, 50))
    => let s = gizmoSnap(v, step) in
       abs(s - v) <= step / 2 + 1e-3 and abs(s / step - round(s / step)) < 1e-2 and gizmoSnap(s, step) ~= s within 1e-3
}

law gizmo_ray_plane_hits_lie_on_ray_and_plane {
    forall (o: smallVec, d: unitVec3(), pp: smallVec, n: unitVec3())
    => let r = gizmoRayPlane(o, d, pp, n) in
       cover("hit", r.hit) and cover("miss", not r.hit) and
       (if r.hit then (abs(dot(r.point - pp, n)) < 1e-3 and length(cross(r.point - o, d)) < 1e-3 and dot(r.point - o, d) >= -1e-4)
        else (abs(dot(d, n)) < 1e-4 or dot(pp - o, n) / dot(d, n) < 1e-4))
}

law gizmo_signed_angle_is_antisymmetric_and_rotates {
    forall (axis: unitVec3(), a: unitVec3(), b: unitVec3())
    => let pa = a - axis * dot(a, axis) in
       let pb = b - axis * dot(b, axis) in
       length(pa) < 0.1 or length(pb) < 0.1 or (
           let ang = gizmoSignedAngle(a, b, axis) in
           let back = gizmoSignedAngle(b, a, axis) in
           abs(ang + back) < 1e-3 and abs(gizmoSignedAngle(a, a, axis)) < 1e-4 and
           rotate(axisAngle(axis, ang * 180 / 3.141592653589793), normalize(pa)) ~= normalize(pb) within 2e-3)
}

law gizmo_enclosing_sphere_contains_every_input {
    forall (spheres: listOf([smallVec, float(0, 5)], 1, 10))
    => let r = gizmoEnclosingSphere(spheres) in
       all(spheres, fn(s) => distance(r.center, s[0]) + s[1] <= r.radius + 1e-3)
}

law gizmo_distance_to_segment_matches_reference {
    forall (p: smallVec, s: smallVec, e: smallVec)
    => let a = vec3(s.x, s.y, 0) in let b = vec3(e.x, e.y, 0) in let q = vec3(p.x, p.y, 0) in
       let ab = b - a in
       let t = if dot(ab, ab) < 1e-12 then 0 else clampf(dot(q - a, ab) / dot(ab, ab), 0, 1) in
       let want = distance(q, a + ab * t) in
       gizmoDistanceToSegment(p, s, e) ~= want within 1e-3 and gizmoDistanceToSegment(p, s, e) ~= gizmoDistanceToSegment(p, e, s) within 1e-4
       and gizmoDistanceToSegment(p, s, e) <= min(distance(q, a), distance(q, b)) + 1e-4
}

law gizmo_rotate_about_is_a_rigid_motion_about_the_pivot {
    forall (pos: smallVec, rot: unitQuat(), pivot: smallVec, axis: unitVec3(), deg: float(-180, 180))
    => after([spawn(shape: "none", dynamic: false, pos: pos, rot: rot)]) {
        let m = worldMatrix(entity(0)) in
        let turned = gizmoRotateAbout(m, pivot, axis, deg) in
        let back = gizmoRotateAbout(turned, pivot, axis, 0 - deg) in
        distance(vec3(turned[12], turned[13], turned[14]), pivot) ~= distance(pos, pivot) within 1e-3 and back ~= m within 1e-3
    }
}

law gizmo_frame_distance_fits_the_sphere {
    forall (r: float(0.1, 100), fov: float(10, 120), aspect: float(0.3, 3), r2: float(0.1, 100))
    => let d = gizmoFrameDistance(r, fov, aspect) in
       isFinite(d) and d >= r / sin(radians(fov / 2)) * 0.5 and (r <= r2 ==> gizmoFrameDistance(r2, fov, aspect) >= d - 1e-4)
}

gen replayTick = [float(0.001, 0.1), listOf(oneof(int(0, 511), elements([32, 65, 87, 340])), 0, 4), vec3(float(-500, 500), float(-500, 500), 0), vec3(float(-50, 50), float(-50, 50), 0), int(0, 255)]
gen replayTicks = listOf(replayTick, 0, 12)

law replay_file_roundtrip_is_exact {
    forall (seed: seedGen, ticks: replayTicks)
    => let r = replayRoundtrip(seed, ticks) in r.ok and r.seedEqual and r.lengthEqual and r.firstBad == -1
}

law replay_file_damage_is_total {
    forall (seed: seedGen, ticks: replayTicks, at: int(0, 2000), c: text(1, 1), mode: int(0, 3))
    => let s = replayText(seed, ticks) in
       let i = at % (len(s) + 1) in
       let m = if mode == 0 then substr(s, 0, i) ++ c ++ substr(s, i) else if mode == 1 then substr(s, 0, i) ++ substr(s, i + 1) else if mode == 2 then substr(s, 0, i) ++ c ++ substr(s, i + 1) else substr(s, 0, i) in
       let r = replayParse(m) in
       (r.ok or len(r.error) > 0) and (mode != 3 or i >= len(s) - 1 or not r.ok)
}
