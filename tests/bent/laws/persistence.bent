include "../lib/prelude.bent"

law save_load_preserves_content {
    forall (p: program)
    => after(p) { contentHash() } == after(p ++ [saveLoad()]) { contentHash() }
}

law save_load_then_simulate {
    forall (p: program, n: int(1, 60))
    => after(p ++ [step(n: n)]) { contentHash() } == after(p ++ [saveLoad(), step(n: n)]) { contentHash() }
}

gen worldEdits = listOf(frequency([[6, spawnAny], [6, editAction], [3, structuralAction], [5, stepAction]]), 0, 25)

law snapshot_restore_identity {
    forall (p: program, q: worldEdits)
    => after(p) { worldHash() } == after(p ++ [snapshot(slot: 0)] ++ q ++ [restore(slot: 0)]) { worldHash() }
}

law snapshot_text_identity {
    forall (p: program, q: worldEdits)
    => after(p) { contentHash() } == after(p ++ [snapshotText(slot: 0)] ++ q ++ [restoreText(slot: 0)]) { contentHash() }
}

law snapshot_then_simulate {
    forall (p: program, q: worldEdits, n: int(1, 60))
    => after(p ++ [step(n: n)]) { worldHash() } == after(p ++ [snapshot(slot: 0)] ++ q ++ [restore(slot: 0), step(n: n)]) { worldHash() }
}

law snapshot_then_simulate_content {
    forall (p: program, q: worldEdits, n: int(1, 60))
    => after(p ++ [step(n: n)]) { contentHash() } == after(p ++ [snapshot(slot: 0)] ++ q ++ [restore(slot: 0), step(n: n)]) { contentHash() }
}

law save_system_roundtrip {
    forall (p: program)
    => after(p) { contentHash() } == after(p ++ [saveRoundtrip()]) { contentHash() }
}

gen deltaEdit = frequency([[4, editAction], [2, destroy(target: target)], [1, stepAction]])

law delta_roundtrip {
    forall (base: spawns, edits: listOf(deltaEdit, 0, 12))
    => let edited = base ++ [deltaTrack(cell: "c")] ++ edits ++ [deltaCapture(cell: "c")] in
       after(edited) { contentHash() } == after(edited ++ [deltaReload(), deltaApply(cell: "c")]) { contentHash() }
}

law delta_json_fixpoint {
    forall (base: spawns, edits: listOf(deltaEdit, 0, 12))
    => let edited = base ++ [deltaTrack(cell: "c")] ++ edits ++ [deltaCapture(cell: "c")] in
       after(edited) { deltaJson() } == after(edited ++ [deltaReload()]) { deltaJson() }
}

law delta_untouched_is_empty {
    forall (base: spawns, n: int(0, 3))
    => after(base ++ [deltaTrack(cell: "c"), deltaCapture(cell: "c")]) { deltaCount() == 0 }
}
