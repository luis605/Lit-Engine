include "../lib/prelude.bent"

law memory_safe {
    forall (p: programPlus, q: nastyProgram)
    => after(p ++ [step(n: 3), snapshot(slot: 0), saveLoad(), restore(slot: 0), compact(), step(n: 2)] ++ q ++ [step(n: 3), compact()]) {
        entityCount() == liveCount() and worldErrors() == []
    }
}

law audio_trace_without_config_is_memory_safe {
    forall (src: vec3(float(-30, 30), float(-3, 3), float(-30, 30)))
    => let r = head(audioTrace({listener: vec3(0, 0, 0), boxes: [], sources: [src]})) in r.attenuation >= 0
}
