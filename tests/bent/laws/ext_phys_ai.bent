# AI (docs/AI.md): behaviour trees, utility selection with decision traces, finite state machines and blackboards, against reference
# models written in Bent. aiRun(graphJsonText, {ticks, dt, seed, bb, fsm}) builds a BehaviorRunner with deterministic test actions:
# ok (success), bad (failure), inc (count += 1), flip (flag toggles), rand (r = uniform(); success when r < 0.5).
include "../lib/ext_phys.bent"

fn graph(root) = jsonDump({name: "g", root: root})
fn run(root, spec) = aiRun(graph(root), spec)

# ---------------------------------------------------------------- stateless trees against a reference interpreter

gen aCmpOp = elements(["<", "<=", ">", ">=", "==", "!="])
gen aLeaf = frequency([
    [3, {type: "action", action: "ok"}], [3, {type: "action", action: "bad"}], [3, {type: "action", action: "inc"}],
    [2, {type: "condition", when: {key: "count", op: aCmpOp, value: int(0, 6)}}],
    [1, {type: "set", key: "count", add: int(-2, 3)}], [1, {type: "set", key: "count", value: int(0, 5)}]])
fn composite(child) = frequency([
    [3, {type: "sequence", children: listOf(child, 1, 3)}], [3, {type: "selector", children: listOf(child, 1, 3)}],
    [1, {type: "parallel", policy: elements(["all", "any"]), children: listOf(child, 1, 3)}],
    [1, {type: "inverter", child: child}], [1, {type: "succeeder", child: child}], [1, {type: "failer", child: child}]])
gen aTree1 = frequency([[2, aLeaf], [3, composite(aLeaf)]])
gen aTree = frequency([[2, aLeaf], [3, composite(aTree1)]])

fn cmp(a, op, b) =
    if op == "<" then a < b else if op == "<=" then a <= b else if op == ">" then a > b
    else if op == ">=" then a >= b else if op == "==" then a == b else a != b
fn kidsOf(n) = if has(n, "children") then n.children else [n.child]
fn evSeq(kids, c, isSeq) = fold(kids, {c: c, s: if isSeq then "success" else "failure", stop: false}, fn(acc, k) =>
    if acc.stop then acc else (let r = ev(k, acc.c) in
        if isSeq then (if r.s == "failure" then {c: r.c, s: "failure", stop: true} else {c: r.c, s: "success", stop: false})
        else (if r.s == "success" then {c: r.c, s: "success", stop: true} else {c: r.c, s: "failure", stop: false})))
fn evPar(kids, c) = fold(kids, {c: c, ok: 0, bad: 0}, fn(acc, k) => let r = ev(k, acc.c) in
    {c: r.c, ok: acc.ok + (if r.s == "success" then 1 else 0), bad: acc.bad + (if r.s == "failure" then 1 else 0)})
fn flipStatus(s) = if s == "success" then "failure" else "success"
fn ev(n, c) =
    if n.type == "action" then (if n.action == "ok" then {c: c, s: "success"} else if n.action == "bad" then {c: c, s: "failure"} else {c: c + 1, s: "success"})
    else if n.type == "condition" then {c: c, s: if cmp(c, n.when.op, n.when.value) then "success" else "failure"}
    else if n.type == "set" then {c: if has(n, "add") then c + n.add else n.value, s: "success"}
    else if n.type == "sequence" then (let r = evSeq(n.children, c, true) in {c: r.c, s: r.s})
    else if n.type == "selector" then (let r = evSeq(n.children, c, false) in {c: r.c, s: r.s})
    else if n.type == "parallel" then (let r = evPar(n.children, c) in
        {c: r.c, s: if n.policy == "any" then (if r.ok > 0 then "success" else "failure") else (if r.bad > 0 then "failure" else "success")})
    else (let r = ev(n.child, c) in
        if n.type == "inverter" then {c: r.c, s: flipStatus(r.s)} else if n.type == "succeeder" then {c: r.c, s: "success"} else {c: r.c, s: "failure"})
fn model(tree, c, ticks) = if ticks == 0 then {statuses: [], c: c} else (
    let r = ev(tree, c) in let rest = model(tree, r.c, ticks - 1) in {statuses: [r.s] ++ rest.statuses, c: rest.c})

# Trees without running nodes: statuses tick by tick and the final blackboard counter equal the reference interpreter's.
law ai_tree_matches_reference_interpreter {
    forall (tree: aTree, c0: int(0, 4), ticks: int(1, 6))
    => let r = run(tree, {ticks: ticks, bb: {count: c0}}) in
       let m = model(tree, c0, ticks) in
       r.ok and r.statuses == m.statuses and r.count == m.c and r.tickCount == ticks
}

# The same graph, seed and blackboard always produce the same statuses, trace, blackboard and state hash (random actions included).
gen rLeaf = frequency([[3, {type: "action", action: "rand"}], [2, {type: "action", action: "inc"}], [1, {type: "action", action: "flip"}], [1, {type: "action", action: "bad"}]])
gen rTree = frequency([[2, rLeaf], [3, composite(frequency([[2, rLeaf], [2, composite(rLeaf)]]))]])
law ai_run_is_deterministic {
    forall (tree: rTree, seed: int(0, 1000), ticks: int(1, 12))
    => let spec = {ticks: ticks, seed: seed, bb: {count: 0}} in
       run(tree, spec) == run(tree, spec)
}

# Random actions really consume the seeded stream: different seeds give different outcomes on some run (the law fails if rand were constant).
law ai_seed_drives_random_actions {
    forall (seed: int(0, 100000))
    => let tree = {type: "selector", children: map(range(8), fn(i) => {type: "sequence", children: [{type: "action", action: "rand"}, {type: "action", action: "inc"}]})} in
       let a = run(tree, {ticks: 30, seed: seed}) in
       let b = run(tree, {ticks: 30, seed: seed + 1}) in
       a.r >= 0 and a.r < 1 and (a.stateHash != b.stateHash or a.blackboard != b.blackboard or a.statuses != b.statuses or a.count != b.count or a.r != b.r)
}

# ---------------------------------------------------------------- blackboards

gen bbWrite = {key: elements(["a", "b", "c"]), kind: elements(["set", "add", "copy"]), v: float(-5, 5), from: elements(["a", "b", "c"])}
fn writeNode(w) =
    if w.kind == "set" then {type: "set", key: w.key, value: w.v}
    else if w.kind == "add" then {type: "set", key: w.key, add: w.v}
    else {type: "set", key: w.key, value: {key: w.from}}

# Blackboard writes (set, add, copy-from-key) behave like a record update, and survive a JSON round trip of the whole blackboard.
law ai_blackboard_writes_match_model {
    forall (writes: listOf(bbWrite, 0, 8), a0: float(-3, 3))
    => let r = run({type: "sequence", children: map(writes, writeNode) ++ [{type: "action", action: "ok"}]}, {ticks: 1, bb: {a: a0}}) in
       let expected = fold(writes, {a: a0}, fn(bb, w) => modelWrite(bb, w)) in
       let got = jsonParse(r.blackboard).value in
       r.ok and r.statuses == ["success"] and keys(got) == keys(expected) and forall key in keys(expected): got[key] ~= expected[key] within 1e-9
}
fn modelWrite(bb, w) =
    let cur = get(bb, w.key, 0.0) in
    let upd = if w.kind == "set" then w.v else if w.kind == "add" then cur + w.v else (if has(bb, w.from) then bb[w.from] else cur) in
    if w.kind == "copy" and not has(bb, w.from) then bb else fromPairs(map(dedup(keys(bb) ++ [w.key]), fn(kk) => [kk, if kk == w.key then upd else bb[kk]]))

# ---------------------------------------------------------------- utility selection and its decision trace

gen uCons = {input: elements(["x", "y"]), min: float(-1, 1), max: float(2, 6)}
gen uOption = {weight: float(0.2, 2), considerations: listOf(uCons, 0, 3), gate: elements([0, 1])}
fn clamp01(v) = clampf(v, 0.0, 1.0)
fn normalized(c, bb) = clamp01((bb[c.input] - c.min) / (c.max - c.min))
fn combined(mode, cs, bb) =
    if len(cs) == 0 then 1.0 else (
        let vs = map(cs, fn(c) => normalized(c, bb)) in
        let n = toFloat(len(cs)) in
        if mode == "min" then minOf(vs) else if mode == "max" then maxOf(vs)
        else if mode == "average" then sum(vs) / n else if mode == "sum" then sum(vs)
        else (let p = fold(vs, 1.0, fn(a, v) => a * v) in if n > 1 then p + (1.0 - p) * (1.0 - 1.0 / n) * p else p))
fn optionScore(mode, o, bb) = if o.gate == 0 and bb.g <= 0.5 then -1.0 else combined(mode, o.considerations, bb) * o.weight

# The traced option scores equal an independent evaluation of the considerations (linear curves, every combine mode), and the winner is
# an available option with the highest score.
law ai_utility_trace_matches_reference_scores {
    forall (mode: elements(["product", "min", "max", "average", "sum"]), options: listOf(uOption, 1, 4), x: float(-2, 7), y: float(-2, 7), g: float(0, 1))
    => let tree = {type: "utility", name: "u", select: "best", combine: mode, options: map(enumerate(options), fn(e) => (
           let o = e[1] in
           let base = {name: "o" + str(e[0]), weight: o.weight, considerations: o.considerations, node: {type: "action", action: "ok"}} in
           if o.gate == 0 then with(base, gate: {key: "g", op: ">", value: 0.5}) else base))} in
       let bb = {x: x, y: y, g: g} in
       let r = run(tree, {ticks: 1, bb: bb}) in
       let ev0 = head(filter(r.events, fn(e) => e.kind == "utility")) in
       let scores = map(options, fn(o) => optionScore(mode, o, bb)) in
       let best = maxOf(scores) in
       r.ok and len(ev0.options) == len(options)
       and (forall e in enumerate(ev0.options): e[1].available == (scores[e[0]] >= 0 or options[e[0]].gate == 1) and (not e[1].available or e[1].score ~= scores[e[0]] within 1e-4))
       and (if best < 0 and len(filter(ev0.options, fn(o) => o.available)) == 0 then ev0.winner == ""
            else (let w = filter(ev0.options, fn(o) => o.name == ev0.winner) in len(w) == 1 and w[0].available and w[0].score >= maxOf(map(filter(ev0.options, fn(o) => o.available), fn(o) => o.score)) - 1e-9))
}

# minScore: when every option scores below it the utility node fails and no option wins.
law ai_utility_min_score_fails_when_nothing_qualifies {
    forall (x: float(-1, 0.4), floor: float(0.6, 1))
    => let tree = {type: "utility", name: "u", select: "best", minScore: floor, options: [
           {name: "a", considerations: [{input: "x", min: 0.0, max: 1.0}], node: {type: "action", action: "ok"}},
           {name: "b", weight: 0.5, considerations: [{input: "x", min: 0.0, max: 1.0}], node: {type: "action", action: "ok"}}]} in
       let r = run(tree, {ticks: 2, bb: {x: x}}) in
       r.statuses == ["failure", "failure"] and forall e in r.events: e.kind != "utility" or e.winner == ""
}

# ---------------------------------------------------------------- finite state machines

gen fsmTransition = {to: int(0, 3), at: int(0, 8), op: elements([">=", ">"])}
gen fsmStates = listOf(listOf(fsmTransition, 0, 2), 2, 4)
fn fsmName(i) = "s" + str(i)
fn fsmNode(states, initial) = {type: "fsm", name: "m", initial: fsmName(initial % len(states)), states: fromPairs(map(enumerate(states), fn(e) =>
    [fsmName(e[0]), {node: {type: "action", action: "inc"}, transitions: map(e[1], fn(t) => {to: fsmName(t.to % len(states)), when: {key: "count", op: t.op, value: t.at}})}]))}
fn fsmFire(trs, c, n) = let hit = filter(trs, fn(t) => if t.op == ">=" then c >= t.at else c > t.at) in
    if len(hit) == 0 then -1 else head(hit).to % n
fn fsmModel(states, cur, c, ticks) = if ticks == 0 then [] else (
    let f = fsmFire(states[cur], c, len(states)) in
    let next = if f < 0 then cur else f in
    [fsmName(next)] ++ fsmModel(states, next, c + 1, ticks - 1))

# The FSM node follows its transition table: first matching transition of the current state, evaluated before the state runs.
law ai_fsm_follows_transition_table {
    forall (states: fsmStates, initial: int(0, 3), ticks: int(1, 14))
    => let r = run(fsmNode(states, initial), {ticks: ticks, fsm: "m", bb: {count: 0}}) in
       r.ok and r.states == fsmModel(states, initial % len(states), 0, ticks) and r.statuses == repeat("running", ticks)
}

# Every FSM transition in the decision trace names a real state and happened on the tick the model says it did.
law ai_fsm_trace_matches_states {
    forall (states: fsmStates, initial: int(0, 3), ticks: int(1, 14))
    => let r = run(fsmNode(states, initial), {ticks: ticks, fsm: "m", bb: {count: 0}}) in
       let fsmEvents = filter(r.events, fn(e) => e.kind == "fsm") in
       r.ok and (forall e in fsmEvents: e.tick >= 0 and e.tick < ticks and exists i in range(len(states)): e.winner == fsmName(i))
       and (forall i in range(1, ticks): r.states[i] != r.states[i - 1] ==> exists e in fsmEvents: e.tick == i and e.winner == r.states[i])
}
