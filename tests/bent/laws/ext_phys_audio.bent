include "../lib/ext_phys.bent"

gen voiceGen = {freq: float(100, 2000), amp: float(0.05, 0.9), gain: float(0.1, 1), spatial: bool(), pitch: elements([0.5, 1.0, 2.0, 4.0]),
                pos: vec3(float(-20, 20), float(-5, 5), float(-20, 20)), min: float(0.5, 3), max: float(20, 60), loop: true, seconds: 1.0}
fn mixRender(voices, extra) = audioRender(with(extra, voices: voices, blocks: 4))
fn nonSpatial(v) = with(v, spatial: false)

law audio_mix_peak_bounded_by_gains {
    forall (voices: listOf(voiceGen, 1, 5), master: float(0, 1.5), bus: float(0, 1))
    => let vs = map(voices, fn(v) => with(v, bus: "fx")) in
       let r = mixRender(vs, {buses: [{name: "fx", gain: bus}], masterGain: master}) in
       let bound = sumBy(voices, fn(v) => v.amp * v.gain) * bus * master in
       not r.nonFinite and r.peak <= bound * 1.02 + 1e-4
}

law audio_muted_or_zero_gain_bus_is_silent {
    forall (voices: listOf(voiceGen, 1, 4), mute: bool())
    => let vs = map(voices, fn(v) => with(v, bus: "fx")) in
       let r = mixRender(vs, {buses: [{name: "fx", gain: if mute then 1.0 else 0.0, mute: mute}]}) in
       r.peak < 1e-6
}

law audio_bus_gain_scales_output_linearly {
    forall (v: voiceGen, g: float(0.1, 1), k: float(0.2, 0.9))
    => let one = mixRender([with(nonSpatial(v), bus: "fx")], {buses: [{name: "fx", gain: g}]}) in
       let part = mixRender([with(nonSpatial(v), bus: "fx")], {buses: [{name: "fx", gain: g * k}]}) in
       one.rmsL > 1e-4 and abs(part.rmsL / one.rmsL - k) < 0.02 and abs(part.rmsR / one.rmsR - k) < 0.02
}

law audio_attenuation_monotone_in_distance {
    forall (v: voiceGen, d1: float(0.2, 40), d2: float(0.2, 40), angle: float(0, 360))
    => let near = min(d1, d2) in
       let far = max(d1, d2) in
       let dir = vec3(cos(radians(angle)), 0, sin(radians(angle))) in
       let at = fn(d) => audioRender({voices: [with(v, spatial: true, pos: dir * d)], blocks: 3, listener: vec3(0, 0, 0), forward: vec3(0, 0, 1)}) in
       let rn = at(near) in
       let rf = at(far) in
       let loud = fn(r) => r.rmsL * r.rmsL + r.rmsR * r.rmsR in
       loud(rf) <= loud(rn) * 1.02 + 1e-9 and (near > v.max ==> loud(rn) < 1e-6)
}

law audio_inverse_distance_law {
    forall (amp: float(0.2, 0.8), dmin: float(1, 3), k: float(1.2, 4))
    => let v = {freq: 440.0, amp: amp, gain: 1.0, spatial: true, pitch: 1.0, min: dmin, max: 100.0, loop: true, seconds: 1.0} in
       let at = fn(d) => audioRender({voices: [with(v, pos: vec3(0, 0, d))], blocks: 6}) in
       let a = at(dmin) in
       let b = at(dmin * k) in
       let ea = a.rmsL * a.rmsL + a.rmsR * a.rmsR in
       let eb = b.rmsL * b.rmsL + b.rmsR * b.rmsR in
       abs(eb / ea - 1.0 / (k * k)) < 0.05 / (k * k) + 0.01
}

law audio_ducking_is_monotone_in_depth {
    forall (db1: float(-30, -3), db2: float(-30, -3), amp: float(0.3, 0.9))
    => let trigger = {freq: 220.0, amp: amp, gain: 1.0, spatial: false, bus: "voice", loop: true, seconds: 1.0, pos: vec3(0, 0, 0), min: 1.0, max: 50.0, pitch: 1.0} in
       let music = with(trigger, bus: "music", freq: 880.0) in
       let at = fn(db) => audioRender({voices: [trigger, music], buses: [{name: "voice"}, {name: "music"}], ducks: [{trigger: "voice", target: "music", db: db, attack: 0.01, release: 0.2}], blocks: 40}) in
       let d1 = last(at(db1).ducks)[0] in
       let d2 = last(at(db2).ducks)[0] in
       d1 <= 1.0 + 1e-6 and d1 > 0 and d2 > 0 and (db1 <= db2 ==> d1 <= d2 + 1e-3) and d1 <= 1.0 - 0.3 * (1.0 - pow(10.0, db1 / 20.0))
}

law audio_no_trigger_no_ducking {
    forall (db: float(-30, -3), amp: float(0.3, 0.9))
    => let music = {freq: 880.0, amp: amp, gain: 1.0, spatial: false, bus: "music", loop: true, seconds: 1.0, pos: vec3(0, 0, 0), min: 1.0, max: 50.0, pitch: 1.0} in
       let r = audioRender({voices: [music], buses: [{name: "voice"}, {name: "music"}], ducks: [{trigger: "voice", target: "music", db: db}], blocks: 20}) in
       last(r.ducks)[0] > 0.999
}

gen openSource = vec3(float(-30, 30), float(-3, 3), float(-30, 30))
fn trace1(spec, src) = head(audioTrace(with(spec, sources: [src])))

law audio_open_air_path_is_direct_and_monotone {
    forall (a: openSource, b: openSource, listener: vec3(float(-5, 5), float(-1, 1), float(-5, 5)))
    => let spec = {listener: listener, boxes: []} in
       let ra = trace1(spec, a) in
       let rb = trace1(spec, b) in
       let da = distance(a, listener) in
       let db = distance(b, listener) in
       (da < 55 ==> (ra.audible and ra.direct and ra.hops == 0 and abs(ra.pathLength - da) < 1e-2 and ra.attenuation >= 0 and ra.attenuation <= 1.0 + 1e-6))
       and (da < 55 and db < 55 ==> (da <= db ==> ra.attenuation >= rb.attenuation - 1e-4))
}

law audio_occlusion_only_reduces {
    forall (src: vec3(float(8, 20), float(-1, 1), float(-5, 5)), wall: vec3(float(2, 6), float(-1, 1), float(-1, 1)), half: vec3(float(0.2, 1), float(1, 4), float(1, 4)))
    => let open = trace1({listener: vec3(0, 0, 0), boxes: []}, src) in
       let blocked = trace1({listener: vec3(0, 0, 0), boxes: [{center: wall, half: half}]}, src) in
       blocked.occlusion >= 0 and blocked.occlusion <= 1 + 1e-6 and blocked.directOcclusion >= 0 and blocked.directOcclusion <= 1 + 1e-6
       and blocked.pathLength >= distance(src, vec3(0, 0, 0)) - 1e-2 and blocked.attenuation <= open.attenuation + 1e-4
       and blocked.lowpassHz <= open.lowpassHz + 1e-3 and blocked.attenuation >= 0
}

law audio_hops_are_bounded {
    forall (max: int(0, 3), src: vec3(float(10, 25), float(0, 2), float(-5, 5)), enter: vec3(float(1, 4), float(0, 2), float(-2, 2)), leave: vec3(float(5, 20), float(0, 2), float(-3, 3)))
    => let wall = {center: vec3(6, 0, 0), half: vec3(0.5, 6, 6)} in
       let spec = {listener: vec3(0, 1, 0), boxes: [wall], config: {maxHops: max}, hops: [{entry: enter, exit: leave, cost: 1.0}]} in
       let r = trace1(spec, src) in
       r.hops <= max and r.hops >= 0 and (not r.viaHop or r.hops >= 1) and (r.viaHop or r.pathLength >= distance(src, vec3(0, 1, 0)) - 1e-2)
       and (not (r.viaHop and r.hops == 1) or abs(r.pathLength - (distance(vec3(0, 1, 0), enter) + 1.0 + distance(leave, src))) < 0.05)
       and r.attenuation >= 0 and r.attenuation <= 1.0 + 1e-6
}

law audio_open_air_trace_is_symmetric {
    forall (a: vec3(float(-10, 10), float(-2, 2), float(-10, 10)), b: vec3(float(-10, 10), float(-2, 2), float(-10, 10)))
    where distance(a, b) > 0.5
    => let ab = trace1({listener: a, boxes: []}, b) in
       let ba = trace1({listener: b, boxes: []}, a) in
       abs(ab.pathLength - ba.pathLength) < 1e-2 and abs(ab.attenuation - ba.attenuation) < 1e-3
}

gen lineGen = {id: ident(2, 4), at: int(0, 60), priority: int(0, 3), interruptible: bool(), resumable: bool(), positional: false, seconds: float(0.2, 1.5)}
fn uniqueLines(lines) = map(enumerate(lines), fn(e) => with(e[1], id: e[1].id + str(e[0])))
fn eventsOf(r, id) = filter(r.events, fn(e) => e.id == id)
fn kinds(es) = map(es, fn(e) => e.type)

law audio_scheduler_one_voice_and_legal_lifecycle {
    forall (lines: listOf(lineGen, 1, 6))
    => let ls = uniqueLines(lines) in
       let r = audioSched({lines: ls, ticks: 240}) in
       (forall l in r.log: l.voices <= 1)
       and (forall l in ls: (let ks = kinds(eventsOf(r, l.id)) in
              (len(ks) == 0 or head(ks) == "started" or head(ks) == "dropped")
              and (forall i in range(1, len(ks)): (ks[i] == "resumed" ==> ks[i - 1] == "interrupted") and (ks[i] == "started" ==> false)
                                                  and (ks[i] == "finished" ==> (ks[i - 1] == "started" or ks[i - 1] == "resumed")))))
}

law audio_scheduler_priority_interrupts_lower {
    forall (p1: int(0, 2), gap: int(1, 3), seconds: float(0.8, 1.5), at: int(0, 10), later: int(5, 20))
    => let low = {id: "low", at: at, priority: p1, interruptible: true, resumable: true, positional: false, seconds: seconds} in
       let high = {id: "high", at: at + later, priority: p1 + gap, interruptible: true, resumable: true, positional: false, seconds: 0.5} in
       let r = audioSched({lines: [low, high], ticks: at + later + 6}) in
       let t = at + later in
       r.log[t + 1].current == "high" or r.log[t + 2].current == "high"
}

law audio_scheduler_is_deterministic {
    forall (lines: listOf(lineGen, 1, 6))
    => let ls = uniqueLines(lines) in audioSched({lines: ls, ticks: 120}) == audioSched({lines: ls, ticks: 120})
}
