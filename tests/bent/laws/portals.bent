include "../lib/prelude.bent"

gen euler = vec3(float(-180, 180), float(-89, 89), float(-180, 180))
gen uprightEuler = vec3(float(-180, 180), 0, 0)
gen portalPos = vec3(float(-30, 30), float(0, 10), float(-30, 30))
gen halfGen = vec3(float(0.5, 3), float(0.5, 3), 0)

fn walkThrough(pair, f, u, v, yaw, pitch, roll) =
    let start = f.center + f.normal * 2 + f.right * (u * f.half.x) + f.up * (v * f.half.y) in
    [pair, camera(pos: start, yaw: yaw, pitch: pitch, roll: roll), cameraWalk(delta: f.normal * -4, steps: 40)]

law portal_crossing_view_continuous {
    forall (a: portalPos, ae: euler, b: portalPos, be: euler, half: halfGen, u: float(-0.6, 0.6), v: float(-0.6, 0.6),
            yaw: float(-180, 180), pitch: float(-80, 80), roll: float(-180, 180))
    where distance(a, b) > 10
    => let pair = portalPair(a: a, aEuler: ae, b: b, bEuler: be, half: half) in
       let f = after([pair]) { portalFrame(0) } in
       after(walkThrough(pair, f, u, v, yaw, pitch, roll)) { portalCrossings() >= 1 and portalViewError() < 1e-3 }
}

law portal_single_crossing {
    forall (a: portalPos, ae: uprightEuler, b: portalPos, be: uprightEuler, half: halfGen, u: float(-0.6, 0.6), v: float(-0.6, 0.6), yaw: float(-180, 180))
    where distance(a, b) > 10
    => let pair = portalPair(a: a, aEuler: ae, b: b, bEuler: be, half: half) in
       let f = after([pair]) { portalFrame(0) } in
       after(walkThrough(pair, f, u, v, yaw, 0, 0)) { portalCrossings() == 1 and portalPingPongs() == 0 }
}

law portal_miss_does_not_cross {
    forall (a: portalPos, ae: euler, b: portalPos, be: euler, half: halfGen, side: elements([-1, 1]), out: float(1.3, 3))
    where distance(a, b) > 10
    => let pair = portalPair(a: a, aEuler: ae, b: b, bEuler: be, half: half) in
       let f = after([pair]) { portalFrame(0) } in
       let start = f.center + f.normal * 2 + f.right * (side * out * f.half.x) in
       after([pair, camera(pos: start), cameraWalk(delta: f.normal * -4, steps: 40)]) { portalCrossings() == 0 }
}

fn mapThrough(fa, fb, p) =
    let d = p - fa.center in
    fb.center - fb.right * dot(d, fa.right) + fb.up * dot(d, fa.up) - fb.normal * dot(d, fa.normal)

law portal_transform_matches_frames {
    forall (a: portalPos, ae: euler, b: portalPos, be: euler, half: halfGen, u: float(-0.5, 0.5), v: float(-0.5, 0.5))
    where distance(a, b) > 10
    => let pair = portalPair(a: a, aEuler: ae, b: b, bEuler: be, half: half) in
       let fa = after([pair]) { portalFrame(0) } in
       let fb = after([pair]) { portalFrame(1) } in
       let start = fa.center + fa.normal * 1 + fa.right * (u * fa.half.x) + fa.up * (v * fa.half.y) in
       after([pair, camera(pos: start), cameraWalk(delta: fa.normal * -2, steps: 20)]) {
           portalCrossings() == 1 and cameraView().pos ~= mapThrough(fa, fb, start - fa.normal * 2) within 1e-3
       }
}
