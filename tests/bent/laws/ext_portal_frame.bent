include "../lib/ext_portal.bent"

fn nodesOf(r) = r.nodes
fn planeDist(p, pos) = let r = xpPair(p) in dot(r.normalA, pos - r.centerA)
fn maxDepthOf(r) = fold(r.nodes, 0, fn(m, n) => max(m, n.depth))

law portal_frame_root_is_the_camera {
    forall (f: xfInput)
    => let r = xpFrame(f) in r.count >= 1 ==> (r.rootErr < 1e-5 and r.rootProjErr < 1e-5 and r.nodes[0].depth == 0 and r.nodes[0].parent == -1 and r.nodes[0].cell == 0)
}

law portal_frame_hard_view_cap_and_depth_slack {
    forall (f: xfInput)
    => let r = xpFrame(f) in r.count <= 24 and maxDepthOf(r) <= f.maxDepth + 1
}

law portal_frame_soft_budgets_hold_for_small_portals {
    forall (f: xfInputSmall)
    => let r = xpFrame(f) in r.count <= max(f.maxViews, 2) and maxDepthOf(r) <= f.maxDepth
}

law portal_frame_scenarios_have_children {
    forall (f: xfInputOther) where f.maxDepth >= 2 and f.maxViews >= 8 and f.minPixels < 3
    => let r = xpFrame(f) in r.count >= 1
}

law portal_frame_is_a_tree_with_unique_keys {
    forall (f: xfInput)
    => let r = xpFrame(f) in
       (forall i in range(1, r.count): r.nodes[i].parent >= 0 and r.nodes[i].parent < i and r.nodes[i].depth == r.nodes[r.nodes[i].parent].depth + 1 and r.nodes[i].cellErr == 0)
       and allDistinct(map(r.nodes, fn(n) => n.key))
}

law portal_frame_node_view_equals_transform_chain {
    forall (f: xfInput)
    => let r = xpFrame(f) in forall i in range(1, r.count): r.nodes[i].portal >= 0 and r.nodes[i].chainErr < 5e-3
}

law portal_frame_openings_belong_to_the_cell {
    forall (f: xfInput)
    => let r = xpFrame(f) in forall n in r.nodes: n.strayOpenings == 0
}

law portal_frame_oblique_plane_is_the_destination_plane {
    forall (f: xfInputOther)
    => let r = xpFrame(f) in
       forall n in r.nodes: n.oblique ==> ((n.planeSamples == 0 or n.planeErr < 2e-3) and (n.frontSamples == 0 or n.frontMax < 1.0005) and (n.eyeSamples == 0 or n.eyeMin > 0.9995))
}

gen xfAimed = {s: xpPairAny, dist: float(0.8, 8), u: xpSignedUnit, v: xpSignedUnit, roll: float(-20, 20), depth: int(1, 3), views: int(2, 24)}
fn aimedFrame(c) =
    let r = xpPair(c.s) in
    let hx = c.s.half.x in
    let hy = c.s.half.y in
    let pos = r.centerA + r.normalA * c.dist + r.rightA * (c.u * hx) + r.upA * (c.v * hy) in
    let d = r.centerA - pos in
    {pairs: [with(c.s, cellA: 0, cellB: 1)], cells: 2, pos: pos, yaw: atan2(d.z, d.x) * 180 / 3.141592653589793,
     pitch: atan2(d.y, sqrt(d.x * d.x + d.z * d.z)) * 180 / 3.141592653589793, roll: c.roll, maxDepth: c.depth, maxViews: c.views, minPixels: 0, occlusion: false}

law portal_frame_aimed_oblique_plane_is_exact {
    forall (c: xfAimed) where distance(c.s.a, c.s.b) > 12
    => let r = xpFrame(aimedFrame(c)) in
       r.count >= 2 and r.nodes[1].oblique and r.nodes[1].planeSamples > 0 and r.nodes[1].planeErr < 2e-3
       and (r.nodes[1].frontSamples == 0 or r.nodes[1].frontMax < 1.0005) and (r.nodes[1].eyeSamples == 0 or r.nodes[1].eyeMin > 0.9995)
       and r.nodes[1].chainErr < 5e-3
}

law portal_frame_aimed_masked_planes_are_exact {
    forall (c: xfAimed) where distance(c.s.a, c.s.b) > 12
    => let r = xpFrame(aimedFrame(c)) in r.count >= 2 and r.nodes[1].masked and r.nodes[1].maskErr < 5e-3 and r.nodes[1].maskInside == 1
}

law portal_frame_masked_planes_bound_the_aperture {
    forall (f: xfInputOther)
    => let r = xpFrame(f) in forall n in r.nodes: n.masked ==> (n.maskErr < 5e-3 and n.maskInside == 1)
}

law portal_frame_is_deterministic {
    forall (f: xfInput)
    => xpFrameTwice(f)
}

law portal_frame_blocked_portals_spawn_no_views {
    forall (f: xfInputOther) where forall p in f.pairs: abs(planeDist(p, f.pos)) > 0.5
    => let r = xpFrame(with(f, blockAll: true, occlusion: true)) in r.count == 1
}

law portal_frame_ignores_portals_seen_from_behind {
    forall (pairs: listOf(xfPairOther, 1, 3), pos: vec3(float(-3, 3), float(0.5, 3), float(-30, -14)), yaw: float(-180, 180), pitch: float(-20, 20))
    where forall p in pairs: planeDist(p, pos) < -0.5
    => xpFrame({pairs: pairs, cells: 3, pos: pos, yaw: yaw, pitch: pitch}).count == 1
}

law portal_frame_empty_without_portals_or_cell {
    forall (pairs: listOf(xfPair, 0, 2), bad: elements([3, 7, -1]))
    => xpFrame({pairs: [], cells: 3}).count == 0 and xpFrame({pairs: pairs, cells: 3, cell: bad}).count == 0
}
