include "../lib/render.bent"

gen u01 = float(0, 1)
gen wide = float(-50, 50)
gen colorGen = vec3(float(0, 4), float(0, 4), float(0, 4))
gen texId = int(-1, 1023)
gen sane = {baseColor: colorGen, opacity: u01, metallic: u01, roughness: u01, reflectance: u01, occlusion: u01, emissive: colorGen,
            emissiveIntensity: float(0, 1000), clearcoat: u01, clearcoatRoughness: u01, anisotropy: float(-1, 1), subsurface: u01,
            transmission: u01, ior: float(1, 3), thickness: u01, uvScale: float(0.001, 50), normalStrength: float(0, 4), triplanar: bool(),
            baseColorTexture: texId, normalTexture: texId, ormTexture: texId, emissiveTexture: texId}

fn inRange(x, lo, hi) = x >= lo and x <= hi

law material_pack_identity_in_range {
    forall (m: sane)
    => let p = rxMatPack(m) in
       p.baseColorOpacity ~= [m.baseColor.x, m.baseColor.y, m.baseColor.z, m.opacity] within 1e-6
       and p.pbr ~= [m.metallic, m.roughness, m.reflectance, m.occlusion] within 1e-6
       and p.coat[0] ~= m.clearcoat within 1e-6 and p.coat[1] ~= m.clearcoatRoughness within 1e-6 and p.coat[2] ~= m.anisotropy within 1e-6
       and p.subsurface[3] ~= m.subsurface within 1e-6 and p.transmission ~= [m.transmission, m.ior, m.thickness, m.uvScale] within 1e-6
}

law material_pack_clamps_unit_values {
    forall (m: {opacity: wide, metallic: wide, roughness: wide, reflectance: wide, occlusion: wide, clearcoat: wide, clearcoatRoughness: wide,
                subsurface: wide, transmission: wide, thickness: wide, anisotropy: wide, uvScale: wide})
    => let p = rxMatPack(m) in
       all(p.pbr, fn(x) => inRange(x, 0, 1)) and inRange(p.baseColorOpacity[3], 0, 1) and inRange(p.coat[0], 0, 1) and inRange(p.coat[1], 0, 1)
       and inRange(p.coat[2], -1, 1) and inRange(p.subsurface[3], 0, 1) and inRange(p.transmission[0], 0, 1) and inRange(p.transmission[2], 0, 1)
       and p.transmission[3] >= 1e-4 - 1e-9
}

law material_pack_textures_verbatim {
    forall (m: sane)
    => let p = rxMatPack(m) in
       p.textures == [m.baseColorTexture, m.normalTexture, m.ormTexture, m.emissiveTexture] and p.flags[0] == (if m.triplanar then 1.0 else 0.0)
}

law material_pack_monotone {
    forall (a: wide, b: wide, key: elements(["metallic", "roughness", "reflectance", "occlusion", "clearcoat", "opacity", "transmission"]))
    where a <= b
    => let pa = rxMatPack(fromPairs([[key, a]])) in
       let pb = rxMatPack(fromPairs([[key, b]])) in
       let at = fn(p) => if key == "opacity" then p.baseColorOpacity[3] else if key == "clearcoat" then p.coat[0] else if key == "transmission" then p.transmission[0]
                         else if key == "metallic" then p.pbr[0] else if key == "roughness" then p.pbr[1] else if key == "reflectance" then p.pbr[2] else p.pbr[3] in
       at(pa) <= at(pb)
}

law material_pack_emission_scales {
    forall (c: colorGen, k: float(-5, 100))
    => let p = rxMatPack({emissive: c, emissiveIntensity: k}) in
       let kk = max(k, 0) in
       p.emissive[0] ~= c.x * kk within 1e-4 and p.emissive[1] ~= c.y * kk within 1e-4 and p.emissive[2] ~= c.z * kk within 1e-4
}

law material_pack_finite {
    forall (m: sane, scaleUp: float(1, 1e3))
    => let p = rxMatPack(with(m, emissiveIntensity: m.emissiveIntensity * scaleUp)) in
       all(p.baseColorOpacity ++ p.emissive ++ p.pbr ++ p.coat ++ p.sheen ++ p.subsurface ++ p.transmission, isFinite)
}

law material_pack_nan_does_not_reach_gpu {
    forall (key: elements(["metallic", "roughness", "reflectance", "occlusion", "opacity", "clearcoat", "subsurface", "transmission", "thickness"]))
    => let p = rxMatPack(fromPairs([[key, nan]])) in
       all(p.baseColorOpacity ++ p.pbr ++ p.coat ++ p.subsurface ++ p.transmission, isFinite)
}
