include "../lib/ext_portal.bent"

gen xcAny = {frame: unitQuat(), yaw: float(-180, 180), pitch: float(-85, 85), roll: float(-180, 180)}
gen xcNoRoll = {frame: unitQuat(), yaw: float(-180, 180), pitch: float(-85, 85), roll: just(0)}
gen xcUprightFrame = bind(float(-180, 180), fn(a) => axisAngle(vec3(0, 1, 0), a))

fn xcBasisNear(a, b, eps) = a.front ~= b.front within eps and a.up ~= b.up within eps and a.right ~= b.right within eps
fn xcConj(q) = quat(q.w, 0 - q.x, 0 - q.y, 0 - q.z)

law cam_basis_is_orthonormal {
    forall (o: xcAny)
    => let b = xcOrient(o) in
       abs(length(b.front) - 1) < 1e-5 and abs(length(b.up) - 1) < 1e-5 and abs(length(b.right) - 1) < 1e-5
       and abs(dot(b.front, b.up)) < 1e-5 and abs(dot(b.front, b.right)) < 1e-5 and abs(dot(b.up, b.right)) < 1e-5
       and cross(b.right, b.up) ~= (vec3(0, 0, 0) - b.front) within 1e-5
}

law cam_roll_rotates_about_front {
    forall (o: xcNoRoll, r: float(-180, 180))
    => let plain = xcOrient(o) in
       let rolled = xcOrient(with(o, roll: r)) in
       rolled.front ~= plain.front within 1e-5 and abs(dot(rolled.up, plain.up) - cos(radians(r))) < 1e-4
}

law cam_rotate_maps_basis {
    forall (o: xcAny, q: unitQuat())
    => let bef = xcOrient(o) in
       let aft = xcRotate(o, q) in
       aft.front ~= (q * bef.front) within 1e-4 and aft.up ~= (q * bef.up) within 1e-4 and aft.right ~= (q * bef.right) within 1e-4
       and aft.frameOrtho < 1e-5 and abs(aft.frameDet - 1) < 1e-5
}

law cam_rotate_then_inverse_restores {
    forall (o: xcAny, q: unitQuat())
    => xcBasisNear(xcRotate(xcRotate(o, q), xcConj(q)), xcOrient(o), 1e-3)
}

law cam_many_rotations_do_not_drift {
    forall (o: xcAny, qs: listOf(unitQuat(), 20, 120))
    => let r = xcRotateMany(o, qs) in
       let b = xcOrient(o) in
       r.frameOrtho < 1e-5 and abs(r.frameDet - 1) < 1e-5
       and r.front ~= fold(qs, b.front, fn(v, q) => q * v) within 1e-3
       and abs(length(r.front) - 1) < 1e-5 and abs(dot(r.front, r.up)) < 1e-5
}

law cam_canonical_preserves_view {
    forall (f: xcUprightFrame, yaw: float(-180, 180), pitch: float(-85, 85), roll: float(-180, 180), tiny: float(-1e-6, 1e-6))
    => let o = {frame: f, yaw: yaw, pitch: pitch, roll: roll} in
       xcBasisNear(xcCanonical(o), xcOrient(o), 1e-3)
}

law cam_canonical_preserves_view_any_frame {
    forall (o: xcAny)
    => xcBasisNear(xcCanonical(o), xcOrient(o), 1e-3)
}

law cam_canonical_upright_has_no_frame {
    forall (f: xcUprightFrame, yaw: float(-180, 180), pitch: float(-85, 85))
    => let c = xcCanonical({frame: f, yaw: yaw, pitch: pitch, roll: 0, framed: true}) in not c.framed
}

law cam_decompose_roundtrip {
    forall (o: xcAny, f: unitQuat(), hint: float(-720, 720))
    => let target = xcOrient(o) in
       let d = xcDecompose({frame: f}, target.front, target.up, hint) in
       abs(d.yaw - hint) <= 180.0001 and d.front ~= target.front within 1e-3 and d.up ~= target.up within 1e-3
}

gen xcTarget = unitVec3()
gen xcTilted = {frame: unitQuat(), yaw: float(-180, 180), pitch: float(-80, 80), roll: float(-180, 180)}

law cam_relax_keeps_view_direction {
    forall (o: xcTilted, t: xcTarget, seconds: float(0.1, 2), n: int(3, 60))
    => let s = xcRelax(o, t, 1.0 / 60, seconds, n) in
       abs(s[1].pitch) <= 89 ==> forall k in range(len(s)): s[k].front ~= s[0].front within 2e-3
}

law cam_relax_converges {
    forall (o: xcTilted, t: xcTarget, seconds: float(0.05, 1.5))
    => let s = xcRelax(o, t, 1.0 / 60, seconds, toInt(seconds * 60 * 4) + 30) in
       let end = last(s) in
       not end.relaxing and abs(end.roll) < 0.05 and abs(end.pitch) <= 89.05 and end.frameUp ~= normalize(t) within 2e-3
}

law cam_relax_roll_never_overshoots {
    forall (o: xcTilted, t: xcTarget, seconds: float(0.1, 2), dt: float(0.004, 0.05))
    => let s = xcRelax(o, t, dt, seconds, 120) in
       forall k in range(1, len(s) - 1): abs(s[k + 1].roll) <= abs(s[k].roll) + 0.1 and (abs(s[k].roll) < 0.1 or s[k + 1].roll * s[k].roll >= 0 or abs(s[k + 1].roll) < 0.1)
}

law cam_relax_stays_finished {
    forall (o: xcTilted, t: xcTarget, seconds: float(0.1, 2), dt: float(0.004, 0.05))
    => let s = xcRelax(o, t, dt, seconds, 120) in
       forall k in range(1, len(s) - 1): (not s[k].relaxing ==> not s[k + 1].relaxing)
}

example cam_relax_stays_finished {
    o = {frame: quat(-0.7914100974906848, -0.48830919374190135, 0.23324809220305, 0.28428773519192924), pitch: 0.0, roll: 179.9958724975586, yaw: 63.76904106140137},
    t = vec3(-0.22704521563066007, -0.37906294394728324, -0.8970851434424972),
    seconds = 0.1,
    dt = 0.004
}

gen xcExcess = bind(float(20, 60), fn(a) => bind(float(89.1, 89.95), fn(world) => {frame: axisAngle(vec3(1, 0, 0), a), yaw: -90, pitch: world - a, roll: float(-180, 180)}))
law cam_relax_pitch_excess_never_overshoots {
    forall (o: xcExcess, seconds: float(0.4, 2), dt: float(0.004, 0.02))
    => let s = xcRelax(o, vec3(0, 1, 0), dt, seconds, 100) in
       abs(s[1].pitch) > 89 and forall k in range(1, len(s) - 1): (abs(s[k].pitch) > 89 ==> abs(s[k + 1].pitch) <= abs(s[k].pitch) + 1e-3 and abs(s[k + 1].pitch) >= 89 - 1e-3)
}

law cam_relax_pitch_excess_converges_to_the_limit {
    forall (o: xcExcess, seconds: float(0.1, 1))
    => let s = xcRelax(o, vec3(0, 1, 0), 1.0 / 60, seconds, toInt(seconds * 60 * 4) + 30) in
       abs(last(s).pitch) <= 89.05 and not last(s).relaxing
}

law cam_relax_at_once {
    forall (o: xcTilted, t: xcTarget)
    => let s = xcRelax(o, t, 1.0 / 60, 0, 1) in
       not s[1].relaxing and s[1].roll == 0 and s[1].frameUp ~= normalize(t) within 2e-3
}

law cam_relax_upright_is_noop {
    forall (yaw: float(-180, 180), pitch: float(-85, 85), dt: float(0.001, 0.1), seconds: float(0, 2))
    => let o = {yaw: yaw, pitch: pitch, roll: 0} in
       let s = xcRelax(o, vec3(0, 1, 0), dt, seconds, 5) in
       forall k in range(1, len(s)): not s[k].relaxing and xcBasisNear(s[k], s[0], 1e-5)
}

law cam_transform_by_is_rigid_map {
    forall (o: xcAny, p: xpPos, s: xpPairAny)
    => let t = xpPair(s).ta in
       let r = xcCameraCross(p, o, t) in
       r.pos ~= r.expectedPos within 1e-3 and r.front ~= r.expectedFront within 1e-4 and r.up ~= r.expectedUp within 1e-4
       and abs(dot(r.front, r.up)) < 1e-4 and abs(dot(r.right, r.front)) < 1e-4 and abs(length(r.right) - 1) < 1e-4
}

law cam_cross_and_back_is_identity {
    forall (o: xcAny, p: xpPos, s: xpPairAny)
    => let pair = xpPair(s) in
       let there = xcCameraCross(p, o, pair.ta) in
       let back = xcCameraCross(there.pos, there.orientation, pair.tb) in
       let original = xcCameraCross(p, o, xmIdentity()) in
       xmDiff(back.view, original.view) < 5e-3
}

law cam_set_rotation_roundtrip {
    forall (q: unitQuat(), p: xpPos)
    where abs((q * vec3(0, 0, -1)).y) < 0.999
    => let r = xcSetRotation(p, q) in r.rotation ~= q within 1e-3
}
