# Cluster LOD (Engine.meshlet): meshlet builder, LOD DAG, hierarchy and the CPU reference cuts. Every case builds a bumpy,
# anisotropically scaled icosphere (closed, so a correct cut must be watertight) with random builder options.
include "../lib/render.bent"
include "../lib/prelude.bent"

gen meshSpec = {subdiv: int(1, 3), bump: float(0, 0.15), freq: float(1, 9), scale: vec3(float(0.3, 3), float(0.3, 3), float(0.3, 3)),
                groupSize: elements([2, 3, 4, 4, 6]), leafSize: oneof(int(1, 64), just(64)), fanout: int(2, 16), rootFanout: int(2, 64),
                minReduction: float(0.7, 0.95)}
gen view = {cam: vec3(float(-2000, 2000), float(-2000, 2000), float(-2000, 2000)), scale: float(100, 4000), threshold: oneof(float(0.05, 8), elements([0.25, 1.0, 4.0])),
            ortho: bool(), near: elements([0.01, 0.1])}
gen closeView = {cam: vec3(float(-6, 6), float(-6, 6), float(-6, 6)), scale: float(100, 4000), threshold: float(0.05, 4), ortho: bool(), near: elements([0.01, 0.1])}
gen views = listOf(oneof(view, closeView), 1, 6)

# The builder's own structural validator holds for the mesh and the hierarchy, for any options.
law cluster_structure_valid {
    forall (s: meshSpec)
    => let r = rxClusterReport(s) in r.valid and r.hierValid and r.oversize == 0 and r.clusters > 0 and r.hierNodes > 0
}

# Level 0 is the input (exactly its triangles); the DAG simplifies: the top level is a small fraction of it. (A level can hold slightly more
# triangles than the one below when options force tiny groups; the builder's metric is the error, not the count, so only the top is bounded.)
law cluster_level0_is_input_and_levels_shrink {
    forall (s: meshSpec)
    where s.subdiv >= 3
    => let r = rxClusterReport(s) in
       r.levelTris[0] == r.inputTris and last(r.levelTris) * 4 < r.inputTris and r.roots >= 1
}

# Errors are monotone up the DAG: every cluster's parent error is at least its own error, and each level's error window contains its clusters.
law cluster_error_monotone {
    forall (s: meshSpec)
    => let r = rxClusterReport(s) in r.monotoneViolations == 0 and r.levelViolations == 0
}

# Bounding spheres contain their clusters' vertices (culling sphere and LOD sphere).
law cluster_bounds_contain_vertices {
    forall (s: meshSpec)
    => let r = rxClusterReport(s) in r.boundsViolation <= 1e-4 * (1 + max(s.scale.x, max(s.scale.y, s.scale.z))) and r.selfViolation <= 1e-4 * (1 + max(s.scale.x, max(s.scale.y, s.scale.z)))
}

# Building twice gives bit-identical clusters, vertices, triangles and hierarchy.
law cluster_build_deterministic {
    forall (s: meshSpec)
    => rxClusterReport(with(s, nocache: true)).hash == rxClusterReport(with(s, nocache: true)).hash
}

# Cracks: the cluster cut of a closed mesh is watertight at every distance, threshold and projection (an odd edge count means a hole).
law cluster_cut_has_no_cracks {
    forall (s: meshSpec, qs: views)
    => let r = rxClusterReport(s) in
       all(rxClusterCuts(s, qs), fn(c) => cover("a coarse cut (LOD in use)", c.tris < r.inputTris) and cover("the full-detail cut", c.tris == r.inputTris) and c.open == 0 and len(c.flat) > 0)
}

# The hierarchical traversal selects exactly the clusters of the flat cut.
law cluster_hierarchy_equals_flat_cut {
    forall (s: meshSpec, qs: views)
    => all(rxClusterCuts(s, qs), fn(c) => c.hier == c.flat)
}

# A cut never has more triangles than the full-detail mesh, and every selected cluster comes from the mesh.
law cluster_cut_within_mesh {
    forall (s: meshSpec, qs: views)
    => let r = rxClusterReport(s) in all(rxClusterCuts(s, qs), fn(c) => c.tris <= r.inputTris and c.tris > 0 and c.maxLevel < r.levels and c.minLevel >= 0)
}

# Threshold 0 selects exactly the full-detail clusters; an enormous threshold selects roots only.
law cluster_threshold_extremes {
    forall (s: meshSpec, cam: vec3(float(-50, 50), float(-50, 50), float(-50, 50)), scale: float(100, 4000))
    where length(cam) > 4
    => let cuts = rxClusterCuts(s, [{cam: cam, scale: scale, threshold: 0.0}, {cam: cam, scale: scale, threshold: 1e12}]) in
       cuts[0].flat == rxClusterLevelZero(s) and cuts[1].allRoots and cuts[1].hier == cuts[1].flat
}

# Moving the camera away never adds triangles (perspective); a larger threshold never adds triangles.
law cluster_cut_monotone_in_distance_and_threshold {
    forall (s: meshSpec, dir: unitVec3(), d: float(2, 20), grow: float(1.2, 5), t: float(0.1, 2), tgrow: float(1.2, 6), scale: float(200, 3000))
    => let near = rxClusterCuts(s, [{cam: dir * d, scale: scale, threshold: t}, {cam: dir * d * grow, scale: scale, threshold: t},
                                      {cam: dir * d, scale: scale, threshold: t * tgrow}]) in
       near[1].tris <= near[0].tris and near[2].tris <= near[0].tris
}

# The traversal never visits more nodes or tests more clusters than exist.
law cluster_traversal_bounded {
    forall (s: meshSpec, qs: views)
    => let r = rxClusterReport(s) in all(rxClusterCuts(s, qs), fn(c) => c.nodesVisited <= r.hierNodes and c.clustersTested <= r.clusters)
}

# Projected error: linear in the error, never negative, and non-increasing as the camera moves away.
law cluster_projected_error_laws {
    forall (c: vec3(float(-5, 5), float(-5, 5), float(-5, 5)), r: float(0, 2), e: float(0, 1), dir: unitVec3(), d: float(0.5, 100), grow: float(1, 10), k: float(1, 10))
    => let at = fn(dist, err) => rxClusterProjected(c, r, err, c + dir * dist, 1000.0, 0.01) in
       at(d, e) >= 0 and at(d * grow, e) <= at(d, e) * (1 + 1e-5) and at(d, e * k) ~= at(d, e) * k within 1e-4
}

# Arbitrary triangle soups (random points, degenerate and repeated triangles) build into valid cluster meshes and hierarchies.
law cluster_fuzz_soup_valid {
    forall (pts: listOf(vec3(float(-5, 5), float(-5, 5), float(-5, 5)), 3, 40), idx: listOf(int(0, 100000), 0, 150))
    => let r = rxClusterFuzz(pts, idx) in r.valid and r.hierValid and (r.empty or r.level0 <= r.inputTris)
}

# Hostile coordinates (NaN, infinity, huge) never crash the builder; a non-empty result still passes the structural validator
# or is rejected as empty.
law cluster_fuzz_soup_nasty_survives {
    forall (pts: listOf(nastyVec, 3, 30), idx: listOf(int(0, 100000), 3, 60))
    => let r = rxClusterFuzz(pts, idx) in r.empty or r.hierValid or len(r.hierError) > 0
}
