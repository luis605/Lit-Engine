# World core: transforms (local / world matrices, the world matrix cache, scale, rotation, look-at).
include "../lib/ext_world.bent"

gen nonUnitQuat = filter(quat(float(-3, 3), float(-3, 3), float(-3, 3), float(-3, 3)), fn(q) => q.w * q.w + q.x * q.x + q.y * q.y + q.z * q.z > 0.04)
fn qnorm2(q) = q.w * q.w + q.x * q.x + q.y * q.y + q.z * q.z
fn qnormalised(q) = let n = sqrt(qnorm2(q)) in quat(q.w / n, q.x / n, q.y / n, q.z / n)

# The cached world matrix equals the one recomputed from the local matrices up the parent chain, at every step (reads populate the
# cache, the next action must invalidate exactly what it changed: moves, rotations, scales, reparenting, destruction, physics).
law world_matrix_cache_matches_recomputation {
    forall (p: listOf(frequency([[6, hierEdit], [1, step(n: int(1, 4))], [1, spawnBody], [1, compact()]]), 1, 20))
    => always after(p) {
        forall e in entities(): worldMatrix(e) ~= worldMatrixRef(e) within 1e-4
    }
}

# Same under non-uniform scales, rotations and reparenting (no shear identity needed: only the cache is compared).
law world_matrix_cache_matches_with_any_scale {
    forall (p: listOf(frequency([[4, spawnAny], [4, editAction], [2, structuralAction], [1, step(n: int(1, 3))]]), 1, 20))
    => always after(p) {
        forall e in entities(): worldMatrix(e) ~= worldMatrixRef(e) within 1e-3
    }
}

# A child of a root lands at parent position + parent rotation applied to (parent scale * local position).
law child_world_position_composes_parent_transform {
    forall (parentPos: smallVec, parentRot: unitQuat(), parentScale: scaleGen, childPos: smallVec, childScale: scaleGen)
    => after([spawn(shape: "none", dynamic: false, pos: parentPos, rot: parentRot, scale: parentScale),
              spawn(shape: "none", dynamic: false, pos: childPos, scale: childScale, parent: 0)]) {
        worldPosition(entity(1)) ~= worldPosition(entity(0)) + rotate(parentRot, mulv(parentScale, childPos)) within 1e-3
    }
}

law child_world_rotation_composes {
    forall (parentRot: unitQuat(), childRot: unitQuat(), s: float(0.25, 3), childScale: float(0.25, 3))
    => after([spawn(shape: "none", dynamic: false, rot: parentRot, scale: vec3(s, s, s)),
              spawn(shape: "none", dynamic: false, rot: childRot, scale: vec3(childScale, childScale, childScale), parent: 0)]) {
        worldRotation(entity(1)) ~= parentRot * childRot within 1e-3
    }
}

# Local edits compose: two moves are one move of the sum (children and roots alike).
law translate_is_additive {
    forall (p: hierProg, k: target, a: offset, b: offset)
    => after(p ++ [move(target: k, delta: a), move(target: k, delta: b)]) { map(entities(), position) } ~=
       after(p ++ [move(target: k, delta: a + b)]) { map(entities(), position) } within 1e-4
}

# setScale / setRotation read back (the decomposition of the local matrix is faithful), in either order.
law scale_and_rotation_read_back {
    forall (q: unitQuat(), s: scaleGen, order: bool(), pos: smallVec)
    => after([spawn(shape: "none", dynamic: false, pos: pos)] ++ (if order then [setScale(target: 0, scale: s), setRotation(target: 0, rot: q)] else [setRotation(target: 0, rot: q), setScale(target: 0, scale: s)])) {
        scale(entity(0)) ~= s within 1e-4 and rotation(entity(0)) ~= q within 1e-4 and position(entity(0)) ~= pos within 1e-6
    }
}

# Rotations that are not unit length are normalised: the stored rotation is the direction of the input.
law set_rotation_normalises {
    forall (q: nonUnitQuat)
    => after([spawn(shape: "none", dynamic: false), setRotation(target: 0, rot: q)]) {
        rotation(entity(0)) ~= qnormalised(q) within 1e-4 and abs(qnorm2(rotation(entity(0))) - 1) < 1e-4
    }
}

# The world matrix of a rotated entity stays orthonormal (times its scale): no drift from repeated rotation edits.
law repeated_rotation_keeps_basis_orthonormal {
    forall (qs: listOf(nonUnitQuat, 1, 12))
    => after([spawn(shape: "none", dynamic: false)] ++ map(qs, fn(q) => setRotation(target: 0, rot: q)) ++ map(qs, fn(q) => rotateBy(target: 0, axis: vec3(0.3, 0.9, 0.1), degrees: 17))) {
        let m = worldMatrix(entity(0)) in
        abs(m[0] * m[0] + m[1] * m[1] + m[2] * m[2] - 1) < 1e-3 and abs(m[0] * m[4] + m[1] * m[5] + m[2] * m[6]) < 1e-3 and abs(qnorm2(rotation(entity(0))) - 1) < 1e-3
    }
}

# A degenerate rotation (zero quaternion, NaN-free) must not poison the transform.
law zero_quaternion_does_not_poison {
    forall (pos: smallVec)
    => after([spawn(shape: "none", dynamic: false, pos: pos), setRotation(target: 0, rot: quat(0, 0, 0, 0)), spawn(shape: "none", dynamic: false, parent: 0)]) {
        not hasNaN() and worldErrors() == []
    }
}

# Mirrored (negative) scale really mirrors the world axes: the local x axis of the world matrix is s.x * rotated x.
law negative_scale_mirrors_world_axes {
    forall (s: vec3(float(-3, -0.25), float(0.25, 3), float(0.25, 3)))
    => after([spawn(shape: "none", dynamic: false), setScale(target: 0, scale: s)]) {
        let m = worldMatrix(entity(0)) in
        vec3(m[0], m[1], m[2]) ~= vec3(s.x, 0, 0) within 1e-4 and not hasNaN()
    }
}

# Zero scale collapses the subtree onto the parent: finite matrices, children at the parent position.
law zero_scale_collapses_children {
    forall (pos: smallVec, childPos: smallVec, axis: int(0, 2))
    => after([spawn(shape: "none", dynamic: false, pos: pos), spawn(shape: "none", dynamic: false, pos: childPos, parent: 0),
              setScale(target: 0, scale: vec3(if axis == 0 then 0 else 1, if axis == 1 then 0 else 1, if axis == 2 then 0 else 1))]) {
        not hasNaN() and worldErrors() == [] and all(worldMatrix(entity(1)), isFinite)
    }
}

law all_axes_zero_scale_collapses_to_parent_position {
    forall (pos: smallVec, childPos: smallVec)
    => after([spawn(shape: "none", dynamic: false, pos: pos), spawn(shape: "none", dynamic: false, pos: childPos, parent: 0), setScale(target: 0, scale: vec3(0, 0, 0))]) {
        worldPosition(entity(1)) ~= pos within 1e-4
    }
}

# Huge and tiny (but finite) scales stay finite and queryable.
law extreme_scales_stay_finite_and_queryable {
    forall (s: oneof(float(1e3, 1e6), float(1e-6, 1e-3)), pos: smallVec, q: unitQuat(), c: smallVec)
    => after([spawn(shape: "none", dynamic: false, pos: pos, rot: q, scale: vec3(s, s, s), mesh: 1), spawn(shape: "none", dynamic: false, pos: pos, parent: 0, mesh: 1)]) {
        not hasNaN() and worldErrors() == [] and all(worldMatrix(entity(1)), isFinite) and len(overlap(c, 1.0)) >= 0 and raycast(c, c + vec3(1, 0, 0)).distance >= 0
    }
}

# setWorldPosition places the entity at the requested absolute position, whatever the parent chain looks like.
law set_world_position_reads_back {
    forall (p: hierProg, k: target, v: smallVec)
    => after(p ++ [setWorldPosition(target: k, pos: v)]) {
        let e = ref(k) in not alive(e) or worldPosition(e) ~= v within posTol(v) * 4
    }
}

# setWorldRotation sets the world orientation (non-degenerate hierarchy), and does not move the entity.
law set_world_rotation_reads_back {
    forall (p: hierProg, k: target, q: unitQuat())
    => after(p) {
        let e = ref(k) in
        not alive(e) or (let pos = worldPosition(e) in after(p ++ [setWorldRotation(target: k, rot: q)]) { worldRotation(ref(k)) ~= q within 2e-3 and worldPosition(ref(k)) ~= pos within posTol(pos) * 4 })
    }
}

# lookAt makes -Z point at the target.
law look_at_points_forward_at_target {
    forall (p: hierProg, k: target, at: smallVec)
    => after(p) {
        let e = ref(k) in
        not alive(e) or distance(worldPosition(e), at) < 0.05 or after(p ++ [lookAtTarget(target: k, at: at)]) {
            forwardOf(ref(k)) ~= normalize(at - worldPosition(ref(k))) within 2e-3
        }
    }
}

# rotate about an axis twice equals rotating by the summed angle; position and scale are untouched.
law rotate_by_composes {
    forall (axis: unitVec3(), a: float(-180, 180), b: float(-180, 180), q: unitQuat(), pos: smallVec, s: scaleGen)
    => after([spawn(shape: "none", dynamic: false, pos: pos, rot: q, scale: s), rotateBy(target: 0, axis: axis, degrees: a), rotateBy(target: 0, axis: axis, degrees: b)]) {
        let split = rotation(entity(0)) in
        after([spawn(shape: "none", dynamic: false, pos: pos, rot: q, scale: s), rotateBy(target: 0, axis: axis, degrees: a + b)]) {
            rotation(entity(0)) ~= split within 1e-3 and position(entity(0)) ~= pos within 1e-6 and scale(entity(0)) ~= s within 1e-4
        }
    }
}

# Bulk position updates (the dirty-all path above 4096 entities) agree with single updates, spatial index included.
gen batchSize = frequency([[9, int(1, 40)], [1, int(4100, 4200)]])
law bulk_set_positions_equals_single_updates {
    forall (n: batchSize, d: offset, c: smallVec, r: float(1, 30))
    => after([spawnBatch(n: n, pos: vec3(0, 0, 0), spacing: 0.5, mesh: 0), teleportAll(delta: d)]) { [worldHash(), overlap(c, r)] } ==
       after([spawnBatch(n: n, pos: vec3(0, 0, 0), spacing: 0.5, mesh: 0), teleportEach(delta: d)]) { [worldHash(), overlap(c, r)] }
}
