include "../lib/ext_phys.bent"

gen jointOffset = vec3(float(-1, 1), float(0.2, 1.2), float(-1, 1))
fn chainSkeleton(offsets) = map(enumerate(offsets), fn(e) => {name: "j" + str(e[0]), parent: e[0] - 1, pos: e[1], rot: quat(1, 0, 0, 0), scale: vec3(1, 1, 1)})
gen skelGen = map(listOf(jointOffset, 2, 6), chainSkeleton)
gen keyTimes = map(listOf(int(0, 100), 2, 5), fn(ts) => map(dedup(sort(ts)), fn(t) => t / 100.0))
gen posKey = vec3(float(-2, 2), float(-2, 2), float(-2, 2))

fn trackOf(joint, dur, ts, ps, qs) = {joint: joint, pos: map(enumerate(ts), fn(e) => [e[1] * dur, ps[e[0] % len(ps)]]),
                                      rot: map(enumerate(ts), fn(e) => [e[1] * dur, qs[e[0] % len(qs)]]), scale: []}
gen clipGen = bind(float(0.5, 3), fn(dur) => bind(keyTimes, fn(ts) => bind(listOf(posKey, 1, 5), fn(ps) => bind(listOf(unitQuat(), 1, 5), fn(qs) => bind(bool(),
    fn(loop) => map(int(0, 5), fn(joint) => {duration: dur, loop: loop, tracks: [trackOf(joint, dur, ts, ps, qs)]}))))))
fn posBounds(clip, which) = let t = head(clip.tracks) in
    {lo: vec3(minOf(map(t.pos, fn(k) => k[1].x)), minOf(map(t.pos, fn(k) => k[1].y)), minOf(map(t.pos, fn(k) => k[1].z))),
     hi: vec3(maxOf(map(t.pos, fn(k) => k[1].x)), maxOf(map(t.pos, fn(k) => k[1].y)), maxOf(map(t.pos, fn(k) => k[1].z)))}
fn qunit(q) = abs(sq(q.w) + sq(q.x) + sq(q.y) + sq(q.z) - 1.0) < 1e-3
fn poseJoint(pose, j) = pose[j % len(pose)]

law anim_sampling_at_keys_returns_keys {
    forall (skel: skelGen, clip: clipGen)
    => let t = head(clip.tracks) in
       let j = t.joint % len(skel) in
       forall key in filter(t.pos, fn(k) => not clip.loop or k[0] < clip.duration - 1e-4): (let pose = skelSample(skel, with(clip, tracks: [with(t, joint: j)]), key[0]) in pose[j].pos ~= key[1] within 1e-4)
}

law anim_samples_stay_within_keys {
    forall (skel: skelGen, clip: clipGen, time: float(-1, 6))
    => let t = head(clip.tracks) in
       let j = t.joint % len(skel) in
       let b = posBounds(clip, 0) in
       let pose = skelSample(skel, with(clip, tracks: [with(t, joint: j)]), time) in
       let p = pose[j].pos in
       p.x >= b.lo.x - 1e-4 and p.x <= b.hi.x + 1e-4 and p.y >= b.lo.y - 1e-4 and p.y <= b.hi.y + 1e-4 and p.z >= b.lo.z - 1e-4 and p.z <= b.hi.z + 1e-4
       and qunit(pose[j].rot)
}

law anim_looping_and_clamping {
    forall (skel: skelGen, clip: clipGen, phase: float(0.05, 0.95), n: int(1, 3))
    => let time = phase * clip.duration in
       let t = head(clip.tracks) in
       let j = t.joint % len(skel) in
       let c = with(clip, tracks: [with(t, joint: j)]) in
       let a = skelSample(skel, c, time) in
       if clip.loop then skelSample(skel, c, time + n * clip.duration)[j].pos ~= a[j].pos within 1e-3
       else (skelSample(skel, c, clip.duration + n)[j].pos ~= skelSample(skel, c, clip.duration + 2 * n)[j].pos within 1e-5
             and skelSample(skel, c, 0 - n)[j].pos ~= skelSample(skel, c, 0.0 - 2.0 * n)[j].pos within 1e-5)
}

gen poseGen = bind(int(2, 6), fn(n) => listOf({pos: posKey, rot: unitQuat(), scale: vec3(1, 1, 1)}, n, n))

law anim_blend_endpoints_symmetry_and_linearity {
    forall (a: poseGen, w: float(0, 1), seed: int(0, 1000))
    => let b = map(a, fn(j) => {pos: j.pos * -1.0 + vec3(0.5, 0.25, 0), rot: quat(1, 0, 0, 0), scale: vec3(1, 1, 1)}) in
       let skel = chainSkeleton(map(a, fn(j) => vec3(0, 1, 0))) in
       let mid = skelBlend(skel, a, b, w, []) in
       (forall i in range(len(a)): skelBlend(skel, a, b, 0.0, [])[i].pos ~= a[i].pos within 1e-6 and skelBlend(skel, a, b, 1.0, [])[i].pos ~= b[i].pos within 1e-5
           and mid[i].pos ~= lerp(a[i].pos, b[i].pos, w) within 1e-4 and qunit(mid[i].rot)
           and mid[i].pos ~= skelBlend(skel, b, a, 1.0 - w, [])[i].pos within 1e-4)
}

law anim_masked_blend_scales_weight_by_mask {
    forall (a: poseGen, w: float(0, 1), masks: listOf(float(0, 1), 6, 6))
    => let b = map(a, fn(j) => {pos: j.pos + vec3(1, 1, 1), rot: j.rot, scale: vec3(1, 1, 1)}) in
       let skel = chainSkeleton(map(a, fn(j) => vec3(0, 1, 0))) in
       let mask = take(masks, len(a)) in
       let out = skelBlend(skel, a, b, w, mask) in
       forall i in range(len(a)): out[i].pos ~= lerp(a[i].pos, b[i].pos, w * mask[i]) within 1e-4
}

fn fk(skel, pose) = fold(enumerate(pose), [], fn(acc, e) =>
    let i = e[0] in let j = e[1] in let par = skel[i].parent in
    if par < 0 then acc ++ [{pos: j.pos, rot: j.rot}]
    else acc ++ [{pos: acc[par].pos + rotate(acc[par].rot, j.pos), rot: acc[par].rot * j.rot}])
law anim_model_pose_is_forward_kinematics {
    forall (skel: skelGen, rots: listOf(unitQuat(), 6, 6), offs: listOf(posKey, 6, 6))
    => let pose = map(enumerate(skel), fn(e) => {pos: offs[e[0]], rot: rots[e[0]], scale: vec3(1, 1, 1)}) in
       let model = skelModel(skel, pose) in
       let ref = fk(skel, pose) in
       (forall i in range(len(skel)): model[i].pos ~= ref[i].pos within 1e-4 and qunit(model[i].rot))
       and (forall i in range(1, len(skel)): abs(distance(model[i].pos, model[skel[i].parent].pos) - length(pose[i].pos)) < 1e-4)
}

law anim_crossfade_ends_at_target_clip {
    forall (skel: skelGen, c0: clipGen, c1: clipGen, fade: float(0.1, 0.6), warm: int(1, 20))
    => let j0 = head(c0.tracks).joint % len(skel) in
       let j1 = head(c1.tracks).joint % len(skel) in
       let a = with(c0, tracks: [with(head(c0.tracks), joint: j0)]) in
       let b = with(c1, tracks: [with(head(c1.tracks), joint: j1)]) in
       let script = [{op: "play", clip: 0, fade: 0.0}, {op: "update", n: warm, dt: 0.02}, {op: "play", clip: 1, fade: fade}] ++
                    map(range(40), fn(i) => {op: "update", n: 1, dt: 0.02}) in
       let out = skelAnimate(skel, [a, b], script) in
       let fades = map(out, fn(o) => o.fade) in
       (forall i in range(2, len(fades)): fades[i] <= fades[i - 1] + 1e-6)
       and (last(fades) == 0.0)
       and (let end = last(out) in
            let ref = skelSample(skel, b, end.time) in
            forall i in range(len(skel)): end.pose[i].pos ~= ref[i].pos within 1e-3)
}

gen twoBoneSkel = map([float(0.4, 1.5), float(0.4, 1.5)], fn(ls) => chainSkeleton([vec3(0, 0, 0), vec3(0, ls[0], 0), vec3(0.1, ls[1], 0)]))
law anim_two_bone_reaches_or_extends {
    forall (l1: float(0.4, 1.5), l2: float(0.4, 1.5), dir: unitVec3(), reach: float(0.2, 2.6), weight: float(1, 1))
    => let skel = chainSkeleton([vec3(0, 0, 0), vec3(0, l1, 0), vec3(0, l2, 0)]) in
       let target = dir * reach in
       let r = skelTwoBone(skel, {root: 0, mid: 1, tip: 2}, target, unit, 1.0) in
       let m = r.after in
       let total = l1 + l2 in
       abs(distance(m[0].pos, m[1].pos) - l1) < 1e-3 and abs(distance(m[1].pos, m[2].pos) - l2) < 1e-3
       and (if reach <= total - 0.01 and reach >= abs(l1 - l2) + 0.01 then distance(m[2].pos, target) < 2e-3
            else (if reach > total + 0.01 then distance(m[2].pos, normalize(target) * total) < 5e-3 else true))
}

gen skinOpts = {height: float(1.2, 2.2), radial: int(4, 10), rings: int(1, 3), morphs: true}
gen skinPose = {mode: elements(["bind", "random", "walk", "wave"]), seed: int(0, 100000), angle: float(0.1, 1.2), time: float(0, 2), morph: bool()}

law skin_weights_are_normalised_and_valid {
    forall (o: skinOpts)
    => let r = skinCheck(o, {mode: "bind"}) in
       r.valid and r.weightErr < 1e-4 and r.maxJoint < r.joints and r.joints >= 2 and r.vertices > 0 and r.morphs > 0
}

law skin_cpu_deform_matches_reference {
    forall (o: skinOpts, s: skinPose)
    => let r = skinCheck(o, s) in r.nonFinite == 0 and r.refErr < 1e-3
}

law skin_bind_pose_is_identity {
    forall (o: skinOpts)
    => let r = skinCheck(o, {mode: "bind"}) in r.identErr < 1e-4 and r.refErr < 1e-4
}

law skin_rigid_pose_preserves_distances {
    forall (o: skinOpts, seed: int(0, 100000), angle: float(0.1, 1.5))
    => let r = skinCheck(o, {mode: "random", seed: seed, angle: angle}) in r.orthoErr < 1e-3 and r.rigidErr < 1e-3
}

law skin_morph_targets_are_linear {
    forall (o: skinOpts, seed: int(0, 100000))
    => let r = skinCheck(o, {mode: "bind", seed: seed}) in r.morphErr < 1e-4 and r.morphLinErr < 1e-4
}

law skin_bounds_contain_deformed_vertices {
    forall (o: skinOpts, s: skinPose)
    => skinCheck(o, s).boundsExcess <= 1e-3
}

gen rawSkin = listOf([int(0, 9), int(0, 9), int(0, 9), int(0, 9), nasty(float(-1, 3)), nasty(float(-1, 3)), nasty(float(-1, 3)), nasty(float(-1, 3))], 1, 6)
law skin_normalize_repairs_any_weights {
    forall (raw: rawSkin, joints: int(1, 8))
    => let r = skinNormalize(raw, joints) in
       forall v in r.skin: abs(sum(drop(v, 4)) - 1.0) < 1e-4 and all(drop(v, 4), fn(w) => w >= 0 and isFinite(w)) and all(take(v, 4), fn(j) => j >= 0 and j < joints)
}

law face_arkit_names_are_unique_and_indexed {
    forall (i: int(0, 51), junk: text(1, 8))
    => let names = faceNames() in
       len(names) == 52 and allDistinct(names) and faceIndex(names[i]) == i and (contains(names, junk) or faceIndex(junk) == -1)
}

law face_morph_mapping_copies_and_bounds {
    forall (ws: listOf(float(0, 1), 52, 52))
    => let m = faceMorph(ws) in
       len(m.weights) == len(m.names) and len(m.weights) > 0
       and forall e in enumerate(m.weights): e[1] >= 0 and e[1] <= 1 and (m.channels[e[0]] >= 0 ==> e[1] ~= ws[m.channels[e[0]]] within 1e-6) and (m.channels[e[0]] < 0 ==> e[1] == 0)
}

fn faceCurveOf(ch, dur, vs) = {channel: ch, keys: map(enumerate(vs), fn(e) => [dur * toFloat(e[0]) / toFloat(len(vs) - 1), e[1]])}
gen faceCurves = listOf([int(0, 51), listOf(float(-0.5, 1.5), 2, 5)], 1, 4)
gen faceClip = bind(float(0.5, 3), fn(dur) => bind(bool(), fn(loop) => map(faceCurves, fn(cs) => {duration: dur, loop: loop, curves: map(cs, fn(c) => faceCurveOf(c[0], dur, c[1]))})))

law face_clip_sampling_bounded_and_periodic {
    forall (clip: faceClip, t: float(-1, 8))
    => let w = faceClipSample(clip, t) in
       len(w) == 52 and all(w, fn(x) => x >= 0 and x <= 1)
       and (not clip.loop or clip.duration <= 0 or all(zip(w, faceClipSample(clip, t + clip.duration)), fn(p) => abs(p[0] - p[1]) < 1e-3))
}

law face_layering_bounds {
    forall (a: listOf(float(0, 1), 52, 52), b: listOf(float(0, 1), 52, 52), w: float(0, 1))
    => let m = faceCombine(a, b, "max", 1.0) in
       let s = faceCombine(a, b, "add", w) in
       (forall i in range(52): m[i] ~= max(a[i], b[i]) within 1e-6 and s[i] >= a[i] - 1e-6 and s[i] <= a[i] + w * b[i] + 1e-5 and isFinite(s[i]))
}
