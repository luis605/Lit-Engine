include "../lib/prelude.bent"

gen bigDelta = vec3(float(-200000, 200000), float(-1000, 1000), float(-200000, 200000))

fn tol(a, d) = 1e-6 * 16 * (1 + length(a) + length(d)) + 1e-4

law rebase_preserves_world_positions {
    forall (p: program, d: bigDelta)
    => after(p) {
        let before = map(entities(), worldPosition) in
        after(p ++ [rebase(delta: d)]) {
            let now = map(entities(), worldPosition) in
            len(before) == len(now) and all(zip(before, now), fn(pair) => distance(pair[0], pair[1]) <= tol(pair[0], d))
        }
    }
}

law rebase_preserves_relative_hash {
    forall (p: program, d: bigDelta)
    => after(p) { relativeHash() } == after(p ++ [rebase(delta: d)]) { relativeHash() }
}

law rebase_roundtrip {
    forall (p: program, d: bigDelta)
    => after(p ++ [rebase(delta: d), rebase(delta: vec3(0, 0, 0) - d)]) {
        let now = map(entities(), worldPosition) in
        origin() == vec3(0, 0, 0) and all(zip(after(p) { map(entities(), worldPosition) }, now), fn(pair) => distance(pair[0], pair[1]) <= 2 * tol(pair[0], d))
    }
}

law rebase_keeps_camera {
    forall (c: smallVec, d: bigDelta)
    => after([camera(pos: c), rebase(delta: d)]) { cameraView().pos ~= c within tol(c, d) }
}

law rebase_then_simulate_equivalent {
    forall (bodies: listOf(latticeBody, 1, 1), d: vec3(float(-3000, 3000), 0, float(-3000, 3000)), n: int(1, 120))
    => let scene = placeBodies(bodies) in
       after(scene ++ [step(n: n)]) {
           let expected = map(entities(), worldPosition) in
           after(scene ++ [rebase(delta: d), step(n: n)]) { all(zip(expected, map(entities(), worldPosition)), fn(pair) => distance(pair[0], pair[1]) < 0.05) }
       }
}

law floating_origin_bounds_camera {
    forall (path: listOf(vec3(float(-50000, 50000), float(-100, 100), float(-50000, 50000)), 1, 6))
    => always after([floatingOrigin(threshold: 2000, snap: 1024)] ++ flatten(map(path, fn(p) => [cameraWorld(pos: p), step(n: 1)]))) {
        length(cameraPos()) <= 2000 + 1024
    }
}
