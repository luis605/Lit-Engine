include "../../lib/gpu.bent"

gen scene = elements(["vista", "showcase", "gallery"])

law gpu_exposure_is_monotone {
    forall (s: scene, lo: elements([10, 11, 12]), step: elements([2, 3]))
    => let bright = shot(s, [["autoExposure", 0], ["manualEV100", lo]]) in
       let dark = shot(s, [["autoExposure", 0], ["manualEV100", lo + step]]) in
       bright.ok and dark.ok and bright.mean >= dark.mean - 0.002 and bright.mean > dark.mean * 0.9
}

law gpu_exposure_compensation_monotone {
    forall (s: scene)
    => let up = shot(s, [["autoExposure", 0], ["exposureCompensation", 2]]) in
       let down = shot(s, [["autoExposure", 0], ["exposureCompensation", -2]]) in
       up.ok and down.ok and up.mean >= down.mean
}

law gpu_noon_brighter_than_midnight {
    forall (s: elements(["vista", "showcase"]))
    => let noon = shot(s, [["autoExposure", 0], ["manualEV100", 13], ["timeOfDay", 12]]) in
       let night = shot(s, [["autoExposure", 0], ["manualEV100", 13], ["timeOfDay", 0]]) in
       noon.ok and night.ok and noon.mean > night.mean
}

law gpu_debug_views_render {
    forall (v: int(0, 11), s: elements(["vista", "showcase"]))
    => let r = shot(s, [["debugView", v]]) in r.ok and r.logErrors == 0 and r.std > 0.005 and r.mean > 0.001
}

gen renderKey = elements(["renderScale", "exposureCompensation", "manualEV100", "bloomIntensity", "bloomRadius", "aoRadius", "aoIntensity", "ssrSteps", "shadowDistance",
                          "shadowResolution", "shadowCascades", "fogDensity", "reflectionIntensity", "vignette", "contrast", "saturation", "temperature", "cloudCoverage",
                          "sunIlluminance", "skyBrightness", "environmentIntensity", "upscaleSharpness", "clusterErrorPixels", "timeOfDay", "grain", "localShadowCount"])
gen hostileValue = elements(["nan", "inf", "-inf", "-5", "1e30", "-1e30", "0", "99999", "1e-30", "0.0001"])
law gpu_hostile_settings_keep_frames_sane {
    forall (writes: listOf([renderKey, hostileValue], 1, 4))
    => let r = shot("vista", writes) in
       r.ok and r.logErrors == 0 and r.exactBlackFrac < 0.95 and r.mean < 0.99 and (r.mean > 0.002 or len(filter(writes, fn(w) => contains(["exposureCompensation", "manualEV100", "sunIlluminance", "skyBrightness", "environmentIntensity", "timeOfDay"], w[0]))) > 0)
}

law gpu_feature_switches_independent {
    forall (offs: subseq(["ssao", "ssgi", "bloom", "shadows", "fog", "clouds", "godRays", "fxaa", "areaLights", "bentNormals", "contactShadows", "pcss", "virtualShadows", "localShadows", "instancing", "clusterLod", "colorBleed"]))
    => let r = shot("showcase", map(offs, fn(k) => [k, 0])) in
       r.ok and r.logErrors == 0 and r.mean > 0.02 and r.mean < 0.98 and r.std > 0.01
}
