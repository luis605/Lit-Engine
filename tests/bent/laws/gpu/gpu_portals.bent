include "../../lib/gpu.bent"

gen scene = elements(portalScenes)
gen cam = [float(-4, 4), float(1, 3), float(2, 10), float(-120, -60), float(-15, 10)]

law gpu_portal_quad_leaves_no_dark_blobs {
    forall (s: scene, c: cam)
    => let r = rxGpuShot({scene: s, camera: c}) in r.ok and r.mean > 0.03 and r.blobScore < 0.03
}

law gpu_portal_views_clean {
    forall (s: scene, c: cam)
    => let r = rxGpuShot({scene: s, camera: c}) in r.ok and r.logErrors == 0 and r.logWarnings == 0 and r.exactBlackFrac < 0.5 and r.std > 0.01
}

law gpu_portal_graph_parity {
    forall (s: scene)
    => let on = shot(s, [["renderGraph", 1]]) in
       let off = shot(s, [["renderGraph", 0]]) in
       on.ok and off.ok and agrees(rxImageDiff(on, off), noiseOf(s, [["renderGraph", 1]]))
}
