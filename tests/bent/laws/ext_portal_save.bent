# Delta store and save system (docs/Save.md): captured deltas rebuild the edited world in a fresh one (also in another origin), applying is
# idempotent, saves resume exactly (random streams, state, storylets, observation), damaged files are rejected without touching the session,
# a failed apply rolls everything back.
include "../lib/ext_portal.bent"

gen xdOp = frequency([
    [4, {op: "move", i: int(0, 9), delta: vec3(float(-5, 5), float(-5, 5), float(-5, 5))}],
    [2, {op: "destroy", i: int(0, 9)}],
    [2, {op: "rename", i: int(0, 9), name: ident(1, 5)}],
    [1, {op: "tag", i: int(0, 9), tag: ident(1, 4)}],
    [2, {op: "add", pos: vec3(float(-20, 20), float(0, 10), float(-20, 20))}]
])
gen xdPositions = listOf(vec3(float(-30, 30), float(0, 10), float(-30, 30)), 1, 8)

# Capture, write JSON, load it into a fresh world with the same base entities and apply: the live entities (names, absolute positions) are
# exactly those of the edited world. Removed bases are gone, changed ones changed, added ones recreated.
law delta_rebuilds_the_edited_world {
    forall (pos: xdPositions, ops: listOf(xdOp, 0, 10))
    => let r = xdRun({pos: pos, ops: ops}) in r.loaded and r.once ~= r.edited within 1e-4
}

# Same, when the loading world has a different origin (a save made far away, loaded after a rebase): absolute positions survive.
law delta_survives_another_origin {
    forall (pos: xdPositions, ops: listOf(xdOp, 0, 10), shift: vec3(float(-4000, 4000), float(-100, 100), float(-4000, 4000)))
    => let r = xdRun({pos: pos, ops: ops, shift: shift}) in r.loaded and r.once ~= r.edited within 0.01
}

# Applying twice is applying once; capturing twice gives the same document; (the document's `source` slot of an added entity is the creating world's slot index and is not expected to survive a reload).
law delta_apply_and_capture_are_idempotent {
    forall (pos: xdPositions, ops: listOf(xdOp, 0, 10))
    => let r = xdRun({pos: pos, ops: ops}) in r.twice ~= r.once within 1e-5 and r.captureIdempotent
}

# The removed / added / changed sets match the edits: untouched worlds record nothing; every destroyed base is in `removed`, nothing else is.
law delta_sets_match_the_edits {
    forall (pos: xdPositions, kill: listOf(int(0, 9), 0, 5))
    => let victims = dedup(map(kill, fn(k) => k % len(pos))) in
       let r = xdRun({pos: pos, ops: map(kill, fn(k) => {op: "destroy", i: k})}) in
       let doc = jsonParse(r.json).value in
       sort(map(victims, fn(v) => "e" + str(v))) == sort(get(doc.cells, "c", {removed: []}).removed) and (len(victims) > 0 or r.deltaCount == 0)
}

# ---------------------------------------------------------------- save system

# Run n ticks straight, versus k ticks, save, a session with another seed loads it, the rest: the same final fingerprint (random streams,
# state variables, storylets, parameters, observation, time, camera). Through a file and through capture / apply.
law save_resume_equals_straight_run {
    forall (seed: int(1, 1000), total: int(10, 120), split: int(0, 120), entities: int(0, 8), viaFile: bool())
    => let r = xvContinue({seed: seed, total: total, split: split, entities: entities, file: viaFile}) in
       r.loaded and r.midSame and r.resumedSame and r.continuedSame
}

# Any damage to a save file is caught: the load fails and the session is untouched; if a flipped byte happens to leave the content equal
# (hex case in an escape) the loaded state is the original save's.
law save_rejects_damaged_files {
    forall (mode: elements(["flip", "truncate", "checksum", "format", "empty"]), at: int(0, 100000), bit: int(0, 63), seed: int(1, 100))
    => let r = xvCorrupt({mode: mode, at: at, bit: bit, seed: seed}) in
       r.saved and ((not r.ok and r.unchanged) or (r.ok and r.acceptedIsOriginal))
}

law save_rejects_unknown_versions {
    forall (version: elements(["0", "2", "99", "-1", "\"x\""]), seed: int(1, 100))
    => let r = xvCorrupt({mode: "version", version: version, seed: seed}) in not r.ok and r.unchanged
}

# A body rejected half way through apply() leaves the session exactly as it was.
law save_failed_apply_rolls_back {
    forall (mode: elements(["seed", "state", "sections", "stream", "storylets", "notObject"]))
    => let r = xvBadApply({mode: mode}) in not r.ok and r.unchanged
}

# Saving twice leaves slot + backup (the backup is the previous save), no temporary files, and the serial counts the saves.
law save_files_are_atomic_and_backed_up {
    forall (seed: int(1, 100))
    => let r = xvFiles({seed: seed}) in r.tmp == 0 and r.backupIsFirst and r.differs and r.asyncOk and r.asyncSameBody and r.serial == 2
}
