include "../lib/ext_phys.bent"

gen obstacle = {center: vec3(float(-9, 9), 1, float(-9, 9)), half: vec3(float(0.3, 3), 1, float(0.3, 3))}
gen floorPt = vec3(float(-10, 10), 0, float(-10, 10))
gen navSpec = {half: 12.0, cell: elements([0.5, 1.0]), radius: float(0, 0.6), obstacles: listOf(obstacle, 0, 6)}
fn pathOp(a, b) = {op: "path", from: a, to: b}
fn nav1(spec, op) = head(navEval(spec, [op]))
fn pathPairs(points) = zip(points, drop(points, 1))
fn cellCentre(p, cell) = vec3(toFloat(floor((p.x + 12.0) / cell)) * cell - 12.0 + cell * 0.5, 0, toFloat(floor((p.z + 12.0) / cell)) * cell - 12.0 + cell * 0.5)
fn clearOfObstacles(spec, p) = all(spec.obstacles, fn(o) => abs(p.x - o.center.x) > o.half.x + 1.5 * spec.cell or abs(p.z - o.center.z) > o.half.z + 1.5 * spec.cell)
fn walkable(spec, p) = head(navEval(spec, [{op: "walkable", p: p}]))
fn gridDist(a, b) = distance(flat3(a), flat3(b))

law nav_path_is_walkable_and_consistent {
    forall (spec: navSpec, a0: floorPt, b0: floorPt)
    where walkable(spec, cellCentre(a0, spec.cell)) and walkable(spec, cellCentre(b0, spec.cell))
    => let a = cellCentre(a0, spec.cell) in
       let b = cellCentre(b0, spec.cell) in
       let p = nav1(spec, pathOp(a, b)) in
       not p.found or (
           len(p.points) >= 1
           and (forall q in p.points: head(navEval(spec, [{op: "walkable", p: q}])))
           and (forall s in pathPairs(p.points): head(navEval(spec, [{op: "line", a: s[0], b: s[1]}])))
           and abs(p.length - sumBy(pathPairs(p.points), fn(s) => gridDist(s[0], s[1]))) < 1e-2)
}

law nav_complete_path_endpoints_and_length {
    forall (spec: navSpec, a: floorPt, b: floorPt)
    => let r = navEval(spec, [pathOp(a, b), {op: "walkable", p: a}, {op: "walkable", p: b}]) in
       let p = r[0] in
       not (p.found and not p.partial and r[1] and r[2]) or (
           gridDist(head(p.points), a) <= 1.5 * spec.cell + 1e-3
           and gridDist(last(p.points), b) <= 1.5 * spec.cell + 1e-3
           and p.length >= gridDist(a, b) - 3.0 * spec.cell)
}

law nav_grid_cost_monotone_in_obstacles {
    forall (spec: navSpec, extra: obstacle, a0: floorPt, b0: floorPt)
    where walkable(spec, cellCentre(a0, spec.cell)) and walkable(with(spec, obstacles: spec.obstacles ++ [extra]), cellCentre(a0, spec.cell)) and walkable(spec, cellCentre(b0, spec.cell)) and walkable(with(spec, obstacles: spec.obstacles ++ [extra]), cellCentre(b0, spec.cell))
    => let a = cellCentre(a0, spec.cell) in
       let b = cellCentre(b0, spec.cell) in
       let before = nav1(spec, pathOp(a, b)) in
       let more = nav1(with(spec, obstacles: spec.obstacles ++ [extra]), pathOp(a, b)) in
       not (before.found and more.found and not before.partial and not more.partial) or more.gridCost >= before.gridCost - 1e-3
}

law nav_reachability_symmetric {
    forall (spec: navSpec, a0: floorPt, b0: floorPt)
    => let a = cellCentre(a0, spec.cell) in
       let b = cellCentre(b0, spec.cell) in
       let r = navEval(spec, [pathOp(a, b), pathOp(b, a), {op: "walkable", p: a}, {op: "walkable", p: b}]) in
       let ab = r[0].found and not r[0].partial in
       let ba = r[1].found and not r[1].partial in
       not (r[2] and r[3]) or (ab == ba and (not ab or abs(r[0].gridCost - r[1].gridCost) < 1e-2 * (1.0 + r[0].gridCost)))
}

law nav_incremental_rebuild_equals_fresh {
    forall (spec: navSpec, extras: listOf(obstacle, 1, 4), a: floorPt, b: floorPt)
    => let empty = with(spec, obstacles: []) in
       let inc = navEval(empty, flatten(map(extras, fn(o) => [{op: "addObs", center: o.center, half: o.half}, {op: "rebuild"}])) ++ [{op: "hash"}, pathOp(a, b)]) in
       let fresh = navEval(with(spec, obstacles: extras), [{op: "hash"}, pathOp(a, b)]) in
       inc[len(inc) - 2] == fresh[0] and inc[len(inc) - 1].found == fresh[1].found and inc[len(inc) - 1].gridCost ~= fresh[1].gridCost within 1e-4
}

law nav_remove_obstacle_restores_mesh {
    forall (spec: navSpec, extra: obstacle, moved: obstacle)
    => let base = head(navEval(spec, [{op: "hash"}])) in
       let removed = navEval(spec, [{op: "addObs", center: extra.center, half: extra.half}, {op: "rebuild"}, {op: "removeObs", id: len(spec.obstacles)}, {op: "rebuild"}, {op: "hash"}]) in
       let movedAway = navEval(spec, [{op: "addObs", center: extra.center, half: extra.half}, {op: "rebuild"},
                                       {op: "moveObs", id: len(spec.obstacles), center: moved.center, half: moved.half}, {op: "rebuild"}, {op: "hash"}]) in
       let direct = head(navEval(with(spec, obstacles: spec.obstacles ++ [moved]), [{op: "hash"}])) in
       last(removed) == base and last(movedAway) == direct
}

law nav_obstacles_block_and_open_floor_walks {
    forall (spec: navSpec, o: obstacle, u: float(-0.6, 0.6), v: float(-0.6, 0.6))
    where o.half.x > 1.0 and o.half.z > 1.0
    => let inside = o.center + vec3(u * o.half.x, -1, v * o.half.z) in
       let r = navEval(with(spec, obstacles: [o]), [{op: "walkable", p: inside}, {op: "walkable", p: o.center + vec3(o.half.x + 3.5, -1, 0)}]) in
       not r[0] and (abs(o.center.x + o.half.x + 3.5) > 11 or r[1])
}

law nav_open_floor_path_is_straight {
    forall (cell: elements([0.5, 1.0]), radius: float(0, 0.5), a: floorPt, b: floorPt)
    => let p = nav1({half: 12.0, cell: cell, radius: radius, obstacles: []}, pathOp(a, b)) in
       p.found and not p.partial and p.length <= gridDist(a, b) + 2.0 * cell + 1e-3 and p.length >= gridDist(a, b) - 2.0 * cell
}

law nav_link_reconnects_separated_regions {
    forall (x: float(-8, 8), za: float(-9, -4), zb: float(4, 9), lx: float(-8, 8))
    => let wall = {center: vec3(0, 1, 0), half: vec3(12.0, 1, 0.6)} in
       let base = {half: 12.0, cell: 0.5, radius: 0.0, obstacles: [wall]} in
       let a = vec3(x, 0, za) in
       let b = vec3(x, 0, zb) in
       let blocked = nav1(base, pathOp(a, b)) in
       let linked = nav1(with(base, links: [{a: vec3(lx, 0, -2), b: vec3(lx, 0, 2), radius: 0.6}]), pathOp(a, b)) in
       (not blocked.found or blocked.partial) and linked.found and not linked.partial and exists l in linked.links: l >= 0
}

gen agentSpec = {pos: vec3(float(-8, 8), 0, float(-8, 8)), target: vec3(float(-8, 8), 0, float(-8, 8)), radius: float(0.25, 0.5), maxSpeed: float(1.5, 4)}
fn overlapOf(f, i, j, r) = max(0.0, r[i] + r[j] - gridDist(f[i].pos, f[j].pos))
fn maxOverlap(frame, radii) = maxOf(flatten(map(range(len(frame)), fn(i) => map(range(i + 1, len(frame)), fn(j) => overlapOf(frame, i, j, radii)))))
fn separated(agents) = all(enumerate(agents), fn(e) => all(drop(agents, e[0] + 1), fn(o) => gridDist(e[1].pos, o.pos) > 1.2))
fn targetsApart(agents) = all(enumerate(agents), fn(e) => all(enumerate(agents), fn(o) => e[0] == o[0] or (gridDist(e[1].target, o[1].target) > 1.3 and gridDist(e[1].target, o[1].pos) > 1.3)))
fn openNav() = {half: 12.0, cell: 0.5, radius: 0.4, obstacles: []}

fn minGap(frame, radii) = minOf(flatten(map(range(len(frame)), fn(i) => map(range(i + 1, len(frame)), fn(j) => gridDist(frame[i].pos, frame[j].pos) / (radii[i] + radii[j])))))
law nav_crowd_agents_never_pass_through_each_other {
    forall (agents: listOf(agentSpec, 2, 8), crowd: bool())
    where separated(agents) and targetsApart(agents)
    => let radii = map(agents, fn(a) => a.radius) in
       let r = navCrowd(openNav(), agents, {steps: 300, record: 10, crowd: crowd}) in
       forall f in r.frames: minGap(f, radii) >= 0.35
}

law nav_crowd_overlap_is_small {
    forall (agents: listOf(agentSpec, 2, 8), crowd: bool())
    where separated(agents) and targetsApart(agents)
    => let radii = map(agents, fn(a) => a.radius) in
       let r = navCrowd(openNav(), agents, {steps: 300, record: 10, crowd: crowd}) in
       forall f in r.frames: maxOverlap(f, radii) <= 0.12
}

law nav_agent_reaches_goal_on_open_ground {
    forall (a: agentSpec, crowd: bool())
    where gridDist(a.pos, a.target) > 1.0
    => let steps = 90 + toInt(gridDist(a.pos, a.target) / a.maxSpeed * 60.0 * 1.6) in
       let r = navCrowd(openNav(), [a], {steps: steps, record: steps, crowd: crowd}) in
       let end = last(r.frames)[0] in
       gridDist(end.pos, a.target) < 1.1 and end.state == "arrived"
}

law nav_agents_stay_on_mesh {
    forall (spec: navSpec, agents: listOf(agentSpec, 1, 4))
    where all(agents, fn(a) => gridDist(a.pos, a.target) > 0.5)
    => let walk = fn(p) => head(navEval(spec, [{op: "walkable", p: p}])) in
       let start = filter(agents, fn(a) => walk(a.pos) and walk(a.target)) in
       len(start) == 0 or (
           let r = navCrowd(spec, start, {steps: 240, record: 20, crowd: false}) in
           forall f in drop(r.frames, 1): forall x in f: abs(x.pos.x) < 12.5 and abs(x.pos.z) < 12.5 and isFinite(x.pos.x) and isFinite(x.pos.z))
}

law nav_crowd_is_deterministic {
    forall (agents: listOf(agentSpec, 1, 6), crowd: bool())
    => navCrowd(openNav(), agents, {steps: 120, record: 30, crowd: crowd}) == navCrowd(openNav(), agents, {steps: 120, record: 30, crowd: crowd})
}
