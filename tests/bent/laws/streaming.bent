include "../lib/prelude.bent"

gen gridSetup = streaming(cell: float(20, 120), nx: int(2, 8), nz: int(2, 8), load: float(20, 250), keep: float(0, 120), perCell: int(1, 3))
gen campos = vec3(float(-150, 900), float(0, 5), float(-150, 900))

fn grid(s) = streaming(cell: s.cell, nx: s.nx, nz: s.nz, load: s.load, keep: s.load + s.keep, perCell: s.perCell)
fn route(path) = flatten(map(path, fn(p) => [camera(pos: p), step(n: 2)]))

law streaming_loads_within_radius {
    forall (s: gridSetup, path: listOf(campos, 1, 5))
    => eventually within 30 after([grid(s)] ++ route(path)) {
        forall c in range(cellCount()): cellDistance(c) < loadRadius() - 0.5 ==> resident(c)
    }
}

law streaming_evicts_beyond_keep {
    forall (s: gridSetup, path: listOf(campos, 1, 5))
    => eventually within 30 after([grid(s)] ++ route(path)) {
        forall c in range(cellCount()): cellDistance(c) > keepRadius() + 0.5 ==> not resident(c)
    }
}

law streaming_entities_match_cells {
    forall (s: gridSetup, path: listOf(campos, 1, 5))
    => after([grid(s)] ++ route(path) ++ [step(n: 30)]) { entityCount() == len(residentCells()) * s.perCell and streamStats().pending == 0 }
}

law streaming_survives_rebase {
    forall (s: gridSetup, path: listOf(campos, 1, 4), d: vec3(float(-3000, 3000), 0, float(-3000, 3000)))
    => eventually within 30 after([grid(s)] ++ route(path) ++ [rebase(delta: d)] ++ route(map(path, fn(p) => p - d))) {
        (forall c in range(cellCount()): cellDistance(c) < loadRadius() - 0.5 ==> resident(c))
        and (forall c in range(cellCount()): cellDistance(c) > keepRadius() + 0.5 ==> not resident(c))
    }
}

gen terrainCam = vec3(float(-3000, 3000), float(20, 200), float(-3000, 3000))
law terrain_budget_respected {
    forall (path: listOf(terrainCam, 1, 4), view: float(100, 1200), level: int(0, 4))
    => always after([terrain(tileSize: 64, cells: 8, maxLevel: level, view: view)] ++ route(path)) {
        terrainStats().resident <= terrainStats().maxResident
    }
}

law terrain_settles {
    forall (path: listOf(terrainCam, 1, 3), view: float(100, 800))
    => eventually within 200 after([terrain(tileSize: 64, cells: 8, maxLevel: 3, view: view)] ++ route(path)) { terrainStats().settled }
}
