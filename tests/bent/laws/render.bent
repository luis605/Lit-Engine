include "../lib/prelude.bent"

gen settingValue = oneof(float(-10, 10), int(-5, 5), bool(), elements([0, 1, 2, 3, 4]), float(-100000, 100000))

fn settingKey(i) = let names = after([]) { renderSettingNames() } in names[i % len(names)]

law render_setting_fixpoint {
    forall (i: int(0, 100000), v: settingValue)
    => let key = settingKey(i) in
       let once = after([render(key: key, value: v)]) { renderSetting(key) } in
       after([render(key: key, value: v), render(key: key, value: once)]) { renderSetting(key) } == once
}

law render_setting_rejects_nonfinite {
    forall (i: int(0, 100000), v: elements(["nan", "inf", "-inf", "1e999", "-1e999"]))
    => let key = settingKey(i) in
       after([render(key: key, value: v)]) { let text = renderSetting(key) in not contains(text, "nan") and not contains(text, "inf") }
}

law render_setting_isolated {
    forall (i: int(0, 100000), v: settingValue)
    => let key = settingKey(i) in
       let names = after([]) { renderSettingNames() } in
       let before = after([]) { map(names, renderSetting) } in
       after([render(key: key, value: v)]) {
           all(zip(names, zip(before, map(names, renderSetting))), fn(t) => t[0] == key or t[1][0] == t[1][1])
       }
}
