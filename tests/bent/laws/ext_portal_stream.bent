include "../lib/ext_portal.bent"

gen xrConfig = {hopMetres: float(10, 100), minSpeed: float(1, 10), outOfViewSeconds: float(0, 5), residentBias: float(0.3, 1), kindBias: listOf(float(0, 2), 5, 5)}
gen xrDemand = {kind: int(0, 4), distance: float(0, 500), radius: float(0, 100), hops: int(0, 10), inView: bool(), resident: bool(), direction: unitVec3(), space: int(0, 1)}
gen xrVel = vec3(float(-30, 30), float(-30, 30), float(-30, 30))

law residency_score_monotone_in_distance {
    forall (c: xrConfig, d: xrDemand, extra: float(0, 400), v: xrVel)
    => xrScore(c, d, v) <= xrScore(c, with(d, distance: d.distance + extra), v) + 1e-5
}

law residency_score_monotone_in_hops {
    forall (c: xrConfig, d: xrDemand, extra: int(0, 20), v: xrVel)
    => xrScore(c, d, v) <= xrScore(c, with(d, hops: d.hops + extra), v) + 1e-5
}

law residency_score_out_of_view_and_resident_bias {
    forall (c: xrConfig, d: xrDemand, v: xrVel)
    => xrScore(c, with(d, inView: false), v) >= xrScore(c, with(d, inView: true), v) - 1e-5
       and xrScore(c, with(d, resident: true), v) <= xrScore(c, with(d, resident: false), v) + 1e-5
}

law residency_score_at_rest_is_distance_over_min_speed {
    forall (c: xrConfig, d: xrDemand)
    => let det = with(c, deterministic: true) in
       let dem = with(d, inView: true, resident: false) in
       let seconds = (dem.distance + c.hopMetres * dem.hops) / max(c.minSpeed, 0.01) + c.kindBias[dem.kind] in
       let tie = 0.001 * dem.radius / (dem.distance + dem.radius + 1) in
       abs(xrScore(det, dem, vec3(0, 0, 0)) - (seconds - tie)) < 1e-3 * (1 + abs(seconds))
}

law residency_score_velocity_rules {
    forall (c: xrConfig, d: xrDemand, v: xrVel)
    => let ahead = with(d, direction: normalize(v + vec3(0.001, 0, 0))) in
       xrScore(c, ahead, v) <= xrScore(c, ahead, vec3(0, 0, 0)) + 1e-5
       and xrScore(with(c, deterministic: true), d, v) == xrScore(with(c, deterministic: true), d, vec3(0, 0, 0))
}

law residency_score_clamps_negative_distance {
    forall (c: xrConfig, d: xrDemand, v: xrVel, neg: float(-100, 0))
    => abs(xrScore(c, with(d, distance: neg), v) - xrScore(c, with(d, distance: 0), v)) < 1e-6
}

law residency_score_is_kind_blind_without_bias {
    forall (c: xrConfig, d: xrDemand, k: int(0, 4), v: xrVel)
    => xrScore(with(c, kindBias: [0, 0, 0, 0, 0]), d, v) == xrScore(with(c, kindBias: [0, 0, 0, 0, 0]), with(d, kind: k), v)
}

law residency_pool_priority_is_monotone_and_clamped {
    forall (a: float(-1e9, 1e9), b: float(-1e9, 1e9))
    => (a <= b ==> xrPoolPriority(a) <= xrPoolPriority(b)) and abs(xrPoolPriority(a)) <= 100000000
}

gen xrItem = {kind: int(0, 4), bytes: int(0, 5000), score: float(0, 100), protected: bool(), evictable: frequency([[5, just(true)], [1, just(false)]]), immediate: bool(), refuses: frequency([[8, just(false)], [1, just(true)]])}
gen xrItems = bind(int(0, 14), fn(n) => listOf(xrItem, n, n))
fn xrIndexed(items) = map(enumerate(items), fn(p) => with(p[1], id: p[0]))

law residency_byte_budget_holds_after_enforce {
    forall (items: xrItems, budget: int(1, 20000))
    => let its = xrIndexed(items) in
       let r = xrEvict({byteBudget: budget}, its) in
       let removable = fn(i) => i.evictable and not i.protected and not i.refuses and not contains(r.evicted, i.id) in
       (r.after <= budget or not exists i in its: removable(i))
}

law residency_never_evicts_protected_or_pinned_and_idles_under_budget {
    forall (items: xrItems, budget: int(1, 20000))
    => let its = xrIndexed(items) in
       let r = xrEvict({byteBudget: budget}, its) in
       (forall id in r.calls: not its[id].protected and its[id].evictable)
       and (r.before <= budget ==> len(r.calls) == 0 and r.requested == 0)
       and xrEvict({byteBudget: 0}, its).requested == 0
}

law residency_eviction_follows_the_metric_order {
    forall (items: xrItems, budget: int(1, 20000))
    => let its = xrIndexed(items) in
       let r = xrEvict({byteBudget: budget}, its) in
       let candidates = filter(its, fn(i) => i.evictable and not i.protected) in
       let order = sortBy(candidates, fn(i) => [0 - i.score, i.kind, i.id]) in
       let expected = take(order, len(r.calls)) in
       r.calls == map(expected, fn(i) => i.id)
}

law residency_enforce_is_idempotent {
    forall (items: xrItems, budget: int(1, 20000))
    => xrEvict({byteBudget: budget}, xrIndexed(items)).again == 0
}

law residency_eviction_stops_at_the_first_fit {
    forall (items: xrItems, budget: int(1, 20000))
    => let its = xrIndexed(items) in
       let r = xrEvict({byteBudget: budget}, its) in
       len(r.evicted) == 0 or r.before - sum(map(take(r.evicted, len(r.evicted) - 1), fn(id) => its[id].bytes)) > budget
}

gen xrTask = {kind: int(0, 4), score: float(-5, 50), cost: int(0, 3000)}

law residency_flush_order_and_budget {
    forall (tasks: listOf(xrTask, 0, 12), budget: int(0, 6000))
    => let r = xrFlush({bytes: budget}, tasks) in
       let sorted = map(sortBy(enumerate(tasks), fn(p) => [p[1].score, p[0]]), fn(p) => p[0]) in
       r.order == take(sorted, len(r.order))
       and (len(tasks) == 0 or len(r.order) >= 1)
       and (forall k in range(1, len(r.order)): r.spentBefore[k] < budget)
       and r.ran == len(r.order)
       and r.deferred == len(tasks) - len(r.order)
       and (len(r.order) == len(tasks) or r.spent >= budget)
}

law residency_flush_unlimited_runs_everything {
    forall (tasks: listOf(xrTask, 0, 12))
    => let r = xrFlush({bytes: 1, unlimited: true}, tasks) in r.ran == len(tasks) and r.deferred == 0
}

gen xrJob = {priority: int(-50, 50), cancel: frequency([[3, just(false)], [1, just(true)]])}

law residency_jobs_run_once_in_priority_order {
    forall (jobs: listOf(xrJob, 0, 16))
    => let ran = xrJobs(jobs) in
       let ids = map(ran, fn(r) => r.id) in
       let expected = map(sortBy(enumerate(jobs), fn(p) => [p[1].priority, p[0]]), fn(p) => p[0]) in
       ids == expected and (forall r in ran: r.cancelled == jobs[r.id].cancel)
}

gen xsPos = vec3(float(-60, 400), 0, float(-60, 400))
gen xsGrid = {nx: int(2, 6), nz: int(2, 6), cell: float(30, 100), load: float(10, 150), keep: float(0, 120), moveThreshold: just(0)}
fn xsSpec(g) = with(g, keep: g.load + g.keep + 1)

fn xsCellDistance(g, c, p) =
    let x = c / g.nz in
    let z = c % g.nz in
    let dx = max([x * g.cell - p.x, 0, p.x - (x + 1) * g.cell]) in
    let dz = max([z * g.cell - p.z, 0, p.z - (z + 1) * g.cell]) in
    sqrt(dx * dx + dz * dz)
fn xsCameraCell(g, p) =
    let inside = filter(range(g.nx * g.nz), fn(c) => xsCellDistance(g, c, p) == 0 and p.y >= -100 and p.y <= 1000) in
    if len(inside) == 0 then 0 else inside[0]

law streaming_system_settles_to_the_radii {
    forall (g: xsGrid, path: listOf(xsPos, 1, 5), workers: int(1, 3))
    => let spec = with(xsSpec(g), path: path, workers: workers) in
       let r = xsRun(spec) in
       let last = path[len(path) - 1] in
       r.settled and r.pendingCells == 0
       and (forall c in range(g.nx * g.nz): xsCellDistance(g, c, last) < spec.load - 0.01 ==> contains(r.finalResident, c))
       and (forall c in range(g.nx * g.nz): xsCellDistance(g, c, last) > spec.keep + 0.01 and c != xsCameraCell(g, last) ==> not contains(r.finalResident, c))
       and contains(r.finalResident, xsCameraCell(g, last))
}

law streaming_system_is_deterministic_across_worker_counts {
    forall (g: xsGrid, path: listOf(xsPos, 1, 6))
    => let spec = with(xsSpec(g), path: path) in
       let one = xsRun(with(spec, workers: 1)) in
       let four = xsRun(with(spec, workers: 4)) in
       one.residentPerStep == four.residentPerStep and one.events == four.events and one.loaded == four.loaded and one.unloaded == four.unloaded
}

law streaming_prime_loads_everything_wanted {
    forall (g: xsGrid, p: xsPos)
    => let spec = with(xsSpec(g), path: [p], prime: true) in
       let r = xsRun(spec) in
       r.prime and r.settled and (forall c in range(g.nx * g.nz): xsCellDistance(g, c, p) < spec.load - 0.01 ==> contains(r.finalResident, c))
}

law streaming_boundary_jitter_does_not_thrash {
    forall (g: xsGrid, fx: float(0, 1), fz: float(0, 1), dir: unitVec3(), amp: float(0.5, 5), n: int(2, 8))
    where abs(dir.x) + abs(dir.z) > 0.1
    => let base = vec3(6 + fx * (g.nx * g.cell - 12), 0, 6 + fz * (g.nz * g.cell - 12)) in
       let spec = with(xsSpec(g), keep: g.load + 2 * amp + 10, path: map(range(n), fn(i) => base + normalize(vec3(dir.x, 0, dir.z)) * (if i % 2 == 0 then amp else 0 - amp))) in
       let r = xsRun(spec) in
       r.unloaded == 0 and r.cancelled == 0
       and (forall c in range(g.nx * g.nz): count(r.events, fn(e) => e.kind == "commit" and e.cell == c) <= 1)
}

law streaming_lifecycle_is_well_formed_under_cancellation {
    forall (g: xsGrid, path: listOf(xsPos, 2, 8))
    => let spec = with(xsSpec(g), path: path, deterministic: false, workers: 2, prepareMicros: 400, settle: 2) in
       let r = xsRun(spec) in
       let n = g.nx * g.nz in
       let log = fn(c) => map(filter(r.events, fn(e) => e.cell == c and e.kind != "evicting"), fn(e) => e.kind) in
       (forall c in range(n): let l = log(c) in
            (forall k in range(len(l)): l[k] == (if k % 2 == 0 then "commit" else "unload"))
            and (contains(r.finalResident, c) == (len(l) % 2 == 1)))
       and sum(r.prepares) + r.jobsCancelled == count(r.events, fn(e) => e.kind == "commit") + r.cancelled
       and r.loaded == count(r.events, fn(e) => e.kind == "commit")
}

law streaming_frame_upload_budget_is_respected {
    forall (g: xsGrid, path: listOf(xsPos, 2, 6), budget: int(1000, 6000), bytes: int(500, 2500))
    => let spec = with(xsSpec(g), path: path, deterministic: false, workers: 2, uploadBytes: budget, cellBytes: bytes, settle: 3) in
       let r = xsRun(spec) in
       forall b in r.bytesPerStep: b <= budget + bytes
}

law streaming_byte_budget_evicts_unwanted_cells {
    forall (g: xsGrid, path: listOf(xsPos, 1, 5), budget: int(1, 12000), bytes: int(500, 2500))
    => let settle = [path[len(path) - 1], path[len(path) - 1], path[len(path) - 1]] in
       let spec = with(xsSpec(g), path: path ++ settle, byteBudget: budget, cellBytes: bytes) in
       let r = xsRun(spec) in
       r.residentBytes <= budget or (forall c in r.finalResident: r.wanted[c])
}

gen xsLodRadii = bind(int(1, 3), fn(n) => map(listOf(float(5, 60), n, n), fn(x) => x))
law streaming_lod_band_matches_distance {
    forall (g: xsGrid, p: xsPos, radii: xsLodRadii)
    => let sorted = sort(radii) in
       let spec = with(xsSpec(g), path: [p], useLod: true, lodRadii: sorted, load: g.load + 100, keep: g.load + 300) in
       let r = xsRun(spec) in
       forall c in r.finalResident: (c == xsCameraCell(g, p)) or r.lods[c] == count(sorted, fn(x) => x < xsCellDistance(g, c, p)) or xsCellDistance(g, c, p) == 0
}

law streaming_lod_does_not_flap_inside_the_hysteresis {
    forall (g: xsGrid, ix: int(0, 5), iz: int(0, 5), fx: float(0.2, 0.8), fz: float(0.2, 0.8), radii: xsLodRadii, amp: float(0.5, 4), n: int(2, 8))
    where amp < 0.2 * g.cell
    => let base = vec3(((ix % g.nx) + fx) * g.cell, 0, ((iz % g.nz) + fz) * g.cell) in
       let sorted = sort(radii) in
       let path = map(range(n), fn(i) => base + vec3(if i % 2 == 0 then amp else 0 - amp, 0, 0)) in
       let spec = with(xsSpec(g), path: path, useLod: true, lodRadii: sorted, lodHysteresis: 10, load: g.load + 100, keep: g.load + 300) in
       let r = xsRun(spec) in
       r.lodReloads == 0
}

fn xsNeighbours(pairs, c) = flatten(map(pairs, fn(p) => (if p.cellA == c then [p.cellB] else []) ++ (if p.cellB == c then [p.cellA] else [])))
fn xsBfs(n, pairs, from) =
    let start = map(range(n), fn(c) => if c == from then 0 else -1) in
    fold(range(n), start, fn(d, round) =>
        map(range(n), fn(c) =>
            if d[c] >= 0 then d[c]
            else let ns = filter(map(xsNeighbours(pairs, c), fn(m) => d[m]), fn(x) => x >= 0) in
                 if len(ns) == 0 then -1 else min(ns) + 1))

law streaming_graph_distances_are_bfs {
    forall (n: int(1, 8), raw: listOf({cellA: int(0, 7), cellB: int(0, 7)}, 0, 12), from: int(0, 7))
    => let pairs = map(raw, fn(p) => {cellA: p.cellA % n, cellB: p.cellB % n}) in
       xsGraph(n, pairs, from % n) == xsBfs(n, pairs, from % n)
}
