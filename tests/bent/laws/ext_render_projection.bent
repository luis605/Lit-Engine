include "../lib/render.bent"

gen camSpec = {pos: vec3(float(-20, 20), float(-20, 20), float(-20, 20)), yaw: float(-180, 180), pitch: float(-80, 80), roll: float(-25, 25),
               fov: float(20, 110), w: float(1, 32), h: float(1, 32), near: float(0.05, 2), far: float(50, 5000)}

fn tanHalf(s) = sin(radians(s.fov / 2)) / cos(radians(s.fov / 2))
fn aspect(s) = s.w / s.h
fn basisOf(s) = rxCamProject(with(s, point: s.pos))
fn pointAt(s, d, fx, fy) =
    let b = basisOf(s) in
    s.pos + b.front * d + b.right * (fx * d * tanHalf(s) * aspect(s)) + b.up * (fy * d * tanHalf(s))
fn project(s, d, fx, fy) = rxCamProject(with(s, point: pointAt(s, d, fx, fy)))
fn idealDepth(s, d) = s.near * (s.far - d) / ((s.far - s.near) * d)

law projection_view_is_rigid {
    forall (s: camSpec)
    => let b = basisOf(s) in
       abs(length(b.front) - 1) < 1e-4 and abs(length(b.right) - 1) < 1e-4 and abs(length(b.up) - 1) < 1e-4
       and abs(dot(b.front, b.right)) < 1e-4 and abs(dot(b.front, b.up)) < 1e-4 and abs(dot(b.right, b.up)) < 1e-4
       and abs(b.viewDet - 1) < 1e-4 and distance(cross(b.right, b.up), b.front * -1) < 1e-4
}

law projection_reversed_z_endpoints {
    forall (s: camSpec, fx: float(-0.5, 0.5), fy: float(-0.5, 0.5))
    => project(s, s.near, fx, fy).ndc.z ~= 1.0 within 0.01 and project(s, s.far, fx, fy).ndc.z ~= 0.0 within 0.01
}

law projection_depth_formula {
    forall (s: camSpec, d: float(0.1, 1.0), fx: float(-0.9, 0.9), fy: float(-0.9, 0.9), t: float(0, 1))
    => let depth = s.near + (s.far - s.near) * (if d < 0.5 then d * d * 0.02 else d * d) * t in
       let p = project(s, depth, fx, fy) in
       p.viewDepth ~= depth within 1e-3 and p.ndc.z ~= idealDepth(s, depth) within 0.005
}

law projection_depth_monotone {
    forall (s: camSpec, d1: float(0, 1), grow: float(1.3, 4), fx: float(-0.9, 0.9), fy: float(-0.9, 0.9))
    => let a = s.near * (1 + d1 * 20) in
       let b = min(a * grow, s.far) in
       b > a * 1.2 ==> project(s, a, fx, fy).ndc.z > project(s, b, fx, fy).ndc.z
}

law projection_reversed_z_resolves_far_depth {
    forall (s: camSpec, near: float(0.05, 0.5), ratio: float(1e4, 2e5), at: float(0.1, 0.8), fx: float(-0.5, 0.5), fy: float(-0.5, 0.5))
    => let s2 = with(s, near: near, far: near * ratio) in
       let d = s2.far * at in
       project(s2, d, fx, fy).ndc.z > project(s2, d * 1.02, fx, fy).ndc.z
}

law projection_pinhole_xy {
    forall (s: camSpec, d: float(0.2, 1), fx: float(-1.4, 1.4), fy: float(-1.4, 1.4))
    => let depth = s.near + (s.far - s.near) * d * d * 0.1 in
       let p = project(s, depth, fx, fy) in
       p.ndc.x ~= fx within 2e-3 and p.ndc.y ~= fy within 2e-3
}

law projection_frustum_containment {
    forall (s: camSpec, d: float(0.01, 1.2), fx: float(-1.6, 1.6), fy: float(-1.6, 1.6))
    => let depth = s.far * d in
       let margin = 0.01 in
       let analytic = depth >= s.near and depth <= s.far and abs(fx) <= 1 and abs(fy) <= 1 in
       let nearBoundary = abs(depth - s.near) < margin * s.near or abs(depth - s.far) < margin * s.far or abs(abs(fx) - 1) < margin or abs(abs(fy) - 1) < margin in
       let p = project(s, depth, fx, fy) in
       let inClip = p.clip.w > 0 and abs(p.ndc.x) <= 1 and abs(p.ndc.y) <= 1 and p.ndc.z >= 0 and p.ndc.z <= 1 in
       cover("inside the frustum", inClip) and cover("outside the frustum", not inClip) and (nearBoundary or inClip == analytic)
}

law projection_behind_camera_rejected {
    forall (s: camSpec, d: float(0.05, 100), fx: float(-1, 1), fy: float(-1, 1))
    => let p = project(s, 0 - d, fx, fy) in
       p.clip.w < 0 and p.viewDepth < 0 and not (p.clip.w > 0)
}

law projection_aspect_only_scales_x {
    forall (s: camSpec, w2: float(1, 32), d: float(0.1, 1), fx: float(-0.8, 0.8), fy: float(-0.8, 0.8))
    => let depth = s.near + (s.far - s.near) * d * d * 0.2 in
       let pt = pointAt(s, depth, fx, fy) in
       let a = rxCamProject(with(s, point: pt)) in
       let b = rxCamProject(with(with(s, w: w2), point: pt)) in
       b.ndc.y ~= a.ndc.y within 1e-3 and b.ndc.x * w2 ~= a.ndc.x * s.w within 2e-3
}

law projection_narrow_fov_magnifies {
    forall (s: camSpec, f2: float(0.3, 0.9), d: float(0.1, 1), fy: float(0.2, 0.7))
    => let depth = s.near + (s.far - s.near) * d * d * 0.2 in
       let pt = pointAt(s, depth, 0, fy) in
       let narrow = with(s, fov: s.fov * f2) in
       abs(rxCamProject(with(narrow, point: pt)).ndc.y) > abs(rxCamProject(with(s, point: pt)).ndc.y)
}

law projection_translation_invariant {
    forall (s: camSpec, shift: vec3(float(-30, 30), float(-30, 30), float(-30, 30)), d: float(0.1, 1), fx: float(-1, 1), fy: float(-1, 1))
    => let depth = s.near + (s.far - s.near) * d * d * 0.1 in
       let pt = pointAt(s, depth, fx, fy) in
       let a = rxCamProject(with(s, point: pt)) in
       let b = rxCamProject(with(with(s, pos: s.pos + shift), point: pt + shift)) in
       b.ndc ~= a.ndc within 5e-3
}

law projection_orthographic {
    forall (s: camSpec, hh: float(1, 50), d: float(0, 1), ox: float(-20, 20), oy: float(-20, 20))
    => let so = with(with(s, ortho: true), orthoHeight: hh) in
       let b = basisOf(so) in
       let depth = so.near + (so.far - so.near) * d in
       let pt = so.pos + b.front * depth + b.right * ox + b.up * oy in
       let p = rxCamProject(with(so, point: pt)) in
       p.clip.w ~= 1.0 within 1e-4 and p.ndc.z ~= (so.far - depth) / (so.far - so.near) within 0.005
       and p.ndc.y ~= oy / (hh / 2) within 1e-2 and p.ndc.x ~= ox / (hh / 2 * aspect(so)) within 1e-2
}

law projection_always_finite {
    forall (s: camSpec, pt: vec3(float(-1e4, 1e4), float(-1e4, 1e4), float(-1e4, 1e4)))
    => let p = rxCamProject(with(s, point: pt)) in
       isFinite(p.clip.x) and isFinite(p.clip.y) and isFinite(p.clip.z) and isFinite(p.clip.w) and isFinite(p.viewDepth)
}
