# Portal physics: rigid bodies carry velocity and spin through portals, tracked bodies get a ghost twin on the far side, and sweeps and
# rays through (tilted, rolled, twisted) portals equal the same query in the unfolded world.
include "../lib/ext_phys.bent"

fn frames(pair) = pxPortalFrames([pair])
fn farApart(pair) = distance(pair.a, pair.b) > 8

# A tracked sphere thrown through a portal (no gravity) keeps its speed, its linear velocity is the portal rotation of the original and
# so is its spin; afterwards it is on the exit side.
law px_portal_carries_velocity_and_spin {
    forall (pair: pxPair, u: float(-0.4, 0.4), v: float(-0.4, 0.4), speed: float(3, 12), ang: vec3(float(-5, 5), float(-5, 5), float(-5, 5)), r: float(0.15, 0.4))
    where farApart(pair)
    => let f = frames(pair) in
       let fa = f[0] in
       let fb = f[1] in
       let start = fa.center + fa.normal * 3.0 + fa.right * (u * fa.half.x) + fa.up * (v * fa.half.y) in
       let vel = fa.normal * (0.0 - speed) in
       let ball = {shape: "sphere", pos: start, size: r, vel: vel, ang: ang, track: true, restitution: 0.0, friction: 0.0} in
       let run = pxRun({bodies: [ball], portals: [pair], gravity: vec3(0, 0, 0), sleepVelocity: 0.0, steps: toInt(8.0 / speed * 60.0) + 30}) in
       let b = run.bodies[0] in
       near3(b.vel, pxMapDir(fa, fb, vel), 1e-2 * speed + 1e-3)
       and near3(b.ang, pxMapDir(fa, fb, ang), 1e-3 * length(ang) + 1e-3)
       and pxSide(fb, b.pos) > 0
}

# A ray through a portal equals the ray in the unfolded world: put a sphere behind the exit, its image behind the entrance; the portal
# ray from the front of the entrance toward the image hits it at the same distance.
law px_portal_ray_equals_unfolded_ray {
    forall (pair: pxPair, from: vec3(float(-1, 1), float(-1, 1), float(2, 6)), q: vec3(float(-0.5, 0.5), float(-0.5, 0.5), float(2, 6)), r: float(0.2, 0.6))
    where farApart(pair)
    => let f = frames(pair) in
       let fa = f[0] in
       let fb = f[1] in
       let origin = fa.center + fa.right * from.x + fa.up * from.y + fa.normal * from.z in
       let qb = fb.center + fb.right * q.x + fb.up * q.y + fb.normal * q.z in
       let qa = pxMapPoint(fb, fa, qb) in
       let d = normalize(qa - origin) in
       let hitPlane = pxSide(fa, origin) / (0.0 - dot(d, fa.normal)) in
       let entry = origin + d * hitPlane in
       dot(d, fa.normal) < -0.2 and pxInside(fa, entry, 0.3)
       ==> (let portal = pxCast({bodies: [{shape: "sphere", pos: qb, size: r, dynamic: false}], portals: [pair]}, {kind: "portalRay", from: origin, dir: d, dist: 60.0}) in
            let plain = pxCast({bodies: [{shape: "sphere", pos: qa, size: r, dynamic: false}]}, {kind: "ray", from: origin, dir: d, dist: 60.0}) in
            plain.hit and portal.hit and portal.crossings == 1 and abs(portal.distance - plain.distance) < 5e-3)
}

# The same for a swept sphere (a character / camera boom): same hit distance as the sweep in the unfolded world.
law px_portal_sweep_equals_unfolded_sweep {
    forall (pair: pxPair, from: vec3(float(-0.8, 0.8), float(-0.8, 0.8), float(2, 6)), q: vec3(float(-0.4, 0.4), float(-0.4, 0.4), float(2, 6)), r: float(0.3, 0.7), sweepR: float(0.05, 0.25))
    where farApart(pair)
    => let f = frames(pair) in
       let fa = f[0] in
       let fb = f[1] in
       let origin = fa.center + fa.right * from.x + fa.up * from.y + fa.normal * from.z in
       let qb = fb.center + fb.right * q.x + fb.up * q.y + fb.normal * q.z in
       let qa = pxMapPoint(fb, fa, qb) in
       let d = normalize(qa - origin) in
       let hitPlane = pxSide(fa, origin) / (0.0 - dot(d, fa.normal)) in
       let entry = origin + d * hitPlane in
       dot(d, fa.normal) < -0.3 and pxInside(fa, entry, 0.4 + sweepR)
       ==> (let portal = pxCast({bodies: [{shape: "sphere", pos: qb, size: r, dynamic: false}], portals: [pair]}, {kind: "portalSweep", from: origin, dir: d, dist: 60.0, radius: sweepR}) in
            let plain = pxCast({bodies: [{shape: "sphere", pos: qa, size: r, dynamic: false}]}, {kind: "sweepSphere", from: origin, dir: d, dist: 60.0, radius: sweepR}) in
            plain.hit and portal.hit and portal.crossings == 1 and abs(portal.distance - plain.distance) < 5e-3)
}

# Looking through the portal does not show colliders that are on the near side behind the portal (a ray towards a portal that misses the
# opening never crosses, and the portal ray then equals the plain ray).
law px_portal_ray_missing_the_opening_does_not_cross {
    forall (pair: pxPair, side: elements([-1, 1]), out: float(1.2, 3), z: float(1, 5))
    where farApart(pair)
    => let f = frames(pair) in
       let fa = f[0] in
       let origin = fa.center + fa.right * (side * out * fa.half.x) + fa.normal * z in
       let d = fa.normal * -1.0 in
       let portal = pxCast({bodies: [], portals: [pair]}, {kind: "portalRay", from: origin, dir: d, dist: 20.0}) in
       portal.crossings == 0 and not portal.hit
}
