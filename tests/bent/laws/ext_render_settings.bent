# RenderSettings: parse / serialise round trips, clamping, rejection of hostile values (Engine.Render.settings).
# Natives drive the real setRenderSetting / writeRenderSettings on default settings; nothing needs a window.
include "../lib/render.bent"

let defaults = rxRsDefaultDump()
let floatKeys = keysOfKind("float")
let intKeys = keysOfKind("int")
let boolKeys = keysOfKind("bool")
let enumKeys = keysOfKind("enum")
let vecKeys = keysOfKind("vec3")

# Keys the engine clamps on write (name -> [lo, hi]); checked by reading the dump, not the engine's own predicate.
let clampTable = [
    ["renderScale", 0.5, 1.0], ["upscaleSharpness", 0, 1], ["targetFrameMs", 4, 100], ["governorMinScale", 0.5, 1.0],
    ["shadowCascadeBlend", 0, 0.5], ["shadowContactLength", 0, 4], ["aoDenoise", 0, 3], ["cloudAerialStrength", 0, 2],
    ["vsmResolutionScale", 0.25, 8], ["vsmMaxMip", 0, 4], ["reflectionIntensity", 0, 4], ["reflectionTraceDistance", 1, 1000],
    ["sky", 0, 2], ["tonemapper", 0, 5], ["debugView", 0, 11], ["reflectionMode", 0, 4], ["reflectionQuality", 0, 2]
]

# Defaults are sane and every key has a unique name and a recognised kind.
law render_settings_defaults_sane {
    rxRsViolationsOfDefault() == [] and allDistinct(settingNames) and all(settingNames, fn(k) => rxRsKind(k) != "")
        and len(settingNames) == len(floatKeys) + len(intKeys) + len(boolKeys) + len(enumKeys) + len(vecKeys) + len(keysOfKind("string"))
}

# Any sequence of writes, however hostile the text, leaves a state that satisfies every promise of the settings (finite floats,
# enums in range, documented clamps).
law render_settings_any_writes_sane {
    forall (writes: listOf(pairGen, 1, 8))
    => let r = rxRsApply(writes) in cover("a hostile write was rejected", contains(r.accepted, false)) and cover("a write was accepted", contains(r.accepted, true)) and r.violations == []
}

# nan / inf / out of range numbers are rejected for every numeric key and leave the state untouched.
law render_settings_nonfinite_rejected {
    forall (key: elements(floatKeys ++ intKeys ++ boolKeys ++ enumKeys ++ vecKeys), v: badNumberText)
    => let r = rxRsApply([[key, v]]) in r.accepted == [false] and r.dump == defaults
}

# A vec3 setting with one non-finite component is rejected as a whole.
law render_settings_vec3_partial_nonfinite {
    forall (key: elements(vecKeys), bad: badNumberText, slot: int(0, 2), x: float(0, 1))
    => let parts = [str(x), str(x), str(x)] in
       let text = join(map(enumerate(parts), fn(t) => if t[0] == slot then bad else t[1]), " ") in
       let r = rxRsApply([[key, text]]) in r.accepted == [false] and r.dump == defaults
}

# Unparsable text and unknown keys are rejected and change nothing.
law render_settings_junk_rejected {
    forall (key: settingKey, v: junkText, name: ident(1, 8))
    where rxRsKind(key) != "string" and not contains(settingNames, name)
    => rxRsApply([[key, v]]).dump == defaults and rxRsApply([[name, 1]]).accepted == [false] and rxRsApply([[name, 1]]).dump == defaults
}

# Writing the same value twice is the same as once.
law render_settings_idempotent {
    forall (w: pairGen)
    => rxRsApply([w]).dump == rxRsApply([w, w]).dump
}

# Writes to different keys commute.
law render_settings_commute {
    forall (a: pairGen, b: pairGen)
    where a[0] != b[0]
    => rxRsApply([a, b]).dump == rxRsApply([b, a]).dump
}

# A write is local: it only changes its own key (the others print exactly as the defaults do).
law render_settings_write_is_local {
    forall (w: pairGen)
    => let d = rxRsApply([w]).dump in
       all(settingNames, fn(k) => k == w[0] or rxDumpField(d, k) == rxDumpField(defaults, k))
}

# Dump -> load -> dump is a fixpoint, for any reachable state.
law render_settings_dump_roundtrip {
    forall (writes: listOf(pairGen, 0, 12))
    => let d = rxRsApply(writes).dump in
       let again = rxRsLoadDump(d) in
       again.dump == d and again.rejected == 0 and again.violations == []
}

# The default dump reloads to itself.
law render_settings_default_roundtrip {
    rxRsLoadDump(defaults).dump == defaults and rxRsLoadDump(defaults).rejected == 0
}

# Loading a dump with garbage lines mixed in ignores the garbage and never poisons state.
law render_settings_load_tolerates_garbage {
    forall (writes: listOf(pairGen, 0, 6), junk: listOf(text(0, 12), 0, 4))
    => let d = rxRsApply(writes).dump in
       let r = rxRsLoadDump(join(junk, "\n") ++ "\n" ++ d) in
       r.violations == [] and r.dump == rxRsLoadDump(d).dump
}

# The documented ranges hold for any finite number, read back from the dump.
law render_settings_clamp_table {
    forall (row: elements(clampTable), v: oneof(float(-1e6, 1e6), float(-3, 12), float(-1, 2), int(-1000000000, 1000000000)))
    => let d = rxRsApply([[row[0], v]]).dump in
       let x = rxDumpNum(d, row[0]) in
       x >= row[1] - 1e-6 and x <= row[2] + 1e-6
}

# renderScale is quantised to the 0.05 step and the quantisation is stable.
law render_settings_render_scale_quantised {
    forall (v: float(-2, 3))
    => let x = rxDumpNum(rxRsApply([["renderScale", v]]).dump, "renderScale") in
       abs(x / 0.05 - round(x / 0.05)) < 1e-3 and rxDumpNum(rxRsApply([["renderScale", v], ["renderScale", x]]).dump, "renderScale") ~= x within 1e-6
}

# vsmPoolSize is always one of the three supported pool sizes.
law render_settings_vsm_pool_sizes {
    forall (v: oneof(int(-5000, 20000), float(-1e9, 1e9)))
    => contains([2048, 4096, 8192], rxDumpNum(rxRsApply([["vsmPoolSize", v]]).dump, "vsmPoolSize"))
}

# Integer keys saturate instead of overflowing: a huge float never wraps to a different sign.
law render_settings_int_saturates {
    forall (key: elements(intKeys), v: elements([3e9, 1e30, 3.4e38, 0 - 3e9, 0 - 1e30, 2147483648.0]))
    => let x = rxDumpNum(rxRsApply([[key, v]]).dump, key) in
       abs(x) <= 2.1e9 and (v > 0 ==> x >= 0)
}

# A bool key follows the "> 0.5" rule of the parser.
law render_settings_bool_threshold {
    forall (key: elements(boolKeys), v: oneof(float(-2, 3), elements([0, 1, 0.5, 0.5001, 0.4999])))
    => rxDumpField(rxRsApply([[key, v]]).dump, key) == (if v > 0.5 then "1" else "0")
}

# Unclamped float settings print with enough digits to read back the same float.
law render_settings_float_precision {
    forall (key: elements(["timeOfDay", "sunAzimuth", "sunIlluminance", "fogDensity", "fogHeight", "skyBrightness", "hdriIntensity", "bloomIntensity", "aoRadius", "contrast", "temperature"]), v: float(-1e5, 1e5))
    => rxDumpNum(rxRsApply([[key, v]]).dump, key) ~= v within 1e-6
}

# String settings (the HDRI path) keep their text (leading spaces are trimmed by the parser, so none are generated).
law render_settings_string_roundtrip {
    forall (s: ident(1, 20))
    => rxDumpField(rxRsApply([["hdriPath", s]]).dump, "hdriPath") == s
}
