include "../lib/prelude.bent"

gen churn = listOf(frequency([[5, spawnAny], [4, destroy(target: target)], [2, stepAction], [1, reparent(target: target, parent: int(-1, 31))]]), 0, 40)

law handles_unique {
    forall (p: churn)
    => after(p) {
        allDistinct(map(spawned(), handle))
        and (forall e in entities(): alive(e))
        and allDistinct(map(entities(), handle))
    }
}

law destroyed_stays_dead {
    forall (p: churn, s: spawnAny, k: target, q: churn)
    => let n = after(p ++ [s]) { len(spawned()) } in
       after(p ++ [s, destroy(target: k)] ++ q) { not alive(entity(k % n)) }
}

law alive_count_consistent {
    forall (p: programPlus)
    => always after(p) { entityCount() == liveCount() and liveCount() == len(entities()) }
}

law world_validate_clean {
    forall (p: programPlus)
    => always after(p) { worldErrors() == [] }
}

law stale_handle_ops_harmless {
    forall (p: program, e: spawnAny, k: target, d: offset, r: unitQuat(), s: scaleGen)
    => after(p ++ [e, destroy(target: k)]) { contentHash() } ==
       after(p ++ [e, destroy(target: k), move(target: k, delta: d), teleport(target: k, pos: d), setRotation(target: k, rot: r),
                   setScale(target: k, scale: s), setName(target: k, name: "zombie"), reparent(target: k, parent: 0), destroy(target: k)]) { contentHash() }
}

law no_nan_from_finite_programs {
    forall (p: program)
    => always after(p ++ [step(n: 30)]) { not hasNaN() }
}

law teleport_sets_position {
    forall (p: program, s: spawnAny, k: target, v: smallVec)
    => after(p ++ [s, teleport(target: k, pos: v)]) {
        let e = ref(k) in not alive(e) or position(e) ~= v within 1e-6
    }
}

law reparent_keeps_world_position {
    forall (p: listOf(spawn(pos: smallVec, scale: scaleGen, rot: unitQuat(), shape: "none", dynamic: false), 2, 8), k: target, j: target)
    => after(p) {
        let child = ref(k) in let parent = ref(j) in
        let before = worldPosition(child) in
        child == parent or after(p ++ [reparent(target: k, parent: j, keepWorld: true)]) {
            worldPosition(ref(k)) ~= before within 1e-4
        }
    }
}

fn depth(e, limit) = if limit <= 0 then 1000000 else (let p = parent(e) in if p == -1 then 0 else 1 + depth(p, limit - 1))

law hierarchy_acyclic {
    forall (p: listOf(oneof(spawn(shape: "none", pos: smallVec, dynamic: false), reparent(target: target, parent: int(-1, 31), keepWorld: bool()), destroy(target: target)), 0, 40))
    => after(p) { let n = len(entities()) in forall e in entities(): depth(e, n + 1) <= n }
}

law spawn_destroy_counts {
    forall (n: int(0, 30), p: program)
    => after(p) { entityCount() } + n == after(p ++ repeat(spawn(shape: "none", dynamic: false), n)) { entityCount() }
}

law destroy_removes_subtree {
    forall (n: int(1, 10))
    => after([spawn(shape: "none", dynamic: false)] ++ repeat(spawn(shape: "none", dynamic: false, parent: 0), n) ++ [destroy(target: 0)]) { entityCount() == 0 }
}

law compact_preserves_content {
    forall (p: churn)
    => after(p) { contentHash() } == after(p ++ [compact()]) { contentHash() }
}

gen degenerateScale = oneof(vec3(0, 0, 0), vec3(0, 1, 1), vec3(1e-30, 1, 1), vec3(1e-6, 1e-6, 1e-6), scaleGen)
gen hierarchyAction = frequency([
    [4, spawn(shape: "none", dynamic: false, pos: smallVec, scale: degenerateScale, rot: unitQuat(), parent: frequency([[2, just(-1)], [1, target]]))],
    [2, reparent(target: target, parent: int(-1, 31), keepWorld: bool())],
    [2, setScale(target: target, scale: degenerateScale)],
    [1, move(target: target, delta: offset)]
])
law degenerate_scale_stays_finite {
    forall (p: listOf(hierarchyAction, 1, 20))
    => after(p) { not hasNaN() }
}
