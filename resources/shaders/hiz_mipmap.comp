#version 460 core

layout (binding = 0, r32f) readonly uniform image2D u_sourceMip;
layout (binding = 1, r32f) writeonly uniform image2D u_destMip;

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main() {
    ivec2 destCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 destSize = imageSize(u_destMip);

    if (destCoord.x >= destSize.x || destCoord.y >= destSize.y) {
        return;
    }

    ivec2 sourceCoord = destCoord * 2;

    float d0 = imageLoad(u_sourceMip, sourceCoord + ivec2(0, 0)).r;
    float d1 = imageLoad(u_sourceMip, sourceCoord + ivec2(1, 0)).r;
    float d2 = imageLoad(u_sourceMip, sourceCoord + ivec2(0, 1)).r;
    float d3 = imageLoad(u_sourceMip, sourceCoord + ivec2(1, 1)).r;

    float maxDepth = max(max(d0, d1), max(d2, d3));

    // Floor-sized mips drop the last row/column when srcSize is odd; fold it back in at the
    // boundary tile so the Hi-Z max doesn't under-estimate depth there (which would falsely
    // occlude visible objects near the screen edge).
    // Only the last row/column of the destination can ever need this, so the source's dimensions
    // are queried inside that branch instead of for every texel of every mip.
    bool lastCol = destCoord.x == destSize.x - 1;
    bool lastRow = destCoord.y == destSize.y - 1;

    bool oddX = false;
    bool oddY = false;
    if (lastCol || lastRow) {
        ivec2 srcSize = imageSize(u_sourceMip);
        oddX = lastCol && (srcSize.x & 1) != 0;
        oddY = lastRow && (srcSize.y & 1) != 0;
    }

    if (oddX) {
        maxDepth = max(maxDepth, imageLoad(u_sourceMip, sourceCoord + ivec2(2, 0)).r);
        maxDepth = max(maxDepth, imageLoad(u_sourceMip, sourceCoord + ivec2(2, 1)).r);
    }
    if (oddY) {
        maxDepth = max(maxDepth, imageLoad(u_sourceMip, sourceCoord + ivec2(0, 2)).r);
        maxDepth = max(maxDepth, imageLoad(u_sourceMip, sourceCoord + ivec2(1, 2)).r);
    }
    if (oddX && oddY) {
        maxDepth = max(maxDepth, imageLoad(u_sourceMip, sourceCoord + ivec2(2, 2)).r);
    }

    imageStore(u_destMip, destCoord, vec4(maxDepth, 0.0, 0.0, 0.0));
}