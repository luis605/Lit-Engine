#version 450
#extension GL_GOOGLE_include_directive : require
#include "renderable.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std140, binding = 0) uniform BoundsUniforms {
    uint u_instanceCount;
    uint u_pad0;
    uint u_pad1;
    uint u_pad2;
};

struct DynamicBound {
    vec4 sphere;
    uvec4 info;
};

layout(std430, binding = 1) readonly buffer DynamicBoundBuffer {
    DynamicBound dynamicBounds[];
};

struct WorldRows {
    vec4 r0;
    vec4 r1;
    vec4 r2;
};

layout(std430, binding = 2) readonly buffer WorldMatrixBuffer {
    WorldRows worldRows[];
};

layout(std430, binding = 3) buffer CullSphereBuffer {
    vec4 cullSpheres[];
};

layout(std430, binding = 4) readonly buffer ShaderBoundsBuffer {
    float shaderBounds[];
};

layout(std430, binding = 5) buffer DynamicStampBuffer {
    uint dynamicStamps[];
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= u_instanceCount) return;
    DynamicBound bound = dynamicBounds[i];
    uint entity = bound.info.x;
    uint renderable = renderables[entity];
    if (renderableMesh(renderable) != bound.info.y || (renderableFlags(renderable) & RENDER_HIDDEN) != 0u) return;
    WorldRows w = worldRows[entity];
    vec3 center = vec3(dot(w.r0.xyz, bound.sphere.xyz) + w.r0.w, dot(w.r1.xyz, bound.sphere.xyz) + w.r1.w, dot(w.r2.xyz, bound.sphere.xyz) + w.r2.w);
    float maxScale = max(length(vec3(w.r0.x, w.r1.x, w.r2.x)), max(length(vec3(w.r0.y, w.r1.y, w.r2.y)), length(vec3(w.r0.z, w.r1.z, w.r2.z))));
    dynamicStamps[entity] = bound.info.z;
    cullSpheres[entity] = vec4(center, (bound.sphere.w + shaderBounds[min(renderableShader(renderable), 15u)]) * maxScale);
}
