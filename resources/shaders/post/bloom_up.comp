#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

uniform sampler2D u_lower;
uniform sampler2D u_current;
layout(rgba16f) writeonly uniform image2D u_output;

layout(std140) uniform BloomConstants {
    vec4 u_params;
};

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_output);
    if (any(greaterThanEqual(pixel, size))) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec2 t = 1.0 / vec2(textureSize(u_lower, 0));
    vec3 up = textureLod(u_lower, uv + vec2(-t.x, -t.y), 0.0).rgb + textureLod(u_lower, uv + vec2(t.x, -t.y), 0.0).rgb + textureLod(u_lower, uv + vec2(-t.x, t.y), 0.0).rgb + textureLod(u_lower, uv + vec2(t.x, t.y), 0.0).rgb;
    up += 2.0 * (textureLod(u_lower, uv + vec2(0.0, -t.y), 0.0).rgb + textureLod(u_lower, uv + vec2(0.0, t.y), 0.0).rgb + textureLod(u_lower, uv + vec2(-t.x, 0.0), 0.0).rgb + textureLod(u_lower, uv + vec2(t.x, 0.0), 0.0).rgb);
    up += 4.0 * textureLod(u_lower, uv, 0.0).rgb;
    up /= 16.0;
    vec3 current = textureLod(u_current, uv, 0.0).rgb;
    imageStore(u_output, pixel, vec4(mix(current, up, u_params.y), 1.0));
}
