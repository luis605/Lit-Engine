#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

uniform sampler2D u_source;
layout(rgba8) writeonly uniform image2D u_output;

float saturate(float x) { return clamp(x, 0.0, 1.0); }

float lumaOf(vec3 c) { return dot(c, vec3(0.5, 1.0, 0.5)); }

float lanczos2(float x2, float clipScale) {
    float w = 0.4 * x2 - 1.0;
    float taper = 0.25 * x2 - 1.0;
    return (w * w) * (taper * taper) * clipScale;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(u_output);
    if (any(greaterThanEqual(pixel, outSize))) return;
    ivec2 srcSize = textureSize(u_source, 0);
    vec2 srcPos = (vec2(pixel) + 0.5) * vec2(srcSize) / vec2(outSize) - 0.5;
    ivec2 base = ivec2(floor(srcPos));
    vec2 frac = srcPos - vec2(base);

    vec3 colors[16];
    float lumas[16];
    for (int y = 0; y < 4; ++y) {
        for (int x = 0; x < 4; ++x) {
            ivec2 p = clamp(base + ivec2(x - 1, y - 1), ivec2(0), srcSize - 1);
            vec3 c = texelFetch(u_source, p, 0).rgb;
            colors[y * 4 + x] = c;
            lumas[y * 4 + x] = lumaOf(c);
        }
    }

    vec2 gradient = vec2(0.0);
    float gradientWeight = 0.0;
    for (int y = 1; y <= 2; ++y) {
        for (int x = 1; x <= 2; ++x) {
            float bilinear = ((x == 1) ? 1.0 - frac.x : frac.x) * ((y == 1) ? 1.0 - frac.y : frac.y);
            float gx = lumas[y * 4 + x + 1] - lumas[y * 4 + x - 1];
            float gy = lumas[(y + 1) * 4 + x] - lumas[(y - 1) * 4 + x];
            gradient += vec2(gx, gy) * bilinear;
            gradientWeight += bilinear;
        }
    }
    gradient /= max(gradientWeight, 1e-4);
    float gradientLen2 = dot(gradient, gradient);
    vec2 direction = gradientLen2 > 1.0 / 32768.0 ? gradient * inversesqrt(gradientLen2) : vec2(1.0, 0.0);
    float edge = saturate(gradientLen2 * 128.0);
    float lenAlong = mix(1.0, 0.5, edge);
    float lenAcross = mix(1.0, 2.0, edge);
    vec2 axisA = direction;
    vec2 axisB = vec2(-direction.y, direction.x);

    vec3 sum = vec3(0.0);
    float weightSum = 0.0;
    for (int y = 0; y < 4; ++y) {
        for (int x = 0; x < 4; ++x) {
            vec2 offset = vec2(float(x - 1), float(y - 1)) - frac;
            float along = dot(offset, axisA) * lenAlong;
            float across = dot(offset, axisB) * lenAcross;
            float d2 = min(along * along + across * across, 4.0);
            float w = lanczos2(d2, 1.0);
            sum += colors[y * 4 + x] * w;
            weightSum += w;
        }
    }
    vec3 result = sum / (abs(weightSum) > 1e-5 ? weightSum : 1.0);
    vec3 lo = min(min(colors[5], colors[6]), min(colors[9], colors[10]));
    vec3 hi = max(max(colors[5], colors[6]), max(colors[9], colors[10]));
    result = clamp(result, lo, hi);
    imageStore(u_output, pixel, vec4(result, 1.0));
}
