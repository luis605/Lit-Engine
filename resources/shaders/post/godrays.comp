#version 450
#extension GL_GOOGLE_include_directive : require
#include "scene.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std140) uniform GodRayConstants {
    vec4 godRayPass;
};

bool sunScreen(out vec2 sunUv, out float fade) {
    vec4 clip = viewProjection * vec4(sunDirection.xyz, 0.0);
    vec3 forward = -vec3(invView[2]);
    fade = smoothstep(0.0, 0.25, dot(forward, sunDirection.xyz)) * smoothstep(-0.02, 0.04, sunDirection.y);
    if (clip.w <= 1e-4) return false;
    vec2 ndc = clip.xy / clip.w;
    sunUv = vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
    return fade > 0.0;
}

#if defined(MASK)
uniform sampler2D u_depth;
uniform sampler2D u_clouds;
layout(r16f) writeonly uniform image2D u_output;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_output);
    if (any(greaterThanEqual(pixel, size))) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    ivec2 depthSize = textureSize(u_depth, 0);
    ivec2 base = min(pixel * 2, depthSize - 2);
    float sky = 0.0;
    for (int i = 0; i < 4; ++i) sky += texelFetch(u_depth, base + ivec2(i & 1, i >> 1), 0).r >= 1.0 ? 0.25 : 0.0;
    float value = 0.0;
    if (sky > 0.0) {
        vec3 dir = normalize(worldFromDepth(uv, 1.0) - viewPos);
        float cosSun = max(dot(dir, sunDirection.xyz), 0.0);
        float glow = pow(cosSun, 96.0) + pow(cosSun, 12.0) * 0.25;
        value = sky * glow * textureLod(u_clouds, uv, 0.0).a;
    }
    imageStore(u_output, pixel, vec4(value));
}
#elif defined(BLUR)
uniform sampler2D u_input;
layout(r16f) writeonly uniform image2D u_output;

const int TAPS = 10;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_output);
    if (any(greaterThanEqual(pixel, size))) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec2 sunUv;
    float fade;
    if (!sunScreen(sunUv, fade)) {
        imageStore(u_output, pixel, vec4(0.0));
        return;
    }
    vec2 delta = (sunUv - uv) * godRayPass.x / float(TAPS);
    float sum = 0.0;
    float weight = 0.0;
    for (int i = 0; i < TAPS; ++i) {
        vec2 p = uv + delta * float(i);
        float w = exp(-float(i) * godRayPass.y);
        float inside = all(greaterThanEqual(p, vec2(0.0))) && all(lessThanEqual(p, vec2(1.0))) ? 1.0 : 0.0;
        sum += textureLod(u_input, p, 0.0).r * w * inside;
        weight += w;
    }
    imageStore(u_output, pixel, vec4(sum / weight));
}
#else
uniform sampler2D u_shafts;
layout(rgba16f) uniform image2D u_hdr;

layout(std430) readonly buffer ExposureBuffer {
    vec4 exposureData;
};

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_hdr);
    if (any(greaterThanEqual(pixel, size))) return;
    vec2 sunUv;
    float fade;
    if (!sunScreen(sunUv, fade)) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    float shafts = textureLod(u_shafts, uv, 0.0).r;
    vec3 light = sunIlluminance.rgb * (skyParams3.z * fade * 0.05);
    vec4 hdr = imageLoad(u_hdr, pixel);
    imageStore(u_hdr, pixel, vec4(hdr.rgb + light * shafts * exposureData.x, hdr.a));
}
#endif
