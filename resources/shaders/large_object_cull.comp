#version 460 core
#extension GL_GOOGLE_include_directive : require
#include "renderable.glsl"
#include "scene.glsl"
#include "mesh.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std140) uniform LargeObjectCullConstants {
    uint u_objectCount;
    uint u_maxDraws;
    float u_largeObjectThreshold;
    uint u_numShaders;
};

// Per-(shaderId, mesh_uuid) survivor counts. The depth pre-pass consumes these through the same
// prefix-sum/scatter/command-gen chain the opaque pass uses, so it can issue one instanced draw
// per bucket instead of one indirect draw per visible large object.
layout(std430) buffer LargeBucketCountBuffer {
    uint largeBucketCounts[];
};

layout(std430) buffer VisibleLargeObjectAtomicCounter {
    uint visibleLargeObjectCount;
};

layout(std430) buffer VisibleLargeObjectBuffer {
    uvec2 visibleLargeObjects[];
};

layout(std430) readonly buffer CullSphereBuffer {
    vec4 cullSpheres[];
};

const uint COARSEST_OCCLUDER_LOD = POINT_LOD - 1u;
const uint OCCLUDER_LOD_OFFSET = 2u;

uint occluderLod(float radius, float dist) {
    return min(lodForDiameter(projectedDiameterPx(radius, dist)) + OCCLUDER_LOD_OFFSET, COARSEST_OCCLUDER_LOD);
}

const float FRUSTUM_PADDING_FACTOR = 1.05f;

bool isVisible(vec3 world_pos, float radius) {
    for (int i = 0; i < 6; i++) {
        if (dot(frustumPlanes[i].xyz, world_pos) + frustumPlanes[i].w < -radius) {
            return false;
        }
    }
    return true;
}

void main() {
    uint objectId = gl_GlobalInvocationID.x;
    if (objectId >= u_objectCount) return;

    vec4 boundingSphere = cullSpheres[objectId];
    if (boundingSphere.w < 0.0) return;
    vec3 world_pos = boundingSphere.xyz;
    float world_radius = boundingSphere.w;

    if (!isVisible(world_pos, world_radius * FRUSTUM_PADDING_FACTOR)) return;

    float dist = distance(world_pos, viewPos);
    if (dist > 0.0 && world_radius / dist < u_largeObjectThreshold) return;

    uint renderable = renderables[objectId];
    if ((renderableFlags(renderable) & (RENDER_TRANSLUCENT | RENDER_NO_OCCLUDER)) != 0u) return;
    uint meshUuid = renderableMesh(renderable);
    uint shaderId = renderableShader(renderable);
    if (meshUuid >= MAX_MESHES || shaderId >= u_numShaders) return;

    uint index = atomicAdd(visibleLargeObjectCount, 1);

    if (index < u_maxDraws) {
        uint lod = occluderLod(world_radius, dist);
        uint bucketKey = shaderId * MAX_MESHES + meshUuid + lod;
        visibleLargeObjects[index] = uvec2(objectId | (lod << 29u), bucketKey);
        atomicAdd(largeBucketCounts[bucketKey], 1);
    }
}
