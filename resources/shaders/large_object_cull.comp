#version 460 core
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_GOOGLE_include_directive : require
#include "renderable.glsl"
#include "scene.glsl"
#include "mesh.glsl"
#include "hiz.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std140) uniform LargeObjectCullConstants {
    uint u_objectCount;
    uint u_maxDraws;
    float u_largeObjectThreshold;
    uint u_numShaders;
};

// Per-(shaderId, mesh_uuid) survivor counts. The depth pre-pass consumes these through the same
// prefix-sum/scatter/command-gen chain the opaque pass uses, so it can issue one instanced draw
// per bucket instead of one indirect draw per visible large object.
layout(std430) buffer LargeBucketCountBuffer {
    uint largeBucketCounts[];
};

layout(std430) buffer VisibleLargeObjectAtomicCounter {
    uint visibleLargeObjectCount;
};

layout(std430) buffer VisibleLargeObjectBuffer {
    uvec2 visibleLargeObjects[];
};

layout(std430) readonly buffer CullSphereBuffer {
    vec4 cullSpheres[];
};

const uint COARSEST_OCCLUDER_LOD = POINT_LOD - 1u;
const uint OCCLUDER_LOD_OFFSET = 2u;

uint occluderLod(float radius, float dist) {
    return min(lodForDiameter(projectedDiameterPx(radius, dist)) + OCCLUDER_LOD_OFFSET, COARSEST_OCCLUDER_LOD);
}

const float FRUSTUM_PADDING_FACTOR = 1.05f;

bool isVisible(vec3 world_pos, float radius) {
    for (int i = 0; i < 6; i++) {
        if (dot(frustumPlanes[i].xyz, world_pos) + frustumPlanes[i].w < -radius) {
            return false;
        }
    }
    return true;
}

bool selectOccluder(uint objectId, out uvec2 entry) {
    entry = uvec2(0u);
    vec4 boundingSphere = cullSpheres[objectId];
    if (boundingSphere.w < 0.0) return false;
    vec3 worldCenter = boundingSphere.xyz;
    float radius = boundingSphere.w;

    if (!isVisible(worldCenter, radius * FRUSTUM_PADDING_FACTOR)) return false;

    float dist = distance(worldCenter, viewPos);
    if (dist > 0.0 && radius / dist < u_largeObjectThreshold) return false;

    uint renderable = renderables[objectId];
    if ((renderableFlags(renderable) & (RENDER_TRANSLUCENT | RENDER_NO_OCCLUDER)) != 0u) return false;
    uint meshUuid = renderableMesh(renderable);
    uint shaderId = renderableShader(renderable);
    if (meshUuid >= MAX_MESHES || shaderId >= u_numShaders) return false;

    if (sphereOccluded(worldCenter, radius)) return false;

    uint lod = occluderLod(radius, dist);
    entry = uvec2(objectId | (lod << 29u), shaderId * MAX_MESHES + meshUuid + lod);
    return true;
}

void main() {
    uint objectId = gl_GlobalInvocationID.x;
    uvec2 entry;
    bool selected = objectId < u_objectCount && selectOccluder(objectId, entry);

    uvec4 selectedBallot = subgroupBallot(selected);
    uint slotBase = 0u;
    if (subgroupElect()) slotBase = atomicAdd(visibleLargeObjectCount, subgroupBallotBitCount(selectedBallot));
    uint slot = subgroupBroadcastFirst(slotBase) + subgroupBallotExclusiveBitCount(selectedBallot);
    bool pending = selected && slot < u_maxDraws;
    if (pending) visibleLargeObjects[slot] = entry;

    while (subgroupBallotBitCount(subgroupBallot(pending)) > 0u) {
        if (pending) {
            uint key = subgroupBroadcastFirst(entry.y);
            uvec4 same = subgroupBallot(entry.y == key);
            if (subgroupElect()) atomicAdd(largeBucketCounts[key], subgroupBallotBitCount(same));
            if (entry.y == key) pending = false;
        }
    }
}
