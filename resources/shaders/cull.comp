#version 450
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_GOOGLE_include_directive : require
#include "renderable.glsl"
#include "scene.glsl"
#include "mesh.glsl"
#include "hiz.glsl"

#if defined(RETEST) || defined(TRANSPARENT)
#define CANDIDATE_INPUT
#endif
#if !defined(CANDIDATE_INPUT)
#define RETEST_OUTPUT
#endif
#if !defined(TRANSPARENT)
#define TRANSPARENT_OUTPUT
#endif

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std140) uniform CullingUniforms {
    uint u_objectCount;
    uint u_maxDraws;
    float u_smallObjectThreshold;
    float u_lodBias;
    int u_forcedLod;
    uint u_opaqueShaderCount;
};

layout(std430) buffer AtomicCounterBuffer {
    uint u_atomicCounter;
};

layout(std430) writeonly buffer VisibleObjectBuffer {
    uvec2 u_visibleObjects[];
};

layout(std430) readonly buffer CullSphereBuffer {
    vec4 cullSpheres[];
};

layout(std430) buffer BucketCountBuffer {
    uint bucketCounts[];
};

#ifdef CANDIDATE_INPUT
layout(std430) readonly buffer CandidateCounterBuffer {
    uint u_candidateCount;
};

layout(std430) readonly buffer CandidateBuffer {
    uint u_candidateIds[];
};
#endif

#ifdef RETEST_OUTPUT
layout(std430) buffer RetestCounterBuffer {
    uint u_retestCount;
};

layout(std430) writeonly buffer RetestBuffer {
    uint u_retestIds[];
};
#endif

#ifdef TRANSPARENT_OUTPUT
layout(std430) buffer TransparentCounterBuffer {
    uint u_transparentCount;
};

layout(std430) writeonly buffer TransparentBuffer {
    uint u_transparentIds[];
};
#endif

const uint CULLED = 0u;
const uint OCCLUDED = 1u;
const uint VISIBLE = 2u;
const uint TRANSPARENT_CANDIDATE = 3u;

#ifdef TRANSPARENT
const float TRANSPARENT_LOD_DIAMETER_PX[LOD_LEVEL_COUNT - 1u] = float[](60.0, 40.0, 25.0, 8.0, 3.0, 1.5);
#endif

uint selectLod(float radius, float dist) {
    if (u_forcedLod >= 0) return min(uint(u_forcedLod), POINT_LOD);
    if (dist <= radius) return 0u;
    float diameterPx = u_lodBias * projectedDiameterPx(radius, dist);
#ifdef TRANSPARENT
    for (uint lod = 0u; lod < POINT_LOD; ++lod) {
        if (diameterPx >= TRANSPARENT_LOD_DIAMETER_PX[lod]) return lod;
    }
    return POINT_LOD;
#else
    return lodForDiameter(diameterPx);
#endif
}

uint cullObject(uint id, out uvec2 entry) {
    entry = uvec2(0u);

    vec4 boundingSphere = cullSpheres[id];
    if (boundingSphere.w < 0.0) return CULLED;
    vec3 worldCenter = boundingSphere.xyz;
    float radius = boundingSphere.w;

    for (int i = 0; i < 6; ++i) {
        if (dot(frustumPlanes[i].xyz, worldCenter) + frustumPlanes[i].w < -radius) return CULLED;
    }

    float dist = max(-(view * vec4(worldCenter, 1.0)).z, 0.001);
    if (radius / dist < u_smallObjectThreshold) return CULLED;

    if (sphereOccluded(worldCenter, radius)) return OCCLUDED;

    uint renderable = renderables[id];
#ifdef TRANSPARENT
    uint bucketShader = 0u;
#else
    uint bucketShader = renderableShader(renderable);
    if (bucketShader > u_opaqueShaderCount) return CULLED;
    if (bucketShader == u_opaqueShaderCount) return TRANSPARENT_CANDIDATE;
#ifdef RETEST_OUTPUT
    if ((renderableFlags(renderable) & RENDER_NO_OCCLUDER) != 0u) return OCCLUDED;
#endif
#endif

    uint chosenLod = selectLod(radius, dist);
    uint bucketIndex = bucketShader * MAX_MESHES + renderableMesh(renderable) + chosenLod;
    entry = uvec2(id | (chosenLod << 29u), bucketIndex | (renderableMaterial(renderable) << 16u));
    return VISIBLE;
}

void appendVisible(bool visible, uvec2 entry) {
    uvec4 visibleBallot = subgroupBallot(visible);
    uint slotBase = 0u;
    if (subgroupElect()) slotBase = atomicAdd(u_atomicCounter, subgroupBallotBitCount(visibleBallot));
    uint slot = subgroupBroadcastFirst(slotBase) + subgroupBallotExclusiveBitCount(visibleBallot);
    if (visible && slot < u_maxDraws) u_visibleObjects[slot] = entry;

    uint bucket = entry.y & 0xFFFFu;
    bool pending = visible;
    while (subgroupBallotBitCount(subgroupBallot(pending)) > 0u) {
        if (pending) {
            uint key = subgroupBroadcastFirst(bucket);
            uvec4 same = subgroupBallot(bucket == key);
            if (subgroupElect()) atomicAdd(bucketCounts[key], subgroupBallotBitCount(same));
            if (bucket == key) pending = false;
        }
    }
}

#ifdef RETEST_OUTPUT
void appendRetest(bool occluded, uint id) {
    uvec4 ballot = subgroupBallot(occluded);
    uint slotBase = 0u;
    if (subgroupElect()) slotBase = atomicAdd(u_retestCount, subgroupBallotBitCount(ballot));
    uint slot = subgroupBroadcastFirst(slotBase) + subgroupBallotExclusiveBitCount(ballot);
    if (occluded && slot < u_maxDraws) u_retestIds[slot] = id;
}
#endif

#ifdef TRANSPARENT_OUTPUT
void appendTransparent(bool transparent, uint id) {
    uvec4 ballot = subgroupBallot(transparent);
    uint slotBase = 0u;
    if (subgroupElect()) slotBase = atomicAdd(u_transparentCount, subgroupBallotBitCount(ballot));
    uint slot = subgroupBroadcastFirst(slotBase) + subgroupBallotExclusiveBitCount(ballot);
    if (transparent && slot < u_maxDraws) u_transparentIds[slot] = id;
}
#endif

void main() {
#ifdef CANDIDATE_INPUT
    uint index = gl_GlobalInvocationID.x;
    bool inRange = index < min(u_candidateCount, u_maxDraws);
    uint id = inRange ? u_candidateIds[index] : 0u;
#else
    uint id = gl_GlobalInvocationID.x;
    bool inRange = id < u_objectCount;
#endif
    uvec2 entry;
    uint result = inRange ? cullObject(id, entry) : CULLED;
    appendVisible(result == VISIBLE, entry);
#ifdef RETEST_OUTPUT
    appendRetest(result == OCCLUDED, id);
#endif
#ifdef TRANSPARENT_OUTPUT
    appendTransparent(result == TRANSPARENT_CANDIDATE, id);
#endif
}
