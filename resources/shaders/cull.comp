#version 450
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_GOOGLE_include_directive : require
#include "renderable.glsl"
#include "scene.glsl"
#include "mesh.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std140) uniform CullingUniforms {
    uint u_objectCount;
    uint u_maxDraws;
    uint u_baseIndex;
    float u_smallObjectThreshold;
    float u_hizMaxMipLevel;
    float u_hizTextureSizeX;
    float u_hizTextureSizeY;
    uint u_numShaders;
    float u_lodBias;
    int u_forcedLod;
};

layout(std430) buffer AtomicCounterBuffer {
    uint u_atomicCounter;
};

layout(std430) writeonly buffer VisibleObjectBuffer {
    uvec2 u_visibleObjects[];
};

layout(std430) readonly buffer CullSphereBuffer {
    vec4 cullSpheres[];
};

layout(std430) buffer BucketCountBuffer {
    uint bucketCounts[];
};

uint selectLod(float radius, float dist) {
    if (u_forcedLod >= 0) return min(uint(u_forcedLod), POINT_LOD);
    if (dist <= radius) return 0u;
    return lodForDiameter(u_lodBias * projectedDiameterPx(radius, dist));
}

uniform sampler2D u_hizTexture;

bool cullObject(uint id, out uvec2 entry) {
    entry = uvec2(0u);

    vec4 boundingSphere = cullSpheres[id];
    if (boundingSphere.w < 0.0) return false;
    vec3 worldCenter = boundingSphere.xyz;
    float radius = boundingSphere.w;

    for (int i = 0; i < 6; ++i) {
        if (dot(frustumPlanes[i].xyz, worldCenter) + frustumPlanes[i].w < -radius) return false;
    }

    vec4 viewPosCenter = view * vec4(worldCenter, 1.0);
    float dist = -viewPosCenter.z;
    if (dist <= 0.0) dist = 0.001;
    float pRadius = radius / dist;
    if (pRadius < u_smallObjectThreshold) return false;

    if (viewPosCenter.z + radius < -0.1) {
        vec4 clipCenter = projection * vec4(viewPosCenter.xyz, 1.0);
        vec2 ndcCenter = clipCenter.xy / clipCenter.w;
        vec2 pSize = vec2(radius * abs(projection[0][0]), radius * abs(projection[1][1])) / dist;

        vec2 uvCenter = vec2(ndcCenter.x * 0.5 + 0.5, 0.5 - ndcCenter.y * 0.5);

        float u0 = clamp(uvCenter.x - pSize.x * 0.5, 0.0, 1.0);
        float u1 = clamp(uvCenter.x + pSize.x * 0.5, 0.0, 1.0);
        float v0 = clamp(uvCenter.y - pSize.y * 0.5, 0.0, 1.0);
        float v1 = clamp(uvCenter.y + pSize.y * 0.5, 0.0, 1.0);

        vec2 uvMin = vec2(min(u0, u1), min(v0, v1));
        vec2 uvMax = vec2(max(u0, u1), max(v0, v1));

        vec2 sizePixels = (uvMax - uvMin) * vec2(u_hizTextureSizeX, u_hizTextureSizeY);
        float maxPix = max(sizePixels.x, sizePixels.y);
        float mip = clamp(ceil(log2(max(maxPix, 1.0))), 0.0, u_hizMaxMipLevel);

        float d0 = textureLod(u_hizTexture, vec2(uvMin.x, uvMin.y), mip).r;
        float d1 = textureLod(u_hizTexture, vec2(uvMax.x, uvMin.y), mip).r;
        float d2 = textureLod(u_hizTexture, vec2(uvMin.x, uvMax.y), mip).r;
        float d3 = textureLod(u_hizTexture, vec2(uvMax.x, uvMax.y), mip).r;
        float maxHizDepth = max(max(d0, d1), max(d2, d3));

        vec4 nearPos = viewPosCenter;
        nearPos.z += radius;
        vec4 clipNear = projection * nearPos;
        float sphereNearDepth = clipNear.z / clipNear.w;

        if (sphereNearDepth > maxHizDepth) return false;
    }

    uint chosenLod = selectLod(radius, dist);

    uint renderable = renderables[id];
    uint bucketIndex = renderableShader(renderable) * MAX_MESHES + renderableMesh(renderable) + chosenLod;

    entry = uvec2(id | (chosenLod << 29u), bucketIndex | (renderableMaterial(renderable) << 16u));
    return true;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    uvec2 entry = uvec2(0u);
    bool visible = id < u_objectCount && cullObject(id, entry);

    uvec4 visibleBallot = subgroupBallot(visible);
    uint slotBase = 0u;
    if (subgroupElect()) slotBase = atomicAdd(u_atomicCounter, subgroupBallotBitCount(visibleBallot));
    slotBase = subgroupBroadcastFirst(slotBase);
    uint slot = slotBase + subgroupBallotExclusiveBitCount(visibleBallot);
    if (visible && slot < u_maxDraws) u_visibleObjects[slot] = entry;

    uint bucket = entry.y & 0xFFFFu;
    bool pending = visible;
    while (subgroupBallotBitCount(subgroupBallot(pending)) > 0u) {
        if (pending) {
            uint key = subgroupBroadcastFirst(bucket);
            uvec4 same = subgroupBallot(bucket == key);
            if (subgroupElect()) atomicAdd(bucketCounts[key], subgroupBallotBitCount(same));
            if (bucket == key) pending = false;
        }
    }
}
