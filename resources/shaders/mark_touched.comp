#version 460 core

// Stamps just the dirty entities' touched-epoch when local-matrix data already arrived via the
// bulk contiguous reupload path (cheap on its own - a plain UpdateBuffer of the CPU dirty-index
// list needs no per-entity assembly). Lets transform.comp skip the rest of the scene's transform
// recompute regardless of which upload strategy was used for the underlying data.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0, std430) readonly buffer DirtyIndexBuffer {
    uint dirtyIndices[];
};

// Pure scatter target here; writeonly (NonReadable in SPIR-V) still reflects as a UAV, so the
// host-side binding is unchanged.
layout(binding = 1, std430) writeonly buffer TouchedEpochBuffer {
    uint touchedEpoch[];
};

layout(std140, binding = 2) uniform MarkTouchedConstants {
    uint u_dirtyCount;
    uint u_epoch;
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= u_dirtyCount) return;

    touchedEpoch[dirtyIndices[i]] = u_epoch;
}
