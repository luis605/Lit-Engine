#version 450
#extension GL_GOOGLE_include_directive : require
#include "renderable.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct DrawElementsIndirectCommand {
    uint count;
    uint instanceCount;
    uint firstIndex;
    uint baseVertex;
    uint baseInstance;
};

struct MeshInfo {
    uint indexCount;
    uint firstIndex;
    uint baseVertex;
    float boundingRadius;
    vec4 boundingCenter;
};

struct VisibleTransparentObject {
    uint objectId;
    float distance;
};

layout(std430, binding = 0) readonly buffer VisibleTransparentObjectBuffer {
    VisibleTransparentObject visibleTransparentObjects[];
};

layout(std430, binding = 1) readonly buffer MeshInfoBuffer {
    MeshInfo meshInfos[];
};

layout(std430, binding = 3) buffer TransparentDrawCommandBuffer {
    DrawElementsIndirectCommand drawCommands[];
};

layout(std430, binding = 4) readonly buffer AtomicCounterBuffer {
    uint visibleTransparentCount;
};

layout(std140, binding = 5) uniform TransparentCommandGenUniforms {
    uint u_maxDraws;
    uint padding0;
    uint padding1;
    uint padding2;
};

void main() {
    uint gId = gl_GlobalInvocationID.x;
    if (gId >= visibleTransparentCount || gId >= u_maxDraws) {
        return;
    }

    uint packedEntry = visibleTransparentObjects[gId].objectId;
    uint objectId = packedEntry & 0x1FFFFFFFu;
    uint lod = packedEntry >> 29u;
    MeshInfo mesh = meshInfos[renderableMesh(renderables[objectId]) + lod];

    drawCommands[gId].count = mesh.indexCount;
    drawCommands[gId].instanceCount = 1;
    drawCommands[gId].firstIndex = mesh.firstIndex;
    drawCommands[gId].baseVertex = mesh.baseVertex;
    drawCommands[gId].baseInstance = gId;
}