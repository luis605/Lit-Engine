#version 450

// One thread per (shaderId, mesh) bucket - fixed dispatch size regardless of scene/visible-object
// count - emitting a single instanced draw command per non-empty bucket. Replaces the old one
// draw-command-per-object scheme, which produced up to one indirect draw per visible object.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

const uint MAX_MESHES = 2048;

struct DrawElementsIndirectCommand {
    uint count;
    uint instanceCount;
    uint firstIndex;
    uint baseVertex;
    uint baseInstance;
};

struct MeshInfo {
    uint indexCount;
    uint firstIndex;
    uint baseVertex;
    float boundingRadius;
    vec4 boundingCenter;
};

layout(std430, binding = 0) buffer DrawAtomicCounterBuffer {
    uint drawCounters[];
};

layout(std430, binding = 1) buffer DrawCommandBuffer {
    DrawElementsIndirectCommand commands[];
};

layout(std430, binding = 2) readonly buffer MeshInfoBuffer {
    MeshInfo meshInfos[];
};

layout(std430, binding = 3) readonly buffer BucketCountBuffer {
    uint bucketCounts[];
};

layout(std430, binding = 4) readonly buffer BucketOffsetBuffer {
    uint bucketOffsets[];
};

layout(std140, binding = 5) uniform CommandGenConstants {
    uint u_maxBucketsPerShader; // = MAX_MESHES
    uint u_totalBuckets;        // = numDrawingShaders * MAX_MESHES
};

void main() {
    uint key = gl_GlobalInvocationID.x;
    if (key >= u_totalBuckets) return;

    uint count = bucketCounts[key];
    if (count == 0) return;

    uint shaderId = key / MAX_MESHES;
    uint meshId = key % MAX_MESHES;
    MeshInfo mesh = meshInfos[meshId];

    uint drawIdx = atomicAdd(drawCounters[shaderId], 1);
    if (drawIdx >= u_maxBucketsPerShader) return;

    uint cmdOffset = shaderId * u_maxBucketsPerShader + drawIdx;
    commands[cmdOffset].count = mesh.indexCount;
    commands[cmdOffset].instanceCount = count;
    commands[cmdOffset].firstIndex = mesh.firstIndex;
    commands[cmdOffset].baseVertex = mesh.baseVertex;
    commands[cmdOffset].baseInstance = bucketOffsets[key];
}
