#version 450
#extension GL_GOOGLE_include_directive : require
#include "scene.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

uniform sampler2D u_depth;
uniform sampler2D u_gbuffer1;
uniform sampler2D u_previousColor;
uniform sampler2D u_hiz;
layout(rgba16f) writeonly uniform image2D u_output;

layout(std430) readonly buffer ExposureBuffer {
    vec4 exposureData;
};

const int MAX_ITERATIONS = 160;

vec3 toScreen(vec3 viewPosition, vec2 size) {
    vec4 clip = projection * vec4(viewPosition, 1.0);
    vec3 ndc = clip.xyz / clip.w;
    return vec3((ndc.x * 0.5 + 0.5) * size.x, (0.5 - ndc.y * 0.5) * size.y, ndc.z);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_output);
    if (any(greaterThanEqual(pixel, size))) return;
    ivec2 fullPixel = pixel;
    vec2 uv = (vec2(fullPixel) + 0.5) * screenParams.zw;
    float depth = texelFetch(u_depth, fullPixel, 0).r;
    vec4 g1 = texelFetch(u_gbuffer1, fullPixel, 0);
    float roughness = g1.b;
    float maxRoughness = ssrParams.x;
    if (depth >= 1.0 || roughness > maxRoughness) {
        imageStore(u_output, pixel, vec4(0.0));
        return;
    }
    vec3 P = viewFromDepth(uv, depth);
    vec3 N = normalize(mat3(view) * decodeNormal(g1.rg));
    vec3 V = normalize(P);
    vec3 R = normalize(reflect(V, N));
    if (R.z > 0.0 && -P.z < R.z * 4.0) {
        imageStore(u_output, pixel, vec4(0.0));
        return;
    }
    vec2 hizSize = vec2(textureSize(u_hiz, 0));
    int maxLevel = min(textureQueryLevels(u_hiz) - 1, 7);
    vec3 origin = P + N * max(-P.z * 0.002, 0.005);
    float maxDistance = min(farPlane() * 0.5, 200.0);
    vec3 endP = origin + R * maxDistance;
    if (endP.z > -nearPlane) endP = origin + R * ((origin.z + nearPlane) / max(-R.z, 1e-4)) * 0.999;
    vec3 start = toScreen(origin, hizSize);
    vec3 end = toScreen(endP, hizSize);
    vec2 delta = end.xy - start.xy;
    float lengthPx = length(delta);
    if (lengthPx < 1.0) {
        imageStore(u_output, pixel, vec4(0.0));
        return;
    }
    vec2 dir = delta / lengthPx;
    float dzds = (end.z - start.z) / lengthPx;
    vec2 exitBias = vec2(dir.x >= 0.0 ? 1.0 : 0.0, dir.y >= 0.0 ? 1.0 : 0.0);
    vec2 invDir = vec2(abs(dir.x) > 1e-6 ? 1.0 / dir.x : 1e6, abs(dir.y) > 1e-6 ? 1.0 / dir.y : 1e6);
    float thickness = ssrParams.y;
    float s = 1.5;
    int level = 0;
    float hitS = -1.0;
    float hitWeight = 0.0;
    float occludedS = -1.0;
    for (int i = 0; i < MAX_ITERATIONS && s < lengthPx; ++i) {
        vec2 p = start.xy + dir * s;
        if (any(lessThan(p, vec2(0.0))) || any(greaterThanEqual(p, hizSize))) break;
        float cellSize = exp2(float(level));
        vec2 cell = floor(p / cellSize);
        vec2 boundary = (cell + exitBias) * cellSize;
        vec2 exitS = (boundary - p) * invDir;
        float sExit = s + max(min(exitS.x, exitS.y), 0.0) + 0.02;
        float zMin = texelFetch(u_hiz, min(ivec2(cell), textureSize(u_hiz, level) - 1), level).r;
        float zEntry = start.z + dzds * s;
        float zExit = start.z + dzds * min(sExit, lengthPx);
        if (max(zEntry, zExit) < zMin) {
            s = sExit;
            level = min(level + 1, maxLevel);
            continue;
        }
        if (level > 0) {
            --level;
            continue;
        }
        float sPlane = abs(dzds) > 1e-9 ? (zMin - start.z) / dzds : s;
        float sHit = clamp(sPlane, s, sExit);
        float rayLinear = linearViewDepth(start.z + dzds * sHit);
        float sceneLinear = linearViewDepth(zMin);
        float thick = thickness * max(sceneLinear * 0.05, 1.0);
        float behind = rayLinear - sceneLinear;
        if (behind < thick * 2.0) {
            float lo = max(s - 1.0, 0.0);
            float hi = sHit;
            vec2 fullScale = screenParams.xy / hizSize;
            for (int r = 0; r < 7; ++r) {
                float mid = 0.5 * (lo + hi);
                ivec2 fp = clamp(ivec2((start.xy + dir * mid) * fullScale), ivec2(0), ivec2(screenParams.xy) - 1);
                if (start.z + dzds * mid >= texelFetch(u_depth, fp, 0).r) hi = mid;
                else lo = mid;
            }
            hitS = hi;
            hitWeight = 1.0 - smoothstep(thick, thick * 2.0, behind);
            break;
        }
        if (occludedS < 0.0) occludedS = sHit;
        s = sExit;
    }
    bool occluded = false;
    if (hitS < 0.0 && occludedS >= 0.0) {
        hitS = occludedS;
        hitWeight = 1.0;
        occluded = true;
    }
    if (hitS < 0.0) {
        imageStore(u_output, pixel, vec4(0.0));
        return;
    }
    vec2 hitUv = (start.xy + dir * hitS) / hizSize;
    float hitDepth = textureLod(u_depth, hitUv, 0.0).r;
    if (hitDepth >= 1.0 || hitWeight <= 0.0) {
        imageStore(u_output, pixel, vec4(0.0));
        return;
    }
    vec3 hitN = normalize(mat3(view) * decodeNormal(textureLod(u_gbuffer1, hitUv, 0.0).rg));
    float backface = occluded ? 1.0 : 1.0 - smoothstep(0.0, 0.25, dot(hitN, R));
    if (backface <= 0.0) {
        imageStore(u_output, pixel, vec4(0.0));
        return;
    }
    vec3 hitWorld = worldFromDepth(hitUv, hitDepth);
    float previousDepth;
    vec2 previousUv = projectToUv(hitWorld, prevViewProjection, previousDepth);
    if (any(lessThan(previousUv, vec2(0.0))) || any(greaterThan(previousUv, vec2(1.0)))) {
        imageStore(u_output, pixel, vec4(0.0));
        return;
    }
    vec2 pyramidSize = vec2(textureSize(u_previousColor, 0));
    float alpha = roughness * roughness;
    float footprint = alpha * 1.5 * length((hitUv - uv) * pyramidSize);
    float lod = clamp(log2(max(footprint, 1.0)), 0.0, float(textureQueryLevels(u_previousColor) - 1));
    vec3 color = textureLod(u_previousColor, previousUv, lod).rgb / max(exposureData.x, 1e-12) * (occluded ? 0.45 : 1.0);
    vec2 edge = min(previousUv, 1.0 - previousUv);
    float edgeFade = smoothstep(0.0, 0.08, min(edge.x, edge.y));
    float roughFade = 1.0 - saturate((roughness - maxRoughness * 0.6) / (maxRoughness * 0.4));
    float travel = hitS / lengthPx;
    float distanceFade = 1.0 - saturate((travel - 0.6) / 0.4);
    float facing = saturate(-R.z * 4.0 + 1.0);
    imageStore(u_output, pixel, vec4(color, edgeFade * roughFade * distanceFade * facing * hitWeight * backface));
}
