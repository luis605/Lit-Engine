#version 450
#extension GL_GOOGLE_include_directive : require
#include "lighting_models.glsl"
#define CLOUD_TEXTURE
#include "sky.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

uniform sampler2D u_depth;
uniform sampler2D u_gbuffer0;
uniform sampler2D u_gbuffer1;
uniform usampler2D u_gbuffer2;
uniform sampler2D u_ao;
uniform sampler2D u_aoDepth;
uniform sampler2D u_bent;
uniform sampler3D u_aerial;

#include "sky_visibility.glsl"

layout(rgba16f) uniform image2D u_hdr;

layout(std430) readonly buffer ExposureBuffer {
    vec4 exposureData;
};

const int CONTACT_STEPS = 12;

vec3 heatmap(float t) {
    t = saturate(t);
    return saturate(vec3(1.5 - abs(4.0 * t - 3.0), 1.5 - abs(4.0 * t - 2.0), 1.5 - abs(4.0 * t - 1.0)));
}

vec3 applyAerial(vec3 color, vec2 uv, float distanceMeters) {
    if (fogParams.w <= 0.0 || int(skyParams.x + 0.5) != 0) return color;
    float slice = saturate(distanceMeters * 0.001 * fogParams.w / 32.0);
    vec4 ap = textureLod(u_aerial, vec3(uv, slice), 0.0);
    return color * ap.a + ap.rgb * sunToaIlluminance();
}

vec3 applyHeightFog(vec3 color, vec3 worldPos, vec3 skyColor) {
    float density = fogParams.x;
    if (density <= 0.0) return color;
    vec3 ray = worldPos - viewPos;
    float dist = length(ray);
    float falloff = max(fogParams.y, 1e-4);
    float h0 = viewPos.y - fogParams.z;
    float dh = ray.y;
    float integral = abs(dh) > 1e-3 ? (exp(-falloff * h0) - exp(-falloff * (h0 + dh))) / (falloff * dh) : exp(-falloff * h0);
    float fogAmount = 1.0 - exp(-density * dist * max(integral, 0.0));
    return mix(color, skyColor, saturate(fogAmount));
}

vec4 upsampleHalf(ivec2 pixel, float centerDepth, out vec3 bent) {
    ivec2 halfSize = textureSize(u_aoDepth, 0);
    vec2 position = vec2(pixel) * 0.5;
    ivec2 base = ivec2(floor(position));
    vec2 f = position - vec2(base);
    vec4 ao = vec4(0.0);
    vec3 bentSum = vec3(0.0);
    float total = 0.0;
    float tolerance = max(centerDepth * 0.03, 1e-3);
    for (int i = 0; i < 4; ++i) {
        ivec2 offset = ivec2(i & 1, i >> 1);
        ivec2 p = min(base + offset, halfSize - 1);
        float bilinear = (offset.x == 0 ? 1.0 - f.x : f.x) * (offset.y == 0 ? 1.0 - f.y : f.y);
        float w = (bilinear + 1e-3) * exp(-abs(texelFetch(u_aoDepth, p, 0).r - centerDepth) / tolerance);
        ao += texelFetch(u_ao, p, 0) * w;
        bentSum += (texelFetch(u_bent, p, 0).xyz * 2.0 - 1.0) * w;
        total += w;
    }
    bent = bentSum / max(total, 1e-6);
    return ao / max(total, 1e-6);
}

float contactShadow(vec3 worldPos, vec3 N, vec3 L, float viewDepth, float noise) {
    float rayLength = qualityParams.y;
    if (rayLength <= 0.0 || sunIlluminance.w <= 0.0 || dot(N, L) <= 0.0) return 1.0;
    vec3 start = worldPos + N * (0.01 + viewDepth * 0.0012);
    float thickness = max(rayLength * 0.4, 0.06);
    float occlusion = 0.0;
    for (int step = 0; step < CONTACT_STEPS; ++step) {
        float t = (float(step) + noise) / float(CONTACT_STEPS);
        vec3 position = start + L * (rayLength * t);
        vec4 clip = viewProjection * vec4(position, 1.0);
        if (clip.w <= 0.0) break;
        vec2 uv = vec2(clip.x / clip.w * 0.5 + 0.5, 0.5 - clip.y / clip.w * 0.5);
        if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) break;
        float sceneDepth = textureLod(u_depth, uv, 0.0).r;
        if (sceneDepth >= 1.0) continue;
        float difference = -(view * vec4(position, 1.0)).z - linearViewDepth(sceneDepth);
        float bias = 0.004 * viewDepth + 0.01;
        float hit = smoothstep(bias, bias * 2.0, difference) * (1.0 - smoothstep(thickness * 0.5, thickness, difference));
        occlusion = max(occlusion, hit * (1.0 - t * t));
    }
    return 1.0 - occlusion;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(screenParams.xy);
    if (any(greaterThanEqual(pixel, size))) return;
    vec2 uv = (vec2(pixel) + 0.5) * screenParams.zw;
    float depth = texelFetch(u_depth, pixel, 0).r;
    float exposure = exposureData.x;
    int debugMode = debugViewMode();
    if (depth >= 1.0) {
        vec3 dir = normalize(worldFromDepth(uv, 1.0) - viewPos);
        g_cloudUv = uv;
        vec3 sky = skyRadiance(dir, true) * exposureParams.x;
        vec3 skyOut = min(sky * exposure, vec3(60000.0));
        if (debugMode != 0 && debugMode != 7 && debugMode != 8) skyOut = vec3(0.02);
        imageStore(u_hdr, pixel, vec4(skyOut, 1.0));
        return;
    }
    vec3 worldPos = worldFromDepth(uv, depth);
    vec4 g0 = texelFetch(u_gbuffer0, pixel, 0);
    vec4 g1 = texelFetch(u_gbuffer1, pixel, 0);
    uvec4 g2 = texelFetch(u_gbuffer2, pixel, 0);
    int model = litDecodeModel(g1.a);
    if (model == LIT_UNLIT && debugMode == 0) return;
    vec3 N = decodeNormal(g1.rg);
    float roughness = g1.b;
    bool toon = model == LIT_TOON;
    float metallic = toon ? 0.0 : float(g2.x) / 255.0;
    float tangentAngle = toon ? 0.0 : float(g2.y) / 255.0;
    uint materialId = (g2.z | (g2.w << 8u)) & 0x7FFFu;
    float viewDepth = -(view * vec4(worldPos, 1.0)).z;
    vec4 aoGi = vec4(0.0, 0.0, 0.0, 1.0);
    vec3 bentNormal = N;
    if (renderFlags.x > 0.5) aoGi = upsampleHalf(pixel, viewDepth, bentNormal);
    float ao = aoGi.a;
    float occlusion = g0.a * ao;
    ShadingData s = prepareShading(worldPos, N, g0.rgb, metallic, roughness, occlusion, tangentAngle, materialId);
    s.indirectDiffuse = aoGi.rgb * g0.a;
    if (renderFlags.x > 0.5 && !toon) applyBentNormal(s, bentNormal, ao);
    float skyOpen = skyVisibility(worldPos, N, viewDepth, shadowNoise(vec2(pixel) + 17.0));
    s.occlusion *= skyOpen;
    s.specularOcclusion *= skyOpen;
    float sunVisibility;
    vec3 direct;
    vec3 ambient;
    if (toon) {
        LitToon toonParams = litDecodeToon(g2.xy);
        direct = litToonDirect(s, toonParams, vec2(pixel), viewDepth, sunVisibility);
        ambient = litToonAmbient(s, toonParams, sunVisibility);
    } else {
        g_contactShadow = contactShadow(worldPos, N, sunDirection.xyz, viewDepth, shadowNoise(vec2(pixel)));
        direct = evaluateSun(s, vec2(pixel), sunVisibility) + evaluateLights(s, vec2(pixel), viewDepth);
        ambient = evaluateIBL(s);
    }
    vec3 color = direct + ambient;
    float dist = length(worldPos - viewPos);
    color = applyAerial(color, uv, dist);
    if (fogParams.x > 0.0) color = applyHeightFog(color, worldPos, irradianceSH(normalize(worldPos - viewPos)) * 0.9);
    vec3 emissive = imageLoad(u_hdr, pixel).rgb;
    vec3 result = emissive + color * exposure;
    if (debugMode != 0) {
        vec3 d = vec3(0.0);
        if (debugMode == 1) d = g0.rgb;
        else if (debugMode == 2) d = N * 0.5 + 0.5;
        else if (debugMode == 3) d = vec3(roughness);
        else if (debugMode == 4) d = vec3(metallic);
        else if (debugMode == 5) d = vec3(occlusion);
        else if (debugMode == 6) d = vec3(sunVisibility);
        else if (debugMode == 8) d = (direct + ambient) * exposure / (s.diffuseColor + s.f0 + 0.04);
        else if (debugMode == 9) d = heatmap((log2(max(luminance(color), 1e-6)) + 6.0) / 24.0);
        else if (debugMode == 10) {
            uint cluster = clusterIndex(vec2(pixel), viewDepth);
            d = heatmap(float(clusterLights[cluster * CLUSTER_STRIDE]) / 16.0);
        }
        result = d;
    }
    imageStore(u_hdr, pixel, vec4(result, 1.0));
}