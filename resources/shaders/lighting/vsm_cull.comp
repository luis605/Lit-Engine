#version 450
#extension GL_GOOGLE_include_directive : require
#include "vsm_pass.glsl"
#include "renderable.glsl"
#include "mesh.glsl"
#include "material.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430) readonly buffer VsmFaceBuffer {
    VsmFace vsmFaces[];
};

layout(std430) readonly buffer VsmRenderList {
    uvec2 vsmRenderList[];
};

layout(std430) readonly buffer MeshInfoBuffer {
    MeshInfo meshInfos[];
};

layout(std430) readonly buffer CullSphereBuffer {
    vec4 cullSpheres[];
};

layout(std430) buffer VsmCounters {
    uint vsmCounters[];
};

layout(std430) writeonly buffer VsmInstances {
    uvec2 vsmInstances[];
};

layout(std430) buffer VsmBuckets {
    uint vsmBuckets[];
};

shared vec4 s_planes[6];
shared vec4 s_depthRow;
shared vec4 s_cut;
shared vec2 s_lod;

void main() {
    uint slot = gl_WorkGroupID.x;
    uint thread = gl_LocalInvocationIndex;
    if (thread == 0u) {
        VsmPage page = vsmDecodePage(vsmRenderList[slot].x);
        VsmFace f = vsmFaces[page.face];
        mat4 m = f.viewProjection;
        vec4 r0 = vec4(m[0][0], m[1][0], m[2][0], m[3][0]);
        vec4 r1 = vec4(m[0][1], m[1][1], m[2][1], m[3][1]);
        vec4 r2 = vec4(m[0][2], m[1][2], m[2][2], m[3][2]);
        vec4 r3 = vec4(m[0][3], m[1][3], m[2][3], m[3][3]);
        float n = float(1u << page.mip);
        float x0 = 2.0 * float(page.page.x) / n - 1.0;
        float x1 = 2.0 * float(page.page.x + 1u) / n - 1.0;
        float y1 = 1.0 - 2.0 * float(page.page.y) / n;
        float y0 = 1.0 - 2.0 * float(page.page.y + 1u) / n;
        vec4 planes[6] = vec4[](r0 - x0 * r3, x1 * r3 - r0, r1 - y0 * r3, y1 * r3 - r1, r2, r3 - r2);
        for (int i = 0; i < 6; ++i) s_planes[i] = planes[i] / max(length(planes[i].xyz), 1e-8);
        s_depthRow = r3;
        s_cut = f.clipPlane;
        s_lod = vec2(float(VSM_PAGE << page.mip) / (2.0 * f.info.x), vsmTuning.x);
    }
    barrier();
    vec4 planes[6] = s_planes;
    for (uint id = thread; id < vsmCounts.z; id += 64u) {
        vec4 sphere = cullSpheres[id];
        if (sphere.w <= 0.0) continue;
        bool inside = true;
        for (int i = 0; i < 6; ++i) inside = inside && dot(planes[i].xyz, sphere.xyz) + planes[i].w >= -sphere.w;
        if (!inside || dot(s_cut.xyz, sphere.xyz) + s_cut.w < -sphere.w) continue;
        uint renderable = renderables[id];
        uint flags = renderableFlags(renderable);
        uint material = renderableMaterial(renderable);
        if ((flags & (RENDER_HIDDEN | RENDER_TRANSLUCENT)) != 0u || renderableShader(renderable) >= vsmMisc.x || materialTranslucent(material)) continue;
        float depth = max(dot(s_depthRow, vec4(sphere.xyz, 1.0)), sphere.w);
        uint lod = min(lodForDiameter(2.0 * sphere.w * s_lod.x / depth * s_lod.y * 0.5), POINT_LOD - 1u);
        uint bucket = renderableMesh(renderable) + lod;
        if (bucket >= VSM_BUCKETS || meshInfos[bucket].indexCount == 0u) continue;
        uint instance = atomicAdd(vsmCounters[VSM_COUNTER_INSTANCES], 1u);
        if (instance >= vsmLimits.y) continue;
        vsmInstances[instance] = uvec2(id, slot | (bucket << 16u));
        atomicAdd(vsmBuckets[bucket], 1u);
    }
}
