#version 450
#extension GL_GOOGLE_include_directive : require
#include "scene.glsl"
#include "atmosphere.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba16f) writeonly uniform image2D u_output;

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(texel, ivec2(TRANSMITTANCE_LUT_SIZE)))) return;
    AtmosphereScales scales = AtmosphereScales(atmosphereParams.x, atmosphereParams.y, atmosphereParams.z, atmosphereParams.w, skyParams2.w);
    vec2 uv = (vec2(texel) + 0.5) / TRANSMITTANCE_LUT_SIZE;
    float r, mu;
    transmittanceParams(uv, r, mu);
    vec3 pos = vec3(0.0, r, 0.0);
    vec3 dir = vec3(sqrt(max(1.0 - mu * mu, 0.0)), mu, 0.0);
    float tMax = raySphere(pos, dir, ATM_TOP);
    vec3 opticalDepth = vec3(0.0);
    const int steps = 40;
    float dt = max(tMax, 0.0) / float(steps);
    for (int i = 0; i < steps; ++i) {
        vec3 p = pos + dir * (float(i) + 0.5) * dt;
        opticalDepth += sampleMedium(length(p) - ATM_BOTTOM, scales).extinction * dt;
    }
    imageStore(u_output, texel, vec4(exp(-opticalDepth), 1.0));
}
