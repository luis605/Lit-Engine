#version 450
#extension GL_GOOGLE_include_directive : require
#include "gi_upsample.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

uniform sampler2D u_depth;
uniform sampler2D u_gbuffer0;
uniform sampler2D u_gbuffer1;
uniform usampler2D u_gbuffer2;
layout(rgba16f) uniform image2D u_hdr;

const int MODEL_LIT = 0;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy) + viewRect.xy;
    if (any(greaterThanEqual(pixel, ivec2(screenParams.xy)))) return;
    if (debugViewMode() != 0) return;
    float depth = texelFetch(u_depth, pixel, 0).r;
    if (isSkyDepth(depth)) return;
    vec4 g1 = texelFetch(u_gbuffer1, pixel, 0);
    if (int(g1.a * 3.0 + 0.5) != MODEL_LIT) return;
    vec4 g0 = texelFetch(u_gbuffer0, pixel, 0);
    float metallic = float(texelFetch(u_gbuffer2, pixel, 0).x) / 255.0;
    vec3 diffuseColor = g0.rgb * (1.0 - metallic);
    vec3 gi = upsampleGi(pixel, linearViewDepth((vec2(pixel) + 0.5) * screenParams.zw, depth));
    if (all(equal(gi, vec3(0.0)))) return;
    vec3 shaded = imageLoad(u_hdr, pixel).rgb;
    imageStore(u_hdr, pixel, vec4(shaded + diffuseColor * g0.a * gi, 1.0));
}
