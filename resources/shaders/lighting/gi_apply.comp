#version 450
#extension GL_GOOGLE_include_directive : require
#include "scene.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

uniform sampler2D u_depth;
uniform sampler2D u_gbuffer0;
uniform sampler2D u_gbuffer1;
uniform usampler2D u_gbuffer2;
uniform sampler2D u_gi;
uniform sampler2D u_aoDepth;
layout(rgba16f) uniform image2D u_hdr;

const int MODEL_LIT = 0;

vec3 upsampleGi(ivec2 pixel, float centerDepth) {
    ivec2 halfSize = textureSize(u_aoDepth, 0);
    vec2 position = vec2(pixel) * 0.5;
    ivec2 base = ivec2(floor(position));
    vec2 f = position - vec2(base);
    vec3 sum = vec3(0.0);
    float total = 0.0;
    float tolerance = max(centerDepth * 0.03, 1e-3);
    for (int i = 0; i < 4; ++i) {
        ivec2 offset = ivec2(i & 1, i >> 1);
        ivec2 p = min(base + offset, halfSize - 1);
        float bilinear = (offset.x == 0 ? 1.0 - f.x : f.x) * (offset.y == 0 ? 1.0 - f.y : f.y);
        float w = (bilinear + 1e-3) * exp(-abs(texelFetch(u_aoDepth, p, 0).r - centerDepth) / tolerance);
        sum += texelFetch(u_gi, p, 0).rgb * w;
        total += w;
    }
    return sum / max(total, 1e-6);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy) + viewRect.xy;
    if (any(greaterThanEqual(pixel, ivec2(screenParams.xy)))) return;
    if (debugViewMode() != 0) return;
    float depth = texelFetch(u_depth, pixel, 0).r;
    if (isSkyDepth(depth)) return;
    vec4 g1 = texelFetch(u_gbuffer1, pixel, 0);
    if (int(g1.a * 3.0 + 0.5) != MODEL_LIT) return;
    vec4 g0 = texelFetch(u_gbuffer0, pixel, 0);
    float metallic = float(texelFetch(u_gbuffer2, pixel, 0).x) / 255.0;
    vec3 diffuseColor = g0.rgb * (1.0 - metallic);
    vec3 gi = upsampleGi(pixel, linearViewDepth(depth));
    if (all(equal(gi, vec3(0.0)))) return;
    vec3 shaded = imageLoad(u_hdr, pixel).rgb;
    imageStore(u_hdr, pixel, vec4(shaded + diffuseColor * g0.a * gi, 1.0));
}
