#version 450
#extension GL_GOOGLE_include_directive : require
#include "sky.glsl"
#include "cubemap.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba16f) writeonly uniform image2DArray u_output;

void main() {
    uvec3 id = gl_GlobalInvocationID;
    int size = imageSize(u_output).x;
    if (id.x >= uint(size) || id.y >= uint(size)) return;
    vec3 dir = cubeDirection(id.z, (vec2(id.xy) + 0.5) / float(size));
    vec3 L = skyRadiance(dir, false);
    imageStore(u_output, ivec3(id), vec4(min(L * ENV_SCALE, vec3(60000.0)), 1.0));
}
