#version 450
#extension GL_GOOGLE_include_directive : require
#include "scene.glsl"
#include "atmosphere.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba16f) writeonly uniform image2D u_output;
uniform sampler2D u_transmittanceLut;
uniform sampler2D u_multiScatterLut;

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(texel, ivec2(SKYVIEW_LUT_SIZE)))) return;
    AtmosphereScales scales = AtmosphereScales(atmosphereParams.x, atmosphereParams.y, atmosphereParams.z, atmosphereParams.w, skyParams2.w);
    vec2 uv = (vec2(texel) + 0.5) / SKYVIEW_LUT_SIZE;
    uv = (uv * SKYVIEW_LUT_SIZE - 0.5) / (SKYVIEW_LUT_SIZE - 1.0);
    vec3 camPos = atmospherePosition(viewPos);
    float viewHeight = length(camPos);
    float vHorizon = sqrt(max(viewHeight * viewHeight - ATM_BOTTOM * ATM_BOTTOM, 0.0));
    float beta = acos(clamp(vHorizon / viewHeight, -1.0, 1.0));
    float zenithHorizonAngle = PI - beta;
    float viewZenithCos;
    if (uv.y < 0.5) {
        float coord = 1.0 - 2.0 * uv.y;
        coord = 1.0 - coord * coord;
        viewZenithCos = cos(zenithHorizonAngle * coord);
    } else {
        float coord = uv.y * 2.0 - 1.0;
        coord *= coord;
        viewZenithCos = cos(zenithHorizonAngle + beta * coord);
    }
    float lightCoord = uv.x * uv.x;
    float lightViewCos = -(lightCoord * 2.0 - 1.0);
    float viewZenithSin = sqrt(max(1.0 - viewZenithCos * viewZenithCos, 0.0));
    vec3 dir = vec3(viewZenithSin * lightViewCos, viewZenithCos, viewZenithSin * sqrt(max(1.0 - lightViewCos * lightViewCos, 0.0)));
    vec3 up = camPos / viewHeight;
    float sunZenithCos = dot(sunDirection.xyz, up);
    vec3 sunDir = vec3(sqrt(max(1.0 - sunZenithCos * sunZenithCos, 0.0)), sunZenithCos, 0.0);
    vec3 pos = vec3(0.0, viewHeight, 0.0);
    vec3 transmittance;
    vec3 L = integrateScattering(pos, dir, sunDir, 9000.0, 30, scales, u_transmittanceLut, u_multiScatterLut, true, transmittance);
    imageStore(u_output, texel, vec4(L, 1.0));
}
