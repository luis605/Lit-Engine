#version 450
#extension GL_GOOGLE_include_directive : require
#include "scene.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

uniform sampler2D u_depth;
uniform sampler2D u_input;
layout(r16f) writeonly uniform image2D u_output;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(screenParams.xy);
    if (any(greaterThanEqual(pixel, size))) return;
    float depth = texelFetch(u_depth, pixel, 0).r;
    if (depth >= 1.0) {
        imageStore(u_output, pixel, vec4(1.0));
        return;
    }
    float center = linearViewDepth(depth);
    ivec2 halfSize = textureSize(u_input, 0);
    ivec2 base = pixel / 2;
    float sum = 0.0;
    float weight = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 p = clamp(base + ivec2(x, y), ivec2(0), halfSize - 1);
            vec2 sampleValue = texelFetch(u_input, p, 0).rg;
            vec2 offset = vec2(p * 2) + 0.5 - vec2(pixel);
            float w = exp(-abs(sampleValue.g - center) / max(center * 0.03, 1e-3)) * exp(-dot(offset, offset) * 0.12);
            sum += sampleValue.r * w;
            weight += w;
        }
    }
    imageStore(u_output, pixel, vec4(weight > 1e-4 ? sum / weight : 1.0));
}
