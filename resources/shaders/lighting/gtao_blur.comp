#version 450
#extension GL_GOOGLE_include_directive : require
#include "scene.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

uniform sampler2D u_linearDepth;
uniform sampler2D u_input;
uniform sampler2D u_bentInput;
layout(rgba16f) writeonly uniform image2D u_output;
layout(rgba8) writeonly uniform image2D u_bentOutput;

const int RADIUS_BY_QUALITY[4] = int[](0, 2, 4, 6);
const float NORMAL_SLOPE_LIMIT = 0.5;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_output);
    if (any(greaterThanEqual(pixel, size))) return;
    float center = texelFetch(u_linearDepth, pixel, 0).r;
    int radius = RADIUS_BY_QUALITY[clamp(int(qualityParams2.x + 0.5), 0, 3)];
#ifdef VERTICAL
    ivec2 axis = ivec2(0, 1);
#else
    ivec2 axis = ivec2(1, 0);
#endif
    float tolerance = max(center * 0.03, 1e-3);
    float before = texelFetch(u_linearDepth, clamp(pixel - axis, ivec2(0), size - 1), 0).r;
    float after = texelFetch(u_linearDepth, clamp(pixel + axis, ivec2(0), size - 1), 0).r;
    float slopeBefore = center - before;
    float slopeAfter = after - center;
    float slope = abs(slopeBefore) < abs(slopeAfter) ? slopeBefore : slopeAfter;
    if (abs(slopeBefore - slopeAfter) > tolerance * NORMAL_SLOPE_LIMIT) slope = 0.0;
    vec4 sum = texelFetch(u_input, pixel, 0);
    vec3 bentSum = texelFetch(u_bentInput, pixel, 0).xyz;
    float weight = 1.0;
    float sigma = max(float(radius) * 0.5, 0.5);
    for (int i = -radius; i <= radius; ++i) {
        if (i == 0) continue;
        ivec2 p = clamp(pixel + axis * i, ivec2(0), size - 1);
        float d = texelFetch(u_linearDepth, p, 0).r;
        float expected = center + slope * float(i);
        float spatial = exp(-0.5 * float(i * i) / (sigma * sigma));
        float w = spatial * exp(-abs(d - expected) / tolerance);
        sum += texelFetch(u_input, p, 0) * w;
        bentSum += texelFetch(u_bentInput, p, 0).xyz * w;
        weight += w;
    }
    imageStore(u_output, pixel, sum / weight);
    imageStore(u_bentOutput, pixel, vec4(bentSum / weight, 1.0));
}
