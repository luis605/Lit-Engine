#version 450
#extension GL_GOOGLE_include_directive : require
#include "lighting_models.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

uniform sampler2D u_depth;
uniform sampler2D u_gbuffer0;
uniform sampler2D u_gbuffer1;
uniform usampler2D u_gbuffer2;

layout(rgba32f) writeonly uniform image2D u_localLightOutput;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy) + viewRect.xy;
    if (any(greaterThanEqual(pixel, ivec2(screenParams.xy)))) return;
    float depth = texelFetch(u_depth, pixel, 0).r;
    if (isSkyDepth(depth)) return;
    vec4 g1 = texelFetch(u_gbuffer1, pixel, 0);
    int model = litDecodeModel(g1.a);
    if (model == LIT_TOON || (model == LIT_UNLIT && debugViewMode() == 0)) return;
    vec2 uv = (vec2(pixel) + 0.5) * screenParams.zw;
    vec3 worldPos = worldFromDepth(uv, depth);
    vec4 g0 = texelFetch(u_gbuffer0, pixel, 0);
    uvec4 g2 = texelFetch(u_gbuffer2, pixel, 0);
    uint materialId = (g2.z | (g2.w << 8u)) & 0x7FFFu;
    float viewDepth = -(view * vec4(worldPos, 1.0)).z;
    ShadingData s = prepareShading(worldPos, decodeNormal(g1.rg), g0.rgb, float(g2.x) / 255.0, g1.b, 1.0, float(g2.y) / 255.0, materialId);
#ifdef LIT_BASE_LOBES_ONLY
    s.anisotropy = 0.0;
    s.sheenColor = vec3(0.0);
    s.clearcoat = 0.0;
    s.subsurface = 0.0;
#endif
    imageStore(u_localLightOutput, pixel, vec4(evaluateLights(s, vec2(pixel), viewDepth), 0.0));
}
