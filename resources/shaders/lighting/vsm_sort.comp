#version 450
#extension GL_GOOGLE_include_directive : require
#include "vsm_pass.glsl"
#include "mesh.glsl"

#ifdef COMMANDS
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
#else
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
#endif

layout(std430) readonly buffer VsmCounters {
    uint vsmCounters[];
};

#ifdef COMMANDS
layout(std430) readonly buffer VsmGroupDraws {
    uint vsmGroupDraws[];
};

layout(std430) buffer VsmDrawCommands {
    DrawElementsIndirectCommand vsmCommands[];
};

layout(std430) buffer VsmPairCounts {
    uint vsmPairCounts[];
};

layout(std430) writeonly buffer VsmPairBases {
    uint vsmPairBases[];
};

layout(std430) buffer VsmArgs {
    uint vsmArgs[];
};

void main() {
    uint group = gl_WorkGroupID.x;
    uint groupStart = group * VSM_BUCKETS;
    uint draws = vsmGroupDraws[group];
    for (uint draw = gl_LocalInvocationIndex; draw < draws; draw += 64u) {
        uint command = groupStart + draw;
        uint pair = groupStart + vsmCommands[command].baseInstance;
        uint count = vsmPairCounts[pair];
        vsmPairCounts[pair] = 0u;
        uint first = atomicAdd(vsmArgs[VSM_ARGS_INSTANCE_CURSOR], count);
        vsmPairBases[pair] = first;
        vsmCommands[command].instanceCount = count;
        vsmCommands[command].baseInstance = first;
    }
    if (group == 0u && gl_LocalInvocationIndex == 0u) {
        uint instances = min(vsmCounters[VSM_COUNTER_INSTANCES], vsmLimits.y);
        vsmArgs[VSM_ARGS_SCATTER + 0u] = (instances + 255u) / 256u;
        vsmArgs[VSM_ARGS_SCATTER + 1u] = 1u;
        vsmArgs[VSM_ARGS_SCATTER + 2u] = 1u;
    }
}

#else
layout(std430) readonly buffer VsmInstances {
    uvec4 vsmInstances[];
};

layout(std430) readonly buffer VsmPairBases {
    uint vsmPairBases[];
};

layout(std430) writeonly buffer VsmSortedInstances {
    uvec2 vsmSorted[];
};

void main() {
    uint instance = gl_GlobalInvocationID.x;
    if (instance >= min(vsmCounters[VSM_COUNTER_INSTANCES], vsmLimits.y)) return;
    uvec4 entry = vsmInstances[instance];
    vsmSorted[vsmPairBases[entry.z] + entry.w] = entry.xy;
}
#endif
