#version 450
#extension GL_GOOGLE_include_directive : require
#include "brdf.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba16f) writeonly uniform image2D u_output;

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_output);
    if (any(greaterThanEqual(texel, size))) return;
    float NoV = max((float(texel.x) + 0.5) / float(size.x), 1e-3);
    float perceptualRoughness = max((float(texel.y) + 0.5) / float(size.y), 0.02);
    float a = perceptualRoughness * perceptualRoughness;
    vec3 V = vec3(sqrt(1.0 - NoV * NoV), 0.0, NoV);
    const uint SAMPLES = 512u;
    float A = 0.0;
    float B = 0.0;
    float C = 0.0;
    for (uint i = 0u; i < SAMPLES; ++i) {
        vec2 xi = hammersley(i, SAMPLES);
        vec3 H = importanceSampleGGX(xi, a);
        vec3 L = 2.0 * dot(V, H) * H - V;
        float NoL = saturate(L.z);
        float NoH = saturate(H.z);
        float VoH = saturate(dot(V, H));
        if (NoL > 0.0) {
            float visibility = V_SmithGGXCorrelated(NoV, NoL, a) * 4.0 * NoL * VoH / max(NoH, 1e-4);
            float Fc = pow5(1.0 - VoH);
            A += (1.0 - Fc) * visibility;
            B += Fc * visibility;
        }
        float phi = TWO_PI * xi.x;
        float cosTheta = 1.0 - xi.y;
        float sinTheta = sqrt(1.0 - cosTheta * cosTheta);
        vec3 Lu = vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);
        vec3 Hu = normalize(V + Lu);
        float NoLu = saturate(Lu.z);
        C += D_Charlie(perceptualRoughness, saturate(Hu.z)) * V_Neubelt(NoV, NoLu) * NoLu * TWO_PI;
    }
    imageStore(u_output, texel, vec4(A / float(SAMPLES), B / float(SAMPLES), C / float(SAMPLES), 1.0));
}
