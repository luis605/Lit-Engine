#version 450
#extension GL_GOOGLE_include_directive : require
#include "brdf.glsl"
#include "reflection.glsl"
#include "material.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

uniform sampler2D u_depth;
uniform sampler2D u_gbuffer0;
uniform sampler2D u_gbuffer1;
uniform usampler2D u_gbuffer2;
uniform sampler2D u_ao;
uniform sampler2D u_ssr;
uniform sampler2D u_dfgLut;
uniform samplerCube u_prefilteredEnv;
uniform samplerCubeArray u_probes;
uniform usampler2D u_planarDepth;
uniform sampler2D u_planarColor;

#include "sky_visibility.glsl"

layout(rgba16f) uniform image2D u_hdr;

layout(std430) readonly buffer ExposureBuffer {
    vec4 exposureData;
};

const float PREFILTER_MIP_COUNT = 6.0;
const uint EMPTY_KEY = 0xFFFFFFFFu;
const float PLANAR_BLUR_TEXELS = 6.0;
const float PLANE_TOLERANCE_BASE = 0.03;
const float PLANE_TOLERANCE_SLOPE = 0.003;
const float PLANE_EDGE_FEATHER = 1.0;
const float PLANE_ALIGNMENT_LOW = 0.9;
const float PLANE_ALIGNMENT_HIGH = 0.98;
const float SURFACE_NORMAL_BIAS = 0.02;
const float MIN_PERCEPTUAL_ROUGHNESS = 0.045;
const int DEBUG_REFLECTIONS = 7;
const int MODEL_LIT = 0;
const ivec2 PLANAR_TAPS[5] = ivec2[](ivec2(0, 0), ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1));

vec3 environmentRadiance(vec3 direction, float perceptualRoughness) {
    return textureLod(u_prefilteredEnv, direction, perceptualRoughness * (PREFILTER_MIP_COUNT - 1.0)).rgb * REFLECT_ENV_DECODE * skyGradient[1].w;
}

float planarMask(vec3 worldPosition, vec3 normal) {
    vec3 planeUp = planeNormal.xyz;
    vec3 offset = worldPosition - planeCenter.xyz;
    float height = abs(dot(offset, planeUp));
    float tolerance = PLANE_TOLERANCE_BASE + PLANE_TOLERANCE_SLOPE * length(worldPosition - viewPos);
    float alignment = smoothstep(PLANE_ALIGNMENT_LOW, PLANE_ALIGNMENT_HIGH, dot(normal, planeUp));
    vec3 axisV = cross(planeUp, planeAxisU.xyz);
    vec2 local = vec2(dot(offset, planeAxisU.xyz), dot(offset, axisV));
    vec2 inside = vec2(planeCenter.w, planeNormal.w) - abs(local);
    float edge = saturate(min(inside.x, inside.y) / PLANE_EDGE_FEATHER);
    return (1.0 - smoothstep(tolerance, tolerance * 2.0, height)) * alignment * edge;
}

vec4 samplePlanar(vec2 uv, float perceptualRoughness) {
    ivec2 size = textureSize(u_planarDepth, 0);
    ivec2 center = clamp(ivec2(uv * vec2(size)), ivec2(0), size - 1);
    int radius = max(int(perceptualRoughness * PLANAR_BLUR_TEXELS), 1);
    vec3 sum = vec3(0.0);
    float valid = 0.0;
    for (int tap = 0; tap < 5; ++tap) {
        ivec2 position = clamp(center + PLANAR_TAPS[tap] * radius, ivec2(0), size - 1);
        if (texelFetch(u_planarDepth, position, 0).r != EMPTY_KEY) {
            sum += texelFetch(u_planarColor, position, 0).rgb;
            valid += 1.0;
        }
    }
    return vec4(sum / max(valid, 1.0), saturate(valid * 0.5));
}

const float UPSAMPLE_DEPTH_SHARPNESS = 400.0;
const float UPSAMPLE_MIN_WEIGHT = 1.0e-4;

vec4 upsampleSsr(ivec2 pixel, float depth) {
    ivec2 ssrSize = textureSize(u_ssr, 0);
    ivec2 fullSize = ivec2(screenParams.xy);
    vec2 position = (vec2(pixel) + 0.5) * 0.5 - 0.5;
    ivec2 base = ivec2(floor(position));
    vec2 fraction = position - vec2(base);
    float linearCenter = linearViewDepth(depth);
    vec4 sum = vec4(0.0);
    float total = 0.0;
    for (int index = 0; index < 4; ++index) {
        ivec2 offset = ivec2(index & 1, index >> 1);
        ivec2 texel = clamp(base + offset, ivec2(0), ssrSize - 1);
        ivec2 source = min(texel * 2 + ivec2(1), fullSize - 1);
        float sourceDepth = linearViewDepth(texelFetch(u_depth, source, 0).r);
        float bilinear = (offset.x == 1 ? fraction.x : 1.0 - fraction.x) * (offset.y == 1 ? fraction.y : 1.0 - fraction.y);
        float similarity = exp(-abs(sourceDepth - linearCenter) / max(linearCenter, 1.0e-3) * UPSAMPLE_DEPTH_SHARPNESS);
        float weight = bilinear * similarity + UPSAMPLE_MIN_WEIGHT;
        vec4 ssrTexel = texelFetch(u_ssr, texel, 0);
        sum += vec4(ssrTexel.rgb * ssrTexel.a, ssrTexel.a) * weight;
        total += weight;
    }
    return vec4(sum.rgb / max(sum.a, 1.0e-6), sum.a / total);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, ivec2(screenParams.xy)))) return;
    int debugMode = debugViewMode();
    if (debugMode != 0 && debugMode != DEBUG_REFLECTIONS) return;
    float depth = texelFetch(u_depth, pixel, 0).r;
    if (depth >= 1.0) return;
    vec4 g1 = texelFetch(u_gbuffer1, pixel, 0);
    if (int(g1.a * 3.0 + 0.5) != MODEL_LIT) return;
    vec2 uv = (vec2(pixel) + 0.5) * screenParams.zw;
    vec3 worldPosition = worldFromDepth(uv, depth);
    vec4 g0 = texelFetch(u_gbuffer0, pixel, 0);
    uvec4 g2 = texelFetch(u_gbuffer2, pixel, 0);
    vec3 N = decodeNormal(g1.rg);
    float perceptualRoughness = clamp(g1.b, MIN_PERCEPTUAL_ROUGHNESS, 1.0);
    float metallic = float(g2.x) / 255.0;
    uint materialId = (g2.z | (g2.w << 8u)) & 0x7FFFu;
    vec3 V = normalize(viewPos - worldPosition);
    float NoV = max(dot(N, V), 1e-4);
    vec3 R = reflect(-V, N);
    float reflectance = materials[materialId].pbr.z;
    vec3 f0 = vec3(0.16 * reflectance * reflectance) * (1.0 - metallic) + g0.rgb * metallic;
    vec3 dfg = textureLod(u_dfgLut, vec2(NoV, perceptualRoughness), 0.0).rgb;
    vec3 fresnelWeight = f0 * dfg.x + dfg.y;
    float ambientOcclusion = renderFlags.x > 0.5 ? textureLod(u_ao, uv, 0.0).a : 1.0;
    float specularOcclusion = specularOcclusionLagarde(NoV, g0.a * ambientOcclusion, perceptualRoughness * perceptualRoughness);
    float exposure = exposureData.x;
    float viewDepth = -(view * vec4(worldPosition, 1.0)).z;
    float skyOpen = skyVisibility(worldPosition, N, viewDepth, interleavedGradientNoise(vec2(pixel) + 17.0, 0.0));
    float skyAttenuation = mix(skyOpen, skyOpen * skyOpen, perceptualRoughness);
    vec3 environmentSample = environmentRadiance(R, perceptualRoughness) * exposure;
    vec3 skyBase = environmentSample * skyOpen;
    vec3 reflected = environmentSample * skyAttenuation;

    if (reflectionFeature(FEATURE_PROBES)) {
        float probeWeight;
        int probe = strongestProbe(worldPosition, probeWeight);
        if (probe >= 0) {
            vec3 projected = boxProject(worldPosition, R, probeCenter[probe].xyz, probeExtent[probe].xyz);
            float probeMip = perceptualRoughness * (PROBE_MIP_COUNT - 1.0);
            vec3 probeRadiance = textureLod(u_probes, vec4(projected, float(probe)), probeMip).rgb * REFLECT_ENV_DECODE * probeCenter[probe].w * skyGradient[1].w * exposure;
            reflected = mix(reflected, probeRadiance, probeWeight);
        }
    }

    vec4 ssr = reflectionFeature(FEATURE_SSR) ? upsampleSsr(pixel, depth) : vec4(0.0);
    float maxRoughness = reflectionMaxRoughness();
    float traceable = 1.0 - smoothstep(maxRoughness * 0.5, maxRoughness, perceptualRoughness);
    if (reflectionFeature(FEATURE_WORLD) && voxelsValid() && ssr.a < 0.999 && traceable > 0.0) {
        float traceDistance = voxelMin.w;
        vec3 traceOrigin = worldPosition + N * SURFACE_NORMAL_BIAS;
        VoxelHit hit = traceVoxels(traceOrigin, R, traceDistance, reflectionVoxelSteps());
        if (hit.hit) {
            float refined = refineVoxelHit(traceOrigin, R, hit);
            vec3 hitPosition = traceOrigin + R * refined;
            vec3 hitNormal = voxelSurfaceNormal(hitPosition, hit.normal);
            vec3 ambient = textureLod(u_prefilteredEnv, hitNormal, VOXEL_AMBIENT_MIP).rgb * skyGradient[1].w;
            vec3 radiance = voxelRadianceScaled(hit.albedo, hitNormal, ambient) * REFLECT_ENV_DECODE * exposure;
            float distanceFade = 1.0 - saturate(refined / max(traceDistance, 1.0));
            float boundsFade = voxelEdgeFade(worldPosition);
            reflected = mix(reflected, radiance, traceable * distanceFade * boundsFade);
        }
    }

    float planarWeight = 0.0;
    if (reflectionFeature(FEATURE_PLANAR) && planarActive()) {
        float mask = planarMask(worldPosition, N);
        if (mask > 0.0) {
            vec4 planar = samplePlanar(uv, perceptualRoughness);
            planarWeight = planar.a * mask;
            reflected = mix(reflected, planar.rgb, planarWeight);
        }
    }

    reflected = mix(reflected, ssr.rgb, ssr.a * (1.0 - planarWeight));
    if (debugMode == DEBUG_REFLECTIONS) {
        imageStore(u_hdr, pixel, vec4(reflected * fresnelWeight * specularOcclusion, 1.0));
        return;
    }
    vec3 delta = (reflected - skyBase) * fresnelWeight * specularOcclusion * reflectionIntensity();
    if (all(equal(delta, vec3(0.0)))) return;
    vec3 shaded = imageLoad(u_hdr, pixel).rgb;
    imageStore(u_hdr, pixel, vec4(max(shaded + delta, vec3(0.0)), 1.0));
}
