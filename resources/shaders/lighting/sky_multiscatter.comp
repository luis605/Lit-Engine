#version 450
#extension GL_GOOGLE_include_directive : require
#include "scene.glsl"
#include "atmosphere.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(rgba16f) writeonly uniform image2D u_output;
uniform sampler2D u_transmittanceLut;

shared vec3 s_luminance[64];
shared vec3 s_fms[64];

void main() {
    ivec2 texel = ivec2(gl_WorkGroupID.xy);
    uint index = gl_LocalInvocationID.x;
    AtmosphereScales scales = AtmosphereScales(atmosphereParams.x, atmosphereParams.y, atmosphereParams.z, atmosphereParams.w, skyParams2.w);
    vec2 uv = (vec2(texel) + 0.5) / MULTISCATTER_LUT_SIZE;
    float sunZenithCos = uv.x * 2.0 - 1.0;
    float r = mix(ATM_BOTTOM + 0.01, ATM_TOP - 0.01, uv.y);
    vec3 pos = vec3(0.0, r, 0.0);
    vec3 sunDir = vec3(sqrt(max(1.0 - sunZenithCos * sunZenithCos, 0.0)), sunZenithCos, 0.0);
    float u = (float(index % 8u) + 0.5) / 8.0;
    float v = (float(index / 8u) + 0.5) / 8.0;
    float theta = TWO_PI * u;
    float phi = acos(1.0 - 2.0 * v);
    vec3 dir = vec3(cos(theta) * sin(phi), cos(phi), sin(theta) * sin(phi));

    float tBottom = raySphere(pos, dir, ATM_BOTTOM);
    float tTop = raySphere(pos, dir, ATM_TOP);
    float tMax = tBottom >= 0.0 ? tBottom : tTop;
    const int steps = 20;
    const float uniformPhase = 1.0 / (4.0 * PI);
    vec3 luminance = vec3(0.0);
    vec3 fms = vec3(0.0);
    vec3 throughput = vec3(1.0);
    float dt = max(tMax, 0.0) / float(steps);
    for (int i = 0; i < steps; ++i) {
        vec3 p = pos + dir * (float(i) + 0.5) * dt;
        float h = length(p);
        vec3 up = p / h;
        Medium m = sampleMedium(h - ATM_BOTTOM, scales);
        vec3 sampleT = exp(-m.extinction * dt);
        vec3 sunT = transmittanceFromLut(u_transmittanceLut, h, dot(sunDir, up));
        float earthShadow = raySphere(p + up * 0.01, sunDir, ATM_BOTTOM) >= 0.0 ? 0.0 : 1.0;
        vec3 S = earthShadow * sunT * m.scattering * uniformPhase;
        vec3 ext = max(m.extinction, vec3(1e-7));
        luminance += throughput * (S - S * sampleT) / ext;
        fms += throughput * (m.scattering - m.scattering * sampleT) / ext;
        throughput *= sampleT;
    }
    if (tBottom >= 0.0) {
        vec3 p = pos + dir * tBottom;
        vec3 up = normalize(p);
        vec3 sunT = transmittanceFromLut(u_transmittanceLut, length(p), dot(sunDir, up));
        luminance += throughput * sunT * saturate(dot(up, sunDir)) * scales.groundAlbedo * INV_PI;
    }
    s_luminance[index] = luminance / 64.0;
    s_fms[index] = fms / 64.0;
    barrier();
    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
        if (index < stride) {
            s_luminance[index] += s_luminance[index + stride];
            s_fms[index] += s_fms[index + stride];
        }
        barrier();
    }
    if (index == 0u) {
        vec3 L2 = s_luminance[0];
        vec3 f = s_fms[0];
        imageStore(u_output, texel, vec4(L2 / max(1.0 - f, vec3(1e-3)), 1.0));
    }
}
