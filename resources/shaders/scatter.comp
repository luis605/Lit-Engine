#version 450
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct RenderableComponent {
    uint mesh_uuid;
    uint material_uuid;
    uint shaderId;
    uint objectId;
    float alpha;
    uint flags;
};

layout(std140) uniform ScatterConstants {
    uint u_maxDraws;
};

layout(std430) readonly buffer AtomicCounterBuffer {
    uint u_visibleCount;
};

layout(std430) readonly buffer VisibleObjectBuffer {
    uvec2 u_visibleObjects[];
};

layout(std430) buffer BucketWriteHeadBuffer {
    uint bucketWriteHeads[];
};

layout(std430) writeonly buffer SortedVisibleObjectBuffer {
    uint sortedVisibleIndices[];
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    bool pending = idx < u_visibleCount && idx < u_maxDraws;
    uvec2 entry = pending ? u_visibleObjects[idx] : uvec2(0u);
    uint slot = 0u;

    while (subgroupBallotBitCount(subgroupBallot(pending)) > 0u) {
        if (pending) {
            uint key = subgroupBroadcastFirst(entry.y);
            uvec4 same = subgroupBallot(entry.y == key);
            uint base = 0u;
            if (subgroupElect()) base = atomicAdd(bucketWriteHeads[key], subgroupBallotBitCount(same));
            base = subgroupBroadcastFirst(base);
            if (entry.y == key) {
                slot = base + subgroupBallotExclusiveBitCount(same);
                pending = false;
            }
        }
    }

    if (idx < u_visibleCount && idx < u_maxDraws) sortedVisibleIndices[slot] = entry.x;
}
