#version 450 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std140, binding = 0) uniform AnimConstants {
    float u_time;
    uint u_movingCount;
    uint u_entityOffset;
    float u_padding;
};

layout(std430, binding = 1) readonly buffer BasePositionBuffer {
    vec4 g_basePositions[];
};

layout(std430, binding = 2) buffer TransformBuffer {
    mat4 g_localMatrices[];
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= u_movingCount) return;

    // Same arithmetic as three separate scalar mul-adds (fi * 1.0 == fi exactly), packed into one
    // vec3 mul-add pair so the three phase arguments are built with vector ops instead of six
    // scalar ones. Only the transcendentals stay scalar.
    vec3 args = u_time * vec3(1.3, 0.9, 0.7) + float(idx) * vec3(1.0, 0.5, 0.25);
    vec3 offset = vec3(sin(args.x), cos(args.y), sin(args.z)) * 2.0;

    g_localMatrices[idx + u_entityOffset][3].xyz = g_basePositions[idx].xyz + offset;
}