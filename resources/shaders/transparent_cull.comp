#version 450
#extension GL_GOOGLE_include_directive : require
#include "scene.glsl"
#include "mesh.glsl"
#include "hiz.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct VisibleTransparentObject {
    uint objectId;
    float distance;
};

layout(std140) uniform TransparentCullUniforms {
    uint u_objectCount;
    uint u_maxDraws;
    float u_lodBias;
    int u_forcedLod;
    vec3 u_cameraPos;
    float u_padding3;
};

layout(std430) buffer AtomicCounterBuffer {
    uint u_atomicCounter;
};

layout(std430) writeonly buffer VisibleTransparentObjectBuffer {
    VisibleTransparentObject u_visibleTransparentObjects[];
};

layout(std430) readonly buffer CullSphereBuffer {
    vec4 cullSpheres[];
};

layout(std430) readonly buffer TransparentIdBuffer {
    uint transparentIds[];
};

const float TRANSPARENT_LOD_DIAMETER_PX[LOD_LEVEL_COUNT - 1u] = float[](60.0, 40.0, 25.0, 8.0, 3.0, 1.5);

uint selectLod(float radius, float dist) {
    if (u_forcedLod >= 0) return min(uint(u_forcedLod), POINT_LOD);
    if (dist <= radius) return 0u;
    float diameterPx = u_lodBias * projectedDiameterPx(radius, dist);
    for (uint lod = 0u; lod < POINT_LOD; ++lod) {
        if (diameterPx >= TRANSPARENT_LOD_DIAMETER_PX[lod]) return lod;
    }
    return POINT_LOD;
}

void main() {
    uint listIndex = gl_GlobalInvocationID.x;
    if (listIndex >= u_objectCount) return;
    uint id = transparentIds[listIndex];

    vec4 boundingSphere = cullSpheres[id];
    if (boundingSphere.w < 0.0) return;
    vec3 worldCenter = boundingSphere.xyz;
    float radius = boundingSphere.w;

    for (int i = 0; i < 6; ++i) {
        if (dot(frustumPlanes[i].xyz, worldCenter) + frustumPlanes[i].w < -radius) return;
    }

    vec4 viewPosCenter = view * vec4(worldCenter, 1.0);
    float dist = -viewPosCenter.z;
    if (dist <= 0.0) dist = 0.001;

    if (sphereOccluded(worldCenter, radius)) return;

    uint slot = atomicAdd(u_atomicCounter, 1);
    if (slot < u_maxDraws) {
        u_visibleTransparentObjects[slot].objectId = id | (selectLod(radius, dist) << 29u);
        u_visibleTransparentObjects[slot].distance = dist;
    }
}