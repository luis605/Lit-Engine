#version 450
#extension GL_GOOGLE_include_directive : require
#include "scene.glsl"
#include "mesh.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct VisibleTransparentObject {
    uint objectId;
    float distance;
};

layout(std140) uniform TransparentCullUniforms {
    uint u_objectCount;
    uint u_maxDraws;
    float u_lodBias;
    int u_forcedLod;
    vec3 u_cameraPos;
    float u_padding3;
};

layout(std430) buffer AtomicCounterBuffer {
    uint u_atomicCounter;
};

layout(std430) writeonly buffer VisibleTransparentObjectBuffer {
    VisibleTransparentObject u_visibleTransparentObjects[];
};

layout(std430) readonly buffer CullSphereBuffer {
    vec4 cullSpheres[];
};

layout(std430) readonly buffer TransparentIdBuffer {
    uint transparentIds[];
};

const float TRANSPARENT_LOD_DIAMETER_PX[LOD_LEVEL_COUNT - 1u] = float[](60.0, 40.0, 25.0, 8.0, 3.0, 1.5);

uint selectLod(float radius, float dist) {
    if (u_forcedLod >= 0) return min(uint(u_forcedLod), POINT_LOD);
    if (dist <= radius) return 0u;
    float diameterPx = u_lodBias * projectedDiameterPx(radius, dist);
    for (uint lod = 0u; lod < POINT_LOD; ++lod) {
        if (diameterPx >= TRANSPARENT_LOD_DIAMETER_PX[lod]) return lod;
    }
    return POINT_LOD;
}

uniform sampler2D u_hizTexture;

void main() {
    uint listIndex = gl_GlobalInvocationID.x;
    if (listIndex >= u_objectCount) return;
    uint id = transparentIds[listIndex];

    vec4 boundingSphere = cullSpheres[id];
    if (boundingSphere.w < 0.0) return;
    vec3 worldCenter = boundingSphere.xyz;
    float radius = boundingSphere.w;

    for (int i = 0; i < 6; ++i) {
        if (dot(frustumPlanes[i].xyz, worldCenter) + frustumPlanes[i].w < -radius) return;
    }

    vec4 viewPosCenter = view * vec4(worldCenter, 1.0);
    float dist = -viewPosCenter.z;
    if (dist <= 0.0) dist = 0.001;

    if (viewPosCenter.z + radius < -0.1) {
        vec4 clipCenter = projection * vec4(viewPosCenter.xyz, 1.0);
        vec2 ndcCenter = clipCenter.xy / clipCenter.w;
        vec2 pSize = vec2(radius * abs(projection[0][0]), radius * abs(projection[1][1])) / dist;

        vec2 uvCenter = vec2(ndcCenter.x * 0.5 + 0.5, 0.5 - ndcCenter.y * 0.5);

        float u0 = clamp(uvCenter.x - pSize.x * 0.5, 0.0, 1.0);
        float u1 = clamp(uvCenter.x + pSize.x * 0.5, 0.0, 1.0);
        float v0 = clamp(uvCenter.y - pSize.y * 0.5, 0.0, 1.0);
        float v1 = clamp(uvCenter.y + pSize.y * 0.5, 0.0, 1.0);

        vec2 uvMin = vec2(min(u0, u1), min(v0, v1));
        vec2 uvMax = vec2(max(u0, u1), max(v0, v1));

        float d0 = textureLod(u_hizTexture, vec2(uvMin.x, uvMin.y), 0.0).r;
        float d1 = textureLod(u_hizTexture, vec2(uvMax.x, uvMin.y), 0.0).r;
        float d2 = textureLod(u_hizTexture, vec2(uvMin.x, uvMax.y), 0.0).r;
        float d3 = textureLod(u_hizTexture, vec2(uvMax.x, uvMax.y), 0.0).r;
        float maxHizDepth = max(max(d0, d1), max(d2, d3));

        vec4 nearPos = viewPosCenter;
        nearPos.z += radius;
        vec4 clipNear = projection * nearPos;
        float sphereNearDepth = clipNear.z / clipNear.w;

        if (sphereNearDepth > maxHizDepth) return;
    }

    uint slot = atomicAdd(u_atomicCounter, 1);
    if (slot < u_maxDraws) {
        u_visibleTransparentObjects[slot].objectId = id | (selectLod(radius, dist) << 29u);
        u_visibleTransparentObjects[slot].distance = dist;
    }
}