#version 460 core

// One thread per visible large object (was a single serial thread run-length-merging the whole
// list, which cost 10-300ms and read out of bounds past the actual visible count). No adjacent-
// mesh instancing merge here since large objects are a small early-occluder subset, not the bulk
// of the scene - one draw per object is fine at this scale.
layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct DrawElementsIndirectCommand {
    uint count;
    uint instanceCount;
    uint firstIndex;
    uint baseVertex;
    uint baseInstance;
};

struct MeshInfo {
    uint indexCount;
    uint firstIndex;
    uint baseVertex;
    float boundingRadius;
    vec4 boundingCenter;
};

struct RenderableComponent {
    uint mesh_uuid;
    uint material_uuid;
    uint shaderId;
    uint objectId;
    float alpha;
    uint flags;
};

layout(binding = 0, std430) buffer AtomicCounterBuffer {
    uint drawCount;
};

layout(binding = 1, std430) buffer DrawCommandBuffer {
    DrawElementsIndirectCommand commands[];
};

layout(binding = 3, std430) readonly buffer MeshInfoBuffer {
    MeshInfo meshInfos[];
};

layout(binding = 4, std430) readonly buffer RenderableBuffer {
    RenderableComponent renderables[];
};

layout(binding = 5, std430) readonly buffer VisibleLargeObjectBuffer {
    uint visibleLargeObjects[];
};

layout(std140, binding = 0) uniform LargeObjectCommandGenUniforms {
    uint maxDraws;
    uint padding0;
    uint padding1;
    uint padding2;
} uniforms;

layout(binding = 6, std430) readonly buffer VisibleLargeObjectAtomicCounter {
    uint visibleLargeObjectCountGPU;
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint visibleCount = min(visibleLargeObjectCountGPU, uniforms.maxDraws);
    if (i >= visibleCount) return;

    uint objectId = visibleLargeObjects[i];
    RenderableComponent renderable = renderables[objectId];
    MeshInfo mesh = meshInfos[renderable.mesh_uuid];

    uint indexInBin = atomicAdd(drawCount, 1);
    if (indexInBin < uniforms.maxDraws) {
        commands[indexInBin].count = mesh.indexCount;
        commands[indexInBin].instanceCount = 1;
        commands[indexInBin].firstIndex = mesh.firstIndex;
        commands[indexInBin].baseVertex = mesh.baseVertex;
        commands[indexInBin].baseInstance = i;
    }
}
