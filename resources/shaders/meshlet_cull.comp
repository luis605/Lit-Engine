#version 450
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_GOOGLE_include_directive : require
#include "scene.glsl"
#include "mesh.glsl"
#include "hiz.glsl"
#include "meshlet.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430) readonly buffer SortedVisibleObjectBuffer {
    uvec2 sortedEntries[];
};

layout(std430) readonly buffer WorldMatrixBuffer {
    MeshletWorldRows worldRows[];
};

#define LIT_INSTANCE_OWNER_WORLD(entity) meshletWorld(worldRows[entity])
#include "instancing.glsl"

layout(std430) readonly buffer ClusterBuffer {
    Cluster clusters[];
};

layout(std430) readonly buffer ClusterMeshBuffer {
    ClusterMeshInfo clusterMeshes[];
};

layout(std430) readonly buffer WorkCounterBuffer {
    uint u_workCount;
};

layout(std430) readonly buffer WorkItemBuffer {
    uvec4 workItems[];
};

layout(std430) buffer MeshletDrawCounterBuffer {
    uint drawCounters[];
};

layout(std430) writeonly buffer MeshletDrawCommandBuffer {
    DrawElementsIndirectCommand drawCommands[];
};

layout(std430) buffer RetestCounterBuffer {
    uint u_retestCount;
};

layout(std430) writeonly buffer RetestBuffer {
    uvec4 retestItems[];
};

layout(std430) buffer MeshletStatsBuffer {
    uint meshletStats[];
};

shared uint s_first[MESHLET_GROUP_SIZE];
shared uint s_count[MESHLET_GROUP_SIZE];
shared uvec4 s_subgroupTotals[MESHLET_GROUP_SIZE];
shared uint s_retest[2];
shared uint s_starts[2];
shared uint s_base;
shared uint s_runs;

bool frustumVisible(vec3 center, float radius) {
    for (int i = 0; i < 6; ++i) {
        if (dot(frustumPlanes[i].xyz, center) + frustumPlanes[i].w < -radius) return false;
    }
    return true;
}

void main() {
    uint itemIndex = gl_WorkGroupID.x + gl_WorkGroupID.y * MESHLET_MAX_DISPATCH_X;
    if (itemIndex >= min(u_workCount, u_maxWorkItems)) return;
    uint lane = gl_LocalInvocationID.x;
    uvec4 item = workItems[itemIndex * 2u];
    uvec2 mask = workItems[itemIndex * 2u + 1u].xy;
    uint slot = item.x;
    uint commandSlot = item.w & 0xFFFFu;
    uint meshId = item.w >> 16u;
    uint shader = commandSlot % max(u_shaderCount, 1u);

    if (lane == 0u) {
        s_retest[0] = 0u;
        s_retest[1] = 0u;
        s_starts[0] = 0u;
        s_starts[1] = 0u;
    }
    barrier();

    uvec2 entry = sortedEntries[slot];
    uint objectId = entry.x & 0x1FFFFFFFu;
    mat4 model = isInstanceEntry(objectId) ? instanceWorld(instanceSlot(objectId)) : meshletWorld(worldRows[objectId]);
    vec3 axisScale = vec3(length(model[0].xyz), length(model[1].xyz), length(model[2].xyz));
    float scale = max(axisScale.x, max(axisScale.y, axisScale.z));
    float minScale = min(axisScale.x, min(axisScale.y, axisScale.z));
    mat3 m3 = mat3(model);
    bool mirrored = dot(m3[0], cross(m3[1], m3[2])) < 0.0;
    bool coneUsable = (u_flags & MESHLET_FLAG_CONE) != 0u && !mirrored && minScale > scale * 0.95 && ((u_twoSidedMask >> shader) & 1u) == 0u;
    MeshletLod lod = meshletLod(commandSlot / max(u_shaderCount, 1u), scale);
    bool casterCull = meshletCasterCulled(shader);
    bool casterConeUsable = casterCull && !mirrored && minScale > scale * MESHLET_CASTER_UNIFORM_SCALE && ((u_twoSidedMask >> shader) & 1u) == 0u;

    bool maskBit = lane < 32u ? ((mask.x >> lane) & 1u) != 0u : ((mask.y >> (lane - 32u)) & 1u) != 0u;
    bool live = lane < item.z && maskBit;
    bool draw = false;
    bool selected = false;
    Cluster cluster;
    if (live) {
        cluster = clusters[item.y + lane];
        vec3 selfCenter = (model * vec4(cluster.selfSphere.xyz, 1.0)).xyz;
        vec3 parentCenter = (model * vec4(cluster.parentSphere.xyz, 1.0)).xyz;
        float selfError = meshletLodError(lod, selfCenter, cluster.selfSphere.w * scale, cluster.errors.x);
        float parentError = meshletLodError(lod, parentCenter, cluster.parentSphere.w * scale, cluster.errors.y);
        draw = selfError <= u_errorThreshold && parentError > u_errorThreshold;
        selected = draw;
        vec3 center = (model * vec4(cluster.bounds.xyz, 1.0)).xyz;
        float radius = cluster.bounds.w * scale;
        if (draw && (u_flags & MESHLET_FLAG_FRUSTUM) != 0u) draw = frustumVisible(center, radius);
        if (draw && coneUsable && cluster.cone.w < 1.0) {
            vec3 axis = normalize(m3 * cluster.cone.xyz);
            vec3 toCluster = center - viewPos;
            if (dot(toCluster, axis) >= cluster.cone.w * length(toCluster) + radius) draw = false;
        }
        if (draw && casterCull) draw = meshletCasterInside(center, radius);
        if (draw && casterConeUsable && cluster.cone.w < 1.0 && dot(normalize(m3 * cluster.cone.xyz), u_casterDirection.xyz) >= cluster.cone.w) draw = false;
        if (draw && (u_flags & MESHLET_FLAG_HIZ) != 0u && sphereOccluded(center, radius)) {
            draw = false;
            if ((u_flags & MESHLET_FLAG_RETEST_OUTPUT) != 0u) atomicOr(s_retest[lane >> 5u], 1u << (lane & 31u));
        }
    }
    uint triangles = draw ? cluster.ranges.w : 0u;
    s_first[lane] = draw ? cluster.ranges.y : 0u;
    s_count[lane] = triangles;
    uvec4 subgroupTotals = uvec4(subgroupBallotBitCount(subgroupBallot(live)), subgroupBallotBitCount(subgroupBallot(selected)), subgroupBallotBitCount(subgroupBallot(draw)), subgroupAdd(triangles));
    if (subgroupElect()) s_subgroupTotals[gl_SubgroupID] = subgroupTotals;
    barrier();
    bool start = triangles > 0u && (lane == 0u || s_count[lane - 1u] == 0u || s_first[lane - 1u] + s_count[lane - 1u] != s_first[lane]);
    if (start) atomicOr(s_starts[lane >> 5u], 1u << (lane & 31u));
    barrier();

    if (lane == 0u) {
        uvec4 totals = uvec4(0u);
        for (uint subgroup = 0u; subgroup < gl_NumSubgroups; ++subgroup) totals += s_subgroupTotals[subgroup];
        uint runs = bitCount(s_starts[0]) + bitCount(s_starts[1]);
        uint emitted = 0u;
        bool overflow = false;
        if (runs > 0u) {
            uint drawIndex = atomicAdd(drawCounters[commandSlot], runs);
            s_base = drawIndex;
            emitted = drawIndex < u_drawsPerSlot ? min(runs, u_drawsPerSlot - drawIndex) : 0u;
            overflow = emitted < runs;
        }
        s_runs = emitted;
        if ((s_retest[0] | s_retest[1]) != 0u) {
            uint record = atomicAdd(u_retestCount, 1u);
            if (record < u_retestCapacity) {
                retestItems[record * 2u] = uvec4(entry, item.y, item.w);
                retestItems[record * 2u + 1u] = uvec4(s_retest[0], s_retest[1], item.z, 0u);
            } else {
                overflow = true;
            }
        }
        uint stats = u_statsBase;
        atomicAdd(meshletStats[stats + MESHLET_STAT_TESTED], totals.x);
        atomicAdd(meshletStats[stats + MESHLET_STAT_SELECTED], totals.y);
        if (emitted != 0u) {
            atomicAdd(meshletStats[stats + MESHLET_STAT_DRAWN], totals.z);
            atomicAdd(meshletStats[stats + MESHLET_STAT_TRIANGLES], totals.w);
            atomicAdd(meshletStats[stats + MESHLET_STAT_DRAWS], emitted);
        }
        if (overflow) atomicAdd(meshletStats[stats + MESHLET_STAT_OVERFLOW], 1u);
    }
    barrier();
    if (!start) return;
    uint below = lane < 32u ? bitCount(s_starts[0] & ((1u << lane) - 1u)) : bitCount(s_starts[0]) + bitCount(s_starts[1] & ((1u << (lane - 32u)) - 1u));
    if (below >= s_runs) return;
    uint count = triangles;
    uint next = lane + 1u;
    while (next < MESHLET_GROUP_SIZE && s_count[next] != 0u && s_first[next] == s_first[next - 1u] + s_count[next - 1u]) {
        count += s_count[next];
        ++next;
    }
    DrawElementsIndirectCommand command;
    command.count = count * 3u;
    command.instanceCount = 1u;
    command.firstIndex = s_first[lane] * 3u;
    command.baseVertex = clusterMeshes[meshId].info.z;
    command.baseInstance = slot;
    drawCommands[commandSlot * u_drawsPerSlot + s_base + below] = command;
}
