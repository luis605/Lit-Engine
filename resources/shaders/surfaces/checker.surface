float filteredChecker(vec3 p) {
    vec3 w = max(abs(dFdx(p)), abs(dFdy(p))) + 1e-4;
    vec3 i = 2.0 * (abs(fract((p - 0.5 * w) * 0.5) - 0.5) - abs(fract((p + 0.5 * w) * 0.5) - 0.5)) / w;
    return 0.5 - 0.5 * i.x * i.y * i.z;
}

void surface(in SurfaceInput i, inout Surface s) {
    float checker = filteredChecker(i.worldPosition * 2.0 + 0.25);
    s.baseColor *= mix(0.22, 1.0, checker);
    s.roughness = mix(0.3, s.roughness, checker);
}
