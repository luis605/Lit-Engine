#pragma lit bounds 0.8

void vertex(inout VertexData v, in VertexContext c) {
    float amplitude = c.custom0.x > 0.0 ? c.custom0.x : 0.35;
    float height = c.custom0.y > 0.0 ? c.custom0.y : 8.0;
    float frequency = c.custom0.z > 0.0 ? c.custom0.z : 1.3;
    vec3 windWorld = normalize(vec3(1.0, 0.0, 0.6));
    vec3 windLocal = transpose(mat3(c.world)) * windWorld;
    vec2 direction = normalize(windLocal.xz + vec2(1e-5));
    v.position = litWindSway(v.position, c.time, c.instanceSeed, direction, amplitude, height, frequency);
}

void surface(in SurfaceInput i, inout Surface s) {
    float n = litNoise(vec3(i.objectPosition.xz * 0.6, i.objectPosition.y * 0.4));
    vec3 crown = mix(vec3(0.05, 0.17, 0.06), vec3(0.12, 0.30, 0.09), n);
    vec3 trunk = mix(vec3(0.20, 0.12, 0.07), vec3(0.30, 0.19, 0.10), n);
    s.baseColor = mix(trunk, crown, smoothstep(0.35, 0.65, i.uv.x)) * i.instanceColor.rgb;
    s.roughness = 0.9;
    s.metallic = 0.0;
}
