#pragma lit bounds 0.35

void vertex(inout VertexData v, in VertexContext c) {
    float wave = litFbm(v.position * 3.0 + vec3(0.0, c.time * 0.4, 0.0), 4);
    v.position += v.normal * (wave - 0.5) * 0.3;
}

void surface(in SurfaceInput i, inout Surface s) {
    vec3 p = i.objectPosition * 3.0 + vec3(0.0, i.time * 0.4, 0.0);
    float heat = smoothstep(0.45, 0.8, litFbm(p, 5));
    float crust = 1.0 - heat;
    s.baseColor = mix(vec3(0.06, 0.05, 0.05), vec3(1.0, 0.35, 0.05), heat);
    s.roughness = mix(0.85, 0.4, heat);
    s.metallic = 0.0;
    s.emissive = vec3(1.0, 0.32, 0.06) * pow(heat, 3.0) * 8000.0;
    s.normal = litBumpNormal(i, s.normal, crust * 0.08, 1.0);
}
