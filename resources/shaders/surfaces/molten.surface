void surface(in SurfaceInput i, inout Surface s) {
    vec3 p = i.patternPosition * vec3(1.7, 1.0, 1.7) + vec3(i.time * 0.12, 0.0, 0.0);
    vec2 plates = litVoronoi(p * 1.4);
    float turbulence = litFbm(p * 2.2, 4);
    float crust = smoothstep(0.22, 0.62, 1.0 - plates.x + (turbulence - 0.5) * 0.5);
    float heat = saturate(1.0 - crust * 0.96 + (turbulence - 0.55) * 0.5);
    float bank = smoothstep(0.5, 0.36, abs(i.uv.y - 0.5));
    heat *= bank;
    s.emissive *= mix(vec3(0.35, 0.06, 0.01), vec3(1.0, 0.85, 0.45), heat * heat) * heat * 1.7;
    s.baseColor = vec3(0.035, 0.025, 0.022);
    s.roughness = mix(0.9, 0.5, heat);
    s.metallic = 0.0;
    s.normal = litBumpNormal(i, s.normal, (1.0 - heat) * 0.05, 1.0);
}
