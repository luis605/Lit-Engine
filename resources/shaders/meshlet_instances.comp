#version 450
#extension GL_GOOGLE_include_directive : require
#include "scene.glsl"
#include "renderable.glsl"
#include "mesh.glsl"
#include "meshlet.glsl"

// Cluster LOD, stage 1. One thread per sorted visible entry of the phase (output of the object
// cull + scatter). Entries whose mesh has a cluster DAG are expanded into work items, one per
// chunk (<= 64 clusters of one DAG level) that can hold selected clusters at its distance range
// and, for camera views, intersects the frustum.
// Their regular instanced draw is suppressed (command_gen skips meshes with indexCount 0).
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430) readonly buffer AtomicCounterBuffer {
    uint u_visibleCount;
};

layout(std430) readonly buffer SortedVisibleObjectBuffer {
    uvec2 sortedEntries[];
};

layout(std430) readonly buffer BucketOffsetBuffer {
    uint bucketOffsets[];
};

layout(std430) readonly buffer WorldMatrixBuffer {
    MeshletWorldRows worldRows[];
};

layout(std430) readonly buffer ClusterMeshBuffer {
    ClusterMeshInfo clusterMeshes[];
};

layout(std430) readonly buffer ClusterChunkBuffer {
    ClusterChunk clusterChunks[];
};

layout(std430) buffer WorkCounterBuffer {
    uint u_workCount;
};

layout(std430) writeonly buffer WorkItemBuffer {
    uvec4 workItems[];
};

layout(std430) buffer MeshletStatsBuffer {
    uint meshletStats[];
};

void main() {
    uint slot = gl_GlobalInvocationID.x;
    if (slot >= min(u_visibleCount, u_maxDraws)) return;
    uvec2 entry = sortedEntries[slot];
    uint objectId = entry.x & 0x1FFFFFFFu;
    if ((entry.x >> 29u) == POINT_LOD) return;
    uint renderable = renderables[objectId];
    uint meshId = renderableMesh(renderable);
    uint shader = renderableShader(renderable);
    if (meshId >= MAX_MESHES || shader >= u_shaderCount) return;
    ClusterMeshInfo meshInfo = clusterMeshes[meshId];
    uint chunkCount = meshInfo.info.y;
    if (chunkCount == 0u) return;

    uint view = 0u;
    for (uint v = 1u; v < u_views; ++v) {
        if (bucketOffsets[v * u_viewBuckets] <= slot) view = v;
    }
    uint commandSlot = view * u_shaderCount + shader;

    mat4 model = meshletWorld(worldRows[objectId]);
    float scale = max(length(model[0].xyz), max(length(model[1].xyz), length(model[2].xyz)));
    float errorScale = meshletErrorScale() * scale;
    bool frustum = (u_flags & MESHLET_FLAG_FRUSTUM) != 0u;

    // Chunk level: the LOD cut can only select a cluster of the chunk if some self error is within
    // the threshold at the farthest possible distance and some parent error exceeds it at the nearest.
    uint emitted = 0u;
    uint overflow = 0u;
    for (uint c = 0u; c < chunkCount; ++c) {
        ClusterChunk chunk = clusterChunks[meshInfo.info.x + c];
        vec3 center = (model * vec4(chunk.sphere.xyz, 1.0)).xyz;
        float radius = chunk.sphere.w * scale;
        float distance = length(center - viewPos);
        float nearest = max(distance - radius, nearPlane);
        float farthest = max(distance + radius, nearPlane);
        if (chunk.minSelfError * errorScale / farthest > u_errorThreshold) continue;
        if (chunk.maxParentError * errorScale / nearest <= u_errorThreshold) continue;
        if (frustum) {
            bool inside = true;
            for (int i = 0; i < 6; ++i) {
                if (dot(frustumPlanes[i].xyz, center) + frustumPlanes[i].w < -radius) inside = false;
            }
            if (!inside) continue;
        }
        uint item = atomicAdd(u_workCount, 1u);
        if (item >= u_maxWorkItems) {
            overflow = 1u;
            continue;
        }
        workItems[item * 2u] = uvec4(slot, chunk.firstCluster, chunk.clusterCount, commandSlot | (meshId << 16u));
        workItems[item * 2u + 1u] = uvec4(0xFFFFFFFFu, 0xFFFFFFFFu, 0u, 0u);
        ++emitted;
    }
    atomicAdd(meshletStats[u_statsBase + MESHLET_STAT_INSTANCES], 1u);
    atomicAdd(meshletStats[u_statsBase + MESHLET_STAT_WORK_ITEMS], emitted);
    if (overflow != 0u) atomicAdd(meshletStats[u_statsBase + MESHLET_STAT_OVERFLOW], 1u);
}
